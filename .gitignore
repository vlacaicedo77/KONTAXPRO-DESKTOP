*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

# .NET build output
[Bb]in/
[Oo]bj/
artifacts/
publish/

# Test / coverage
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage/
coverage.*
BenchmarkDotNet.Artifacts/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Local configuration and secrets
appsettings.Development.json
appsettings.Local.json
appsettings.local.json
appsettings.*.local.json
*.local.json
*.local.config

.env
.env.*
!.env.example

secrets.json
*.secrets.json
secrets/
.local/
config.local/

# Local databases / backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak
*.sql.gz

# Electronic signature certificates / private keys
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.der
*.jks
*.keystore

# KONTAXPRO generated/local business data
KONTAXPRO/
kontaxpro-data/
data/

# SRI generated documents
**/documentos/generados/
**/documentos/firmados/
**/documentos/autorizados/
**/documentos/noautorizados/
**/documentos/pdfs/

# Local signatures / backups
**/firma/
**/backups/

# Logs
*.log
logs/
Logs/

# Temporary files
*.tmp
*.temp
*.cache
*.pid
*.swp
*.swo
*~
~$*

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Crash dumps
*.dmp
*.mdmp

# Installer / publish artifacts
*.msi
*.msix
*.appx
*.appxbundle
*.msixbundle
*.zip

# Codex transient files
.codex/
.codex-cache/

# IMPORTANT: do NOT ignore EF Core migrations.
# The following should remain tracked:
# - AGENTS.md
# - CODEX_PROMPTS.md
# - *.csproj
# - KONTAXPRO.slnx
# - EF Core migrations
# - source code / XAML
# - production-safe appsettings.json without secrets
