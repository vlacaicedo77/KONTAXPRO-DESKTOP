                                                                  Height="38" MinHeight="38" MaxHeight="38"
                                                                  FontSize="10" Tag="IVA"
                                                                  ToolTip="{Binding TaxSuggestionText}"
                                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="BONIF." Width="54">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <CheckBox IsChecked="{Binding IsBonus}" IsEnabled="{Binding IsInventory}"
                                                          HorizontalAlignment="Center" Style="{StaticResource PurchaseImportCheckBoxStyle}"
                                                          ToolTip="Producto inventariable entregado sin costo"/>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="42">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveManualLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource KontaxDeleteIconButtonStyle}"
                                                        ToolTip="Eliminar línea">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                                </Button>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource PurchaseFormSectionStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,11,0">
                                        <materialDesign:PackIcon Kind="CreditCardClockOutline" Width="19" Height="19" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Condición comercial" Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                        <TextBlock Text="Define si la obligación vence hoy o en una fecha posterior."
                                                   Style="{StaticResource PurchaseFieldHelpStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="190"/><ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="FORMA DE PAGO" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" Padding="11,0" CornerRadius="9"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                            <CheckBox Content="Compra a crédito" IsChecked="{Binding ManualIsCredit, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Style="{StaticResource PurchaseImportCheckBoxStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="FECHA DE VENCIMIENTO"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                        <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}"
                                                IsEnabled="{Binding ManualIsCredit}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="ManualDueDateInput"
                                                         Text="{Binding ManualDueDate, Mode=TwoWay, StringFormat=dd/MM/yyyy, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                                         Language="es-EC" ToolTip="DD/MM/AAAA"
                                                         behaviors:DateInputBehavior.IsEnabled="True"
                                                         Validation.ErrorTemplate="{x:Null}"
                                                         Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                         materialDesign:HintAssist.Hint="dd/mm/aaaa"/>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="CalendarMonthOutline" Width="18" Height="18"
                                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="OBSERVACIÓN" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                                            <TextBox Text="{Binding ManualObservation, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                     materialDesign:HintAssist.Hint="Referencia interna opcional"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Resumen siempre visible mientras se recorre el detalle manual. -->
                <Border Grid.Row="2" Panel.ZIndex="8" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,18,12" Padding="7"
                        CornerRadius="13" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108"/><ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="108"/><ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="108"/><ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="128"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="9,3">
                            <TextBlock Text="SUBTOTAL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding ManualSubtotal, Mode=OneWay, StringFormat={}{0:C2}}" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="9,3">
                            <TextBlock Text="DESCUENTO" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding ManualDiscountTotal, Mode=OneWay, StringFormat={}{0:C2}}" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="9,3">
                            <TextBlock Text="IMPUESTOS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding ManualTaxTotal, Mode=OneWay, StringFormat={}{0:C2}}" Margin="0,2,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="6" Padding="11,6" CornerRadius="9" Background="{DynamicResource PrimaryDarkBrush}">
                            <StackPanel>
                                <TextBlock Text="TOTAL" FontSize="9" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                                <TextBlock Text="{Binding ManualTotal, Mode=OneWay, StringFormat={}{0:C2}}" Margin="0,2,0,0" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource BrandProBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="La compra se guardará pendiente de recepción y aún no modificará existencias."
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseManualCommand}"
                            Style="{StaticResource InventoryDialogCancelButtonStyle}" MinWidth="112">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Margin="0,0,7,0"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding SaveManualCommand}"
                            Style="{StaticResource InventoryDialogPrimaryButtonStyle}" MinWidth="144">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                             <TextBlock Text="{Binding ManualSaveText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Recepción física: es el único flujo que modifica inventario. -->
        <Border Panel.ZIndex="130" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsReceiptFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="131" Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsReceiptFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                    <RowDefinition Height="*"/><RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="PackageDown" Width="25" Height="25"
                                                 Foreground="White" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Confirmar recepción" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding ReceiptTitle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="3" Padding="10,6" CornerRadius="10"
                            Background="{DynamicResource PrimaryDarkBrush}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ReceiptLines.Count}" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text=" productos" Margin="4,0,0,0" FontSize="10"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="5" Command="{Binding CloseReceiptCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PurchaseFormSectionStyle}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="Warehouse" Width="20" Height="20"
                                                         Foreground="White" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Datos de la recepción" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Indica la bodega, fecha y cualquier novedad de la entrega física."
                                           Margin="0,3,0,0" FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="BODEGA DE DESTINO"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <ComboBox Height="44" ItemsSource="{Binding Warehouses}"
                                          SelectedItem="{Binding ReceiptWarehouse, Mode=TwoWay}"
                                          DisplayMemberPath="Display" Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="FECHA DE RECEPCIÓN"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ReceiptDate, Mode=TwoWay, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus}"
                                                 Language="es-EC" ToolTip="DD/MM/AAAA"
                                                 behaviors:DateInputBehavior.IsEnabled="True"
                                                 Validation.ErrorTemplate="{x:Null}"
                                                 Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                 materialDesign:HintAssist.Hint="dd/mm/aaaa"/>
                                        <materialDesign:PackIcon Grid.Column="1" Kind="CalendarMonthOutline"
                                                                 Width="18" Height="18"
                                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="OBSERVACIÓN" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                                    <TextBox Text="{Binding ReceiptObservation, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                             materialDesign:HintAssist.Hint="Novedad o referencia opcional"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource PurchaseTableShellStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="12,8" Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource PrimaryDarkBrush}">
                                    <materialDesign:PackIcon Kind="FormatListChecks" Width="16" Height="16"
                                                             Foreground="White" HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Detalle de recepción" Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                    <TextBlock Text="Ajusta la cantidad recibida y configura lotes o series cuando corresponda."
                                               Margin="0,2,0,0" FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="9,5" CornerRadius="9"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="RECEPCIÓN PARCIAL · LOTE · SERIE"
                                               FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding ReceiptLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="9,7" CornerRadius="10"
                                                Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/><ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="1.2*" MinWidth="190"/><ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="225"/><ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="1.15*" MinWidth="245"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="25" Height="25" CornerRadius="7"
                                                        Background="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Order}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Product}"/>
                                                    <TextBlock Text="{Binding PresentationSummary}" Margin="0,2,0,0" FontSize="9"
                                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PresentationSummary}"/>
                                                    <TextBlock Text="{Binding Description}" Margin="0,1,0,0" FontSize="8"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                </StackPanel>
                                                <Grid Grid.Column="4" Height="34" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="7" Background="#2563EB">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="FACTURADO" FontSize="7" FontWeight="Bold" Foreground="#DBEAFE"/>
                                                            <TextBlock Text="{Binding Invoiced, StringFormat={}{0:0.######}}" Margin="0,1,0,0"
                                                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="7"
                                                            Background="{DynamicResource PrimaryDarkBrush}">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="RECIBIDO" FontSize="7" FontWeight="Bold" Foreground="#D1FAE5"/>
                                                            <TextBlock Text="{Binding Received, StringFormat={}{0:0.######}}" Margin="0,1,0,0"
                                                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="4" CornerRadius="7" Background="#D97706">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="PENDIENTE" FontSize="7" FontWeight="Bold" Foreground="#FEF3C7"/>
                                                            <TextBlock Text="{Binding Pending, StringFormat={}{0:0.######}}" Margin="0,1,0,0"
                                                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                                    <TextBlock Text="A RECIBIR" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                    <Border Height="34" MinHeight="34" MaxHeight="34"
                                                            Margin="0,3,0,0" Style="{StaticResource PurchaseFieldBorderStyle}">
                                                        <TextBox Text="{Binding ReceiveNow, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}"
                                                                 Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                                 HorizontalContentAlignment="Center"
                                                                 behaviors:DecimalInputBehavior.IsEnabled="True"
                                                                 behaviors:DecimalInputBehavior.DecimalPlaces="6"
                                                                 behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True"
                                                                 behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"
                                                                 behaviors:DecimalInputBehavior.TrimTrailingZeros="True"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="8" VerticalAlignment="Center"
                                                            Visibility="{Binding NeedsTraceability, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="CONTROL DE INVENTARIO" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                    <Grid Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TraceabilitySummary}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14"
                                                                                         Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text="Lotes" Margin="4,0,8,0" FontSize="9"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           Visibility="{Binding HandlesLots, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <materialDesign:PackIcon Kind="BarcodeScan" Width="14" Height="14"
                                                                                         Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                         Visibility="{Binding HandlesSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="Series" Margin="4,0,0,0" FontSize="9"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           Visibility="{Binding HandlesSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Margin="10,0,0,0" MinWidth="126" Height="34"
                                                                Command="{Binding DataContext.OpenTraceabilityEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource KontaxPrimaryButtonStyle}"
                                                                Background="{DynamicResource PrimaryDarkBrush}"
                                                                BorderBrush="{DynamicResource PrimaryDarkBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="16" Height="16"/>
                                                                <TextBlock Text="{Binding TraceabilityButtonText}" Margin="7,0,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                                <Border Grid.Column="8" Padding="10,7" CornerRadius="8"
                                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding NeedsTraceability, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock Text="CONTROL NORMAL" Margin="6,0,0,0" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="Al confirmar se actualizarán existencias, costos y Kardex en una sola transacción."
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseReceiptCommand}"
                            Style="{StaticResource InventoryDialogCancelButtonStyle}" MinWidth="112">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Margin="0,0,7,0"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding ConfirmReceiptCommand}"
                            Style="{StaticResource InventoryDialogPrimaryButtonStyle}" MinWidth="172">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantClosedCheck" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Confirmar recepción" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border Panel.ZIndex="150" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsReceiptCancelFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="151" Width="600" Style="{StaticResource PurchaseWorkspaceStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsReceiptCancelFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="#D97706">
                        <materialDesign:PackIcon Kind="PackageVariantRemove" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Revertir recepción" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Se conservará el ingreso original y se generará su Kardex inverso" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseReceiptCancelCommand}" Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <Border Padding="13" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,0,18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="19" Height="19" Foreground="#D97706" Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1" Text="Solo se permite el reverso si el stock, los lotes, las series y el costo no tienen operaciones posteriores. Así se evita alterar silenciosamente la trazabilidad."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Recepción confirmada" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding ConfirmedReceipts}"
                          SelectedItem="{Binding SelectedReceiptToCancel}"
                          DisplayMemberPath="Display" Style="{StaticResource ModernComboBoxStyle}"/>
                <TextBlock Text="{Binding SelectedReceiptToCancel.CantidadBase, StringFormat={}{0:0.######} unidades base · recepción seleccionada}"
                           Style="{StaticResource PurchaseFieldHelpStyle}" Margin="1,5,0,16"/>

                <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}">
                    <Run Text="Motivo del reverso"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                </TextBlock>
                <Border Style="{StaticResource PurchaseFieldBorderStyle}" MinHeight="96">
                    <TextBox Text="{Binding ReceiptCancelReason, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="12"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Command="{Binding CloseReceiptCancelCommand}" Style="{StaticResource KontaxSecondaryButtonStyle}" Margin="0,0,10,0">
                        <TextBlock Text="Volver"/>
                    </Button>
                    <Button Command="{Binding ConfirmReceiptCancelCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Background="#D97706" BorderBrush="#D97706">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PackageVariantRemove" Width="18" Height="18" Foreground="White"/><TextBlock Text="Revertir recepción" Margin="7,0,0,0" Foreground="White"/></StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Panel.ZIndex="140" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsCancelFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="141" Width="520" Style="{StaticResource PurchaseWorkspaceStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsCancelFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource DangerButtonBackgroundBrush}">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Anular compra" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Esta acción conserva el documento en el historial" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseCancelCommand}" Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <Border Padding="13" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,0,18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="19" Height="19" Foreground="#D97706" Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1" Text="Si existen recepciones confirmadas, utiliza primero Revertir recepción. KONTAXPRO conservará el ingreso y su movimiento inverso en el historial."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}">
                    <Run Text="Motivo de anulación"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                </TextBlock>
                <Border Style="{StaticResource PurchaseFieldBorderStyle}" MinHeight="96">
                    <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="12"/>
                </Border>
                <TextBlock Text="Explica brevemente por qué se anula la compra. Este dato quedará registrado en auditoría."
                           Style="{StaticResource PurchaseFieldHelpStyle}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Command="{Binding CloseCancelCommand}" Style="{StaticResource KontaxSecondaryButtonStyle}" Margin="0,0,10,0">
                        <TextBlock Text="Volver"/>
                    </Button>
                    <Button Command="{Binding ConfirmCancelCommand}" Style="{StaticResource DangerButtonStyle}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" Foreground="White"/><TextBlock Text="Anular compra" Margin="7,0,0,0" Foreground="White"/></StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Panel.ZIndex="200" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsProductFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="201" Style="{StaticResource PurchaseEmbeddedWorkspaceStyle}" Visibility="{Binding IsProductFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductFormOpen}" Value="True">
                                <Setter Property="Content" Value="{Binding ProductForm}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <productViews:ProductFormView/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
        <Border Panel.ZIndex="210" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="211" Style="{StaticResource PurchaseEmbeddedWorkspaceStyle}" Visibility="{Binding IsSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupplierFormOpen}" Value="True">
                                <Setter Property="Content" Value="{Binding ProveedorForm}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <supplierViews:ProveedorFormView/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>

        <!-- Alta rápida exclusiva de la compra manual; reutiliza las reglas oficiales de Proveedores. -->
        <Border Panel.ZIndex="220" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsManualSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="221" Width="720" MaxHeight="700"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsManualSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="StorePlusOutline" Width="25" Height="25" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Registrar proveedor" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Validaremos el RUC antes de asociarlo con esta compra."
                                   Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding ProveedorForm.CancelarCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="RUC"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                            <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#2563EB"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="R" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox x:Name="ManualSupplierRucInput" Grid.Column="1"
                                             Text="{Binding ProveedorForm.NumeroRuc, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding ProveedorForm.CanEditRuc, Mode=OneWay}"
                                             MaxLength="13" PreviewTextInput="DigitsOnly_PreviewTextInput"
                                             Style="{StaticResource PurchaseFieldTextBoxStyle}" Padding="2,0,10,0"
                                             materialDesign:HintAssist.Hint="13 dígitos"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="RAZÓN SOCIAL"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                            <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                                <TextBox x:Name="ManualSupplierBusinessNameInput"
                                         Text="{Binding ProveedorForm.RazonSocial, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ProveedorForm.CanEditBusinessName, Mode=OneWay}"
                                         Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="Se completará desde la fuente oficial"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,14,0,14" Padding="14" CornerRadius="12" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProveedorForm.IsVerified}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProveedorForm.HasVerificationError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="23" Height="23"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProveedorForm.VerificationTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding ProveedorForm.VerificationMessage}" Margin="0,3,0,0"
                                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding ProveedorForm.VerificarCommand}"
                                    IsEnabled="{Binding ProveedorForm.CanVerify, Mode=OneWay}"
                                    Style="{StaticResource KontaxSecondaryButtonStyle}" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17" Margin="0,0,6,0"/>
                                    <TextBlock Text="Verificar"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="CORREO ELECTRÓNICO (OPCIONAL)" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                        <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="EmailOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ProveedorForm.Correo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PurchaseFieldTextBoxStyle}" Padding="2,0,10,0"
                                         materialDesign:HintAssist.Hint="correo@proveedor.com"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Si las fuentes oficiales fallan tras 3 intentos, se habilitará el ingreso manual."
                               VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    <Button Grid.Column="1" Command="{Binding ProveedorForm.CancelarCommand}"
                            Style="{StaticResource InventoryDialogCancelButtonStyle}" MinWidth="105">
                        <TextBlock Text="Cancelar"/>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding ProveedorForm.GuardarCommand}"
                            Style="{StaticResource InventoryDialogPrimaryButtonStyle}" MinWidth="145">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,7,0"/>
                            <TextBlock Text="Guardar proveedor"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
