<UserControl x:Class="KONTAXPRO.Desktop.Views.Compras.ComprasView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:KONTAXPRO.Desktop.Behaviors"
             xmlns:purchaseModels="clr-namespace:KONTAXPRO.Application.Models.Compras;assembly=KONTAXPRO.Application"
             xmlns:productViews="clr-namespace:KONTAXPRO.Desktop.Views.Products"
             xmlns:supplierViews="clr-namespace:KONTAXPRO.Desktop.Views.Proveedores"
             >
    <UserControl.Resources>
        <Style x:Key="KontaxSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NeutralButtonStyle}"/>
        <Style x:Key="KontaxPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}"/>
        <Style x:Key="PurchaseCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Estilos exclusivos de los formularios complementarios de Compras. -->
        <Style x:Key="PurchaseFormSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PurchaseIdentityCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="PurchaseIdentityMetricStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="PurchaseProgressNodeStyle" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource InputSecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PurchaseProgressLineStyle" TargetType="Border">
            <Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="PurchaseSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="PurchaseFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>

        <Style x:Key="PurchaseFieldHelpStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="1,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PurchaseFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>

        <Style x:Key="PurchaseFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandProBrush}"/>
        </Style>

        <Style x:Key="PurchaseTableShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TableBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="PurchaseKpiButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseKpiAllStyle" TargetType="Button"
               BasedOn="{StaticResource PurchaseKpiButtonStyle}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PurchaseKpiPendingStyle" TargetType="Button"
               BasedOn="{StaticResource PurchaseKpiButtonStyle}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PurchaseKpiPartialStyle" TargetType="Button"
               BasedOn="{StaticResource PurchaseKpiButtonStyle}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PurpleSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="#A855F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PurchaseKpiReceivedStyle" TargetType="Button"
               BasedOn="{StaticResource PurchaseKpiButtonStyle}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="#16A34A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurchaseSearchClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearBackground" Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseSquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchasePageButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
        </Style>

        <Style x:Key="PurchaseProductSearchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SearchButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchButtonBorder"
                                        Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SearchButtonBorder"
                                        Property="Background" Value="#5B21B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseRelationClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearRelationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearRelationBorder"
                                        Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClearRelationBorder"
                                        Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseInlineClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InlineClearBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InlineClearBorder" Property="Background"
                                        Value="{DynamicResource DangerSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InlineClearBorder" Property="Background"
                                        Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource KontaxDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource TableAlternateRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseManualColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PurchaseColumnHeaderStyle}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="5,8"/>
        </Style>

        <Style x:Key="PurchaseCenteredColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource PurchaseColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PurchaseManualCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource KontaxDataGridCellStyle}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,5"/>
        </Style>

        <Style x:Key="PurchaseImportRowStyle" TargetType="DataGridRow"
               BasedOn="{StaticResource KontaxDataGridRowStyle}">
            <Setter Property="MinHeight" Value="104"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="PurchaseImportCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource KontaxDataGridCellStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="PurchaseImportCheckBoxStyle" TargetType="CheckBox"
               BasedOn="{StaticResource KontaxCheckBoxStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="PurchaseLoadingBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
        </Style>

        <Style x:Key="PurchaseWorkspaceStyle" TargetType="Border">
            <Setter Property="Margin" Value="18"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.32"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseEmbeddedWorkspaceStyle" TargetType="Border">
            <Setter Property="Margin" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.32"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchaseCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PurchaseReceiveActionStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="RECIBIDA">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurchaseCancelActionStyle" TargetType="Button"
               BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurchaseReverseReceiptActionStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="BorderBrush" Value="#D97706"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RecepcionesConfirmadas}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PurchaseEditActionStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PuedeEditar}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardStep" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="PENDIENTE_RECEPCION">
                    <Setter Property="Background" Value="#D97706"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="PARCIALMENTE_RECIBIDA">
                    <Setter Property="Background" Value="#7C3AED"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="RECIBIDA">
                    <Setter Property="Background" Value="#16A34A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                    <Setter Property="Background" Value="#4B5563"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="Auto"/>
                                                             <ColumnDefinition Width="Auto"/>
                                                         </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13"
                            Background="{DynamicResource PrimaryDarkBrush}"
                            Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="Cart"
                                                 Width="24" Height="24"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Compras" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12"
                                   Text="Gestiona compras manuales o XML, recepción de mercadería y trazabilidad desde un solo lugar"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,10,0"
                            Command="{Binding OpenManualCommand}"
                            Style="{StaticResource KontaxSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartPlus" Width="18" Height="18"/>
                            <TextBlock Text="Nueva compra manual" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectXmlCommand}"
                            Style="{StaticResource KontaxPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileXmlBox" Width="18" Height="18"/>
                            <TextBlock Text="Importar XML" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PurchaseKpiAllStyle}"
                        Tag="{Binding IsKpiAll}" ToolTip="Mostrar todas las compras"
                        Command="{Binding SelectKpiStatusCommand}" CommandParameter="TODAS">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#3B82F6">
                            <materialDesign:PackIcon Kind="Cart" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPurchases}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="COMPRAS" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource PurchaseKpiPendingStyle}"
                        Tag="{Binding IsKpiPending}" ToolTip="Mostrar compras pendientes de recepción"
                        Command="{Binding SelectKpiStatusCommand}" CommandParameter="PENDIENTE_RECEPCION">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#F59E0B">
                            <materialDesign:PackIcon Kind="PackageVariantClosedMinus" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingReceipts}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="PENDIENTES" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource PurchaseKpiPartialStyle}"
                        Tag="{Binding IsKpiPartial}" ToolTip="Mostrar compras recibidas parcialmente"
                        Command="{Binding SelectKpiStatusCommand}" CommandParameter="PARCIALMENTE_RECIBIDA">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#A855F7">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PartialReceipts}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="PARCIALES" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="6" Style="{StaticResource PurchaseKpiReceivedStyle}"
                        Tag="{Binding IsKpiReceived}" ToolTip="Mostrar compras recibidas"
                        Command="{Binding SelectKpiStatusCommand}" CommandParameter="RECIBIDA">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#16A34A">
                            <materialDesign:PackIcon Kind="PackageCheck" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReceivedPurchases}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="RECIBIDAS" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Grid.Column="8" Padding="18" CornerRadius="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#0F766E">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PurchasesAmount, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="TOTAL REGISTRADO" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="46"
                            Background="{DynamicResource InputSecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19"
                                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="PurchaseSearchInput"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource BrandProBrush}"
                                         Padding="0,0,38,0"
                                         VerticalContentAlignment="Center" FontSize="13"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Buscar por documento, RUC o proveedor..."
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PurchaseSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=PurchaseSearchInput}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,6,0" Panel.ZIndex="2"
                                        Style="{StaticResource PurchaseSearchClearButtonStyle}"
                                        Command="{Binding ClearSearchCommand}"
                                        ToolTip="Limpiar búsqueda"
                                        Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="Close" Width="17" Height="17"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="2" Width="220" VerticalAlignment="Center"
                               ItemsSource="{Binding StatusOptions}"
                               DisplayMemberPath="Text" SelectedValuePath="Value"
                               SelectedValue="{Binding SelectedStatus}"
                               Style="{StaticResource ModernComboBoxStyle}"/>

                    <Button Grid.Column="4" Style="{StaticResource PurchaseSquareButtonStyle}"
                            Command="{Binding ApplyFiltersCommand}"
                            ToolTip="Aplicar filtros">
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource PurchaseSquareButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Actualizar compras">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="6" Background="{DynamicResource TableBackgroundBrush}"
                    CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" Margin="12,2"
                                 Style="{StaticResource PurchaseLoadingBarStyle}"
                                 ToolTip="Cargando compras..."
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Compras}"
                              SelectedItem="{Binding SelectedPurchase}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True" Style="{StaticResource KontaxDataGridStyle}"
                               CanUserAddRows="False" CanUserDeleteRows="False"
                               CanUserSortColumns="False"
                              BorderThickness="0" HeadersVisibility="Column"
                              MinRowHeight="60" ColumnHeaderHeight="46"
                              ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding FechaEmision, StringFormat=dd/MM/yyyy}" Width="112"><DataGridTextColumn.Header><Button Style="{StaticResource KontaxCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Fecha}"><StackPanel Orientation="Horizontal"><TextBlock Text="FECHA"/><TextBlock Text="{Binding DataContext.IndicadorFecha, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTemplateColumn Width="178">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Documento}"><StackPanel Orientation="Horizontal"><TextBlock Text="DOCUMENTO"/><TextBlock Text="{Binding DataContext.IndicadorDocumento, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NumeroDocumento}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Origen}" Margin="0,3,0,0" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource BrandProBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" MinWidth="260">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Proveedor}"><StackPanel Orientation="Horizontal"><TextBlock Text="PROVEEDOR"/><TextBlock Text="{Binding DataContext.IndicadorProveedor, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Proveedor}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Proveedor}"/>
                                            <TextBlock Text="{Binding IdentificacionProveedor}" Margin="0,3,0,0"
                                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="132" HeaderStyle="{StaticResource PurchaseCenteredColumnHeaderStyle}">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Total}"><StackPanel Orientation="Horizontal"><TextBlock Text="TOTAL"/><TextBlock Text="{Binding DataContext.IndicadorTotal, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Total, StringFormat={}{0:C2}}"
                                                   FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource BrandProBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="116" HeaderStyle="{StaticResource PurchaseCenteredColumnHeaderStyle}">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Pendientes}"><StackPanel Orientation="Horizontal"><TextBlock Text="PENDIENTES"/><TextBlock Text="{Binding DataContext.IndicadorPendientes, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LineasPendientes}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="192" HeaderStyle="{StaticResource PurchaseCenteredColumnHeaderStyle}">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarComprasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static purchaseModels:CompraCatalogoOrden.Estado}"><StackPanel Orientation="Horizontal"><TextBlock Text="ESTADO"/><TextBlock Text="{Binding DataContext.IndicadorEstado, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Foreground="White" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Estado}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="PENDIENTE_RECEPCION">
                                                                <Setter Property="Text" Value="PENDIENTE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="PARCIALMENTE_RECIBIDA">
                                                                <Setter Property="Text" Value="RECIBIDA PARCIAL"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="RECIBIDA">
                                                                <Setter Property="Text" Value="RECIBIDA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="ANULADA">
                                                                <Setter Property="Text" Value="ANULADA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACCIONES" Width="176">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PurchaseEditActionStyle}"
                                                    ToolTip="Corregir compra manual"
                                                    Command="{Binding DataContext.OpenManualEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="17" Height="17" Foreground="White"/>
                                            </Button>
                                            <Button Style="{StaticResource PurchaseReceiveActionStyle}"
                                                    Margin="6,0,0,0"
                                                    ToolTip="Recibir mercadería"
                                                    Command="{Binding DataContext.OpenReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PackageDown" Width="17" Height="17" Foreground="White"/>
                                            </Button>
                                            <Button Margin="6,0,0,0"
                                                    Style="{StaticResource PurchaseReverseReceiptActionStyle}"
                                                    ToolTip="Revertir una recepción"
                                                    Command="{Binding DataContext.OpenReceiptCancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="PackageVariantRemove" Width="17" Height="17" Foreground="White"/>
                                            </Button>
                                            <Button Margin="6,0,0,0"
                                                    Style="{StaticResource PurchaseCancelActionStyle}"
                                                    ToolTip="Anular compra"
                                                    Command="{Binding DataContext.OpenCancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Cancel" Width="17" Height="17" Foreground="White"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <materialDesign:PackIcon Style="{StaticResource KontaxEmptyListIconStyle}"/>
                        <TextBlock Text="No se encontraron registros" Style="{StaticResource KontaxEmptyListTextStyle}"/>
                        <Button Content="Limpiar filtros" Margin="0,14,0,0"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding ClearFiltersCommand}"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="14,10" MinHeight="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TextoPaginacion}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="POR PÁGINA" Margin="0,0,7,0"
                                       VerticalAlignment="Center" FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <ComboBox Width="82" ItemsSource="{Binding TamanosPagina}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectedItem="{Binding TamanoPagina}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource PurchasePageButtonStyle}"
                                    Command="{Binding PaginaAnteriorCommand}"
                                    IsEnabled="{Binding PuedeIrPaginaAnterior}"
                                    ToolTip="Página anterior">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="17" Height="17"/>
                            </Button>
                            <ItemsControl ItemsSource="{Binding PaginasVisibles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Texto}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.IrPaginaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource PurchasePageButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EsSeparador}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PurchasePageButtonStyle}"
                                    Margin="4,0,0,0"
                                    Command="{Binding PaginaSiguienteCommand}"
                                    IsEnabled="{Binding PuedeIrPaginaSiguiente}"
                                    ToolTip="Página siguiente">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="17" Height="17"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Selector previo: mantiene la importación dentro del módulo y admite arrastrar o examinar. -->
        <Border Panel.ZIndex="90" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsXmlPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="91" Width="760" MaxWidth="760"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsXmlPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="50" Height="50" CornerRadius="14"
                            Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="FileXmlBox" Width="27" Height="27"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Importar factura electrónica"
                                   FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Selecciona un XML para iniciar su validación y registro"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseXmlPickerCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                 Foreground="White"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" MinHeight="300" Padding="36"
                        AllowDrop="True"
                        DragEnter="XmlDropZone_DragEnter"
                        DragOver="XmlDropZone_DragOver"
                        DragLeave="XmlDropZone_DragLeave"
                        Drop="XmlDropZone_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsXmlDragActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource TableSelectedRowBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding XmlPickerHasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="570">
                        <Border Width="76" Height="76" CornerRadius="22"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding XmlPickerHasError}" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <materialDesign:PackIcon Width="38" Height="38" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="TrayArrowDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding XmlPickerHasError}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircleOutline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Border>
                        <TextBlock Text="Suelta aquí tu archivo XML"
                                   Margin="0,20,0,0" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding XmlPickerMessage}"
                                   Margin="0,8,0,0" FontSize="12"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding XmlPickerHasError}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding BrowseXmlCommand}"
                                Style="{StaticResource KontaxPrimaryButtonStyle}"
                                Margin="0,22,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSearchOutline"
                                                         Width="18" Height="18"/>
                                <TextBlock Text="Examinar archivo" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Solo se admite un archivo .XML por operación"
                                   Margin="0,14,0,0" FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4">
                    <ProgressBar Height="4" VerticalAlignment="Top"
                                 Style="{StaticResource PurchaseLoadingBarStyle}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Panel.ZIndex="100" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsImportWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="101" Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsImportWizardOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="FileXmlBox" Width="25" Height="25"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Importar factura electrónica" FontSize="23" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Revisa el comprobante, relaciona sus productos y confirma la compra"
                                   Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseImportCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource PurchaseFormSectionStyle}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StepNumber, Mode=OneWay}" FontSize="16"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StepName, Mode=OneWay}" FontSize="14"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding StepInstruction, Mode=OneWay}"
                                       Margin="0,3,0,0" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Grid Grid.Column="3" Width="340" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressNodeStyle}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressLineStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border Grid.Column="2">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressNodeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="2">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border Grid.Column="3">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressLineStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border Grid.Column="4">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressNodeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="3" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border Grid.Column="5">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressLineStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Grid.Column="6">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource PurchaseProgressNodeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="-18,5,-18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Datos" HorizontalAlignment="Center" FontSize="8"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                <TextBlock Grid.Column="1" Text="Productos" HorizontalAlignment="Center"
                                           FontSize="8" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="2">
                                                     <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                                 <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                 </DataTrigger>
                                                 <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                 </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="Confirmar" HorizontalAlignment="Center"
                                           FontSize="8" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                     <DataTrigger Binding="{Binding ImportStep}" Value="3">
                                                          <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                          <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                     </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="Recepción" HorizontalAlignment="Center"
                                           FontSize="8" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImportStep}" Value="4">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <!-- Paso 1: comprobante y proveedor -->
                    <Grid>
                        <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardStep}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="7*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Proveedor -->
                        <Border Style="{StaticResource PurchaseIdentityCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="16">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="11"
                                                 Background="{DynamicResource PrimaryButtonBackgroundBrush}" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="TruckOutline" Width="22" Height="22"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Información del proveedor" FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Emisor asociado automáticamente"
                                                       Margin="0,3,0,0" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="9,5" CornerRadius="9"
                                                 Background="{DynamicResource PrimaryButtonBackgroundBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SupplierBadgeText}" FontSize="8"
                                                       FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource PurchaseIdentityMetricStyle}"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="RAZÓN SOCIAL" FontSize="8" FontWeight="Bold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SupplierName}" Margin="0,5,0,0"
                                                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding SupplierXmlCommercialName}"
                                                       Margin="0,4,0,0" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Visibility="{Binding SupplierXmlCommercialName, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PurchaseIdentityMetricStyle}"
                                            Padding="14,11" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="REGISTRO ÚNICO DE CONTRIBUYENTES"
                                                           FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding SupplierRuc}" Margin="0,4,0,0"
                                                           FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10"
                                                    Background="#2563EB" VerticalAlignment="Center">
                                                <TextBlock Text="RUC" FontSize="9" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PurchaseIdentityMetricStyle}"
                                            Padding="14,11"
                                            Visibility="{Binding SupplierAddress, Converter={StaticResource StringToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="MapMarkerOutline" Width="18" Height="18"
                                                                     Foreground="#2563EB" Margin="0,1,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="DIRECCIÓN MATRIZ" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding SupplierAddress}" Margin="0,4,0,0"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Comprobante -->
                        <Border Grid.Column="2" Style="{StaticResource PurchaseIdentityCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="16">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="11"
                                                Background="#2563EB" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Información del comprobante" FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="Factura electrónica leída desde el XML"
                                                       Margin="0,3,0,0" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="10,5" CornerRadius="9"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding DocumentValidationDescription}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDocumentAuthorizedSri}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DocumentValidationBadgeText}" FontSize="8"
                                                           FontWeight="Bold" Foreground="White"/>
                                                <Border Width="1" Height="11" Margin="7,0"
                                                        Background="#80FFFFFF"/>
                                                <TextBlock Text="{Binding EnvironmentText, Mode=OneWay}"
                                                           FontSize="8" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource PurchaseIdentityMetricStyle}"
                                            Padding="14,11" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="NÚMERO DE COMPROBANTE" FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding DocumentNumber}" Margin="0,4,0,0"
                                                           FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Margin="12,0,0,0">
                                                <TextBlock Text="{Binding ImportedIssueDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}"
                                                           HorizontalAlignment="Right" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding ImportedLineCount, Mode=OneWay, StringFormat={}{0} líneas}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"
                                                           FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource PurchaseIdentityMetricStyle}"
                                            Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                                     Foreground="#2563EB" Margin="0,1,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CLAVE DE ACCESO · SRI" FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding ImportAccessKey, Mode=OneWay}"
                                                         IsReadOnly="True" BorderThickness="0"
                                                         Background="Transparent" Padding="0" Margin="0,4,0,0"
                                                         FontFamily="Consolas" FontSize="10"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                          CaretBrush="{DynamicResource BrandProBrush}"
                                                          ToolTip="Selecciona y copia la clave de acceso"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="FileXmlBox" Width="14" Height="14"
                                                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ImportFileName, Mode=OneWay}"
                                                               Margin="6,0,0,0" FontSize="9"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ImportFileName}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PurchaseIdentityMetricStyle}">
                                            <StackPanel>
                                                <TextBlock Text="SUBTOTAL" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding ImportedSubtotal, StringFormat={}{0:C2}}"
                                                           Margin="0,3,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource PurchaseIdentityMetricStyle}">
                                            <StackPanel>
                                                <TextBlock Text="DESCUENTO" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding ImportedDiscount, StringFormat={}{0:C2}}"
                                                           Margin="0,3,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource PurchaseIdentityMetricStyle}">
                                            <StackPanel>
                                                <TextBlock Text="IMPUESTOS" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding ImportedTaxTotal, StringFormat={}{0:C2}}"
                                                           Margin="0,3,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Padding="14,11" CornerRadius="10"
                                            Background="{DynamicResource SuccessSoftBrush}"
                                            BorderBrush="{DynamicResource BrandProBrush}"
                                            BorderThickness="1" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9"
                                                    Background="{DynamicResource BrandProBrush}">
                                                <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18"
                                                                         Foreground="White"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="TOTAL DEL COMPROBANTE"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrandProBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ImportedTotal, StringFormat={}{0:C2}}"
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrandProBrush}"/>
                                        </Grid>
                                    </Border>

                                    <Border Padding="10,7" CornerRadius="9"
                                            Background="{DynamicResource WarningSoftBrush}"
                                            Visibility="{Binding ImportWarning, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ImportWarning}" TextWrapping="Wrap"
                                                   FontSize="10" Foreground="{DynamicResource WarningTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Paso 2: relación de productos -->
                    <Grid>
                        <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardStep}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource PurchaseFormSectionStyle}" Padding="13,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="11"
                                        Background="#2563EB" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="LinkVariant" Width="22" Height="22"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Relacionar productos" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="Asocia cada línea del XML con un producto y su presentación. También puedes clasificarla como no inventariable o crear el producto sin salir de la compra."
                                               TextWrapping="Wrap" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Padding="10,6" CornerRadius="10"
                                        Margin="12,0,0,0" Background="{DynamicResource InfoSoftBrush}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ImportedLineCount, Mode=OneWay}"
                                                   FontWeight="Bold" Foreground="#2563EB"/>
                                        <TextBlock Text=" líneas" Margin="4,0,0,0"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PurchaseTableShellStyle}">
                            <DataGrid ItemsSource="{Binding LineasImportadas}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserReorderColumns="False"
                                      CanUserResizeColumns="True" SelectionMode="Single"
                                      SelectionUnit="FullRow" HeadersVisibility="Column"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      Style="{StaticResource KontaxDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                                      RowStyle="{StaticResource PurchaseImportRowStyle}"
                                      CellStyle="{StaticResource PurchaseImportCellStyle}"
                                      ColumnHeaderHeight="42" RowHeight="NaN"
                                      MinRowHeight="104" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="#" Width="54" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="26" Height="26" CornerRadius="8"
                                                        Background="#2563EB"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Order}" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="LÍNEA DEL XML" Width="*" MinWidth="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                                                Visibility="{Binding MainCode, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="Barcode" Width="15" Height="15"
                                                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding MainCode, StringFormat=Código: {0}}"
                                                                   Margin="6,0,0,0" FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="15" Height="15"
                                                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat=Cantidad facturada: {0:0.##}}"
                                                                   Margin="6,0,0,0" FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="PRODUCTO / PRESENTACIÓN" Width="390" MinWidth="330">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ProductDisplay}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding ClearRelationCommand}"
                                                                Style="{StaticResource PurchaseRelationClearButtonStyle}"
                                                                Margin="7,0,0,0"
                                                                ToolTip="Limpiar relación y volver a resolver la línea"
                                                                Visibility="{Binding ShowClearRelationAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <materialDesign:PackIcon Kind="LinkVariantOff"
                                                                                     Width="16" Height="16"
                                                                                     Foreground="White"/>
                                                        </Button>
                                                        <Border Grid.Column="2" Width="28" Height="28"
                                                                CornerRadius="8" Margin="7,0,0,0"
                                                                ToolTipService.ShowDuration="5000">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#D97706"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="ToolTip" Value="No relacionado: selecciona, busca o crea un producto."/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding MatchStatus}" Value="AUTOMÁTICO">
                                                                            <Setter Property="Background" Value="#16A34A"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="ToolTip" Value="Relacionado automáticamente."/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding MatchStatus}" Value="RELACIONADO">
                                                                            <Setter Property="Background" Value="#2563EB"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="ToolTip" Value="Relacionado manualmente."/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding MatchStatus}" Value="NO INVENTARIO">
                                                                            <Setter Property="Background" Value="#64748B"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Setter Property="ToolTip" Value="Línea clasificada como no inventariable."/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <materialDesign:PackIcon Width="16" Height="16"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="AUTOMÁTICO">
                                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="RELACIONADO">
                                                                                <Setter Property="Kind" Value="LinkVariant"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding MatchStatus}" Value="NO INVENTARIO">
                                                                                <Setter Property="Kind" Value="PackageVariantClosedMinus"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Visibility="{Binding ShowSearchAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding Candidates}"
                                                                  SelectedItem="{Binding SelectedCandidate,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="Selecciona una coincidencia"
                                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                                  Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding ProductoConMarca}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                            <TextBlock Text="{Binding PresentacionNombre}"
                                                                                       Margin="0,2,0,0" FontSize="10"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1" Padding="7,3" Margin="10,0,0,0"
                                                                                CornerRadius="8" Background="#2563EB"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Confianza, StringFormat={}{0:P0}}"
                                                                                       FontSize="9" FontWeight="Bold"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Border Padding="10,7" CornerRadius="9"
                                                                Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSuggestions}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding SearchActionText}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </Border>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding OpenManualSearchCommand}"
                                                                Style="{StaticResource PurchaseProductSearchButtonStyle}"
                                                                Margin="7,0,0,0"
                                                                ToolTip="{Binding SearchActionText}">
                                                            <materialDesign:PackIcon Kind="Magnify"
                                                                                     Width="18" Height="18"
                                                                                     Foreground="White"/>
                                                        </Button>
                                                    </Grid>

                                                    <Border Margin="0,6,0,0" Padding="8" CornerRadius="9"
                                                            Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            Visibility="{Binding IsManualSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="BUSCAR EN EL CATÁLOGO" FontSize="8"
                                                                           FontWeight="Bold" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <Button Grid.Column="1" Command="{Binding CloseManualSearchCommand}"
                                                                        Style="{StaticResource PurchaseSearchClearButtonStyle}"
                                                                        Width="24" Height="24" ToolTip="Cerrar búsqueda">
                                                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                                                </Button>
                                                            </Grid>
                                                            <Border Style="{StaticResource PurchaseFieldBorderStyle}" MinHeight="40">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <materialDesign:PackIcon Kind="Magnify" Width="17" Height="17"
                                                                                             Margin="11,0,0,0"
                                                                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                             VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding ManualSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                                             materialDesign:HintAssist.Hint="Código, nombre, modelo o presentación"/>
                                                                </Grid>
                                                            </Border>
                                                            <ProgressBar Height="3" Margin="1,6,1,0" IsIndeterminate="True"
                                                                         Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <ComboBox ItemsSource="{Binding ManualCandidates}"
                                                                      SelectedItem="{Binding SelectedManualCandidate,
                                                                          Mode=TwoWay,
                                                                          UpdateSourceTrigger=PropertyChanged}"
                                                                      Margin="0,7,0,0" Tag="Selecciona el producto"
                                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                                      Visibility="{Binding HasManualResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,3">
                                                                            <TextBlock Text="{Binding ProductoConMarca}" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                            <TextBlock Margin="0,2,0,0" FontSize="10"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                                                                <Run Text="{Binding PresentacionNombre, Mode=OneWay}"/>
                                                                                <Run Text=" · "/>
                                                                                <Run Text="{Binding CodigoBarras, Mode=OneWay, TargetNullValue=Sin código de barras}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <TextBlock Text="{Binding SearchMessage}" Margin="1,6,0,0"
                                                                       FontSize="9" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="TRATAMIENTO" Width="240" MinWidth="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <CheckBox Content="No inventariable"
                                                              IsChecked="{Binding IsNonInventory,
                                                                  Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                              Command="{Binding SetNonInventoryCommand}"
                                                              CommandParameter="{Binding IsChecked,
                                                                  RelativeSource={RelativeSource Self}}"
                                                              Style="{StaticResource PurchaseImportCheckBoxStyle}"
                                                               Visibility="{Binding ShowNonInventoryOption, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <StackPanel Margin="0,6,0,0"
                                                                Visibility="{Binding IsNonInventory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox ItemsSource="{Binding AccountingClassifications}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Code"
                                                                  SelectedValue="{Binding AccountingClassification, Mode=TwoWay}"
                                                                  Tag="Clasificación contable"
                                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                                        <ComboBox ItemsSource="{Binding AccountingAccounts}"
                                                                  SelectedItem="{Binding SelectedAccountingAccount, Mode=TwoWay}"
                                                                  DisplayMemberPath="Display"
                                                                  Margin="0,5,0,0"
                                                                  Tag="Cuenta de gasto o activo"
                                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <CheckBox Content="Es bonificación"
                                                               IsChecked="{Binding IsBonus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Margin="0,5,0,0"
                                                               Style="{StaticResource PurchaseImportCheckBoxStyle}"
                                                               Visibility="{Binding ShowBonusOption, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <CheckBox Content="Recordar relación"
                                                              IsChecked="{Binding RememberEquivalence}" Margin="0,5,0,0"
                                                              Style="{StaticResource PurchaseImportCheckBoxStyle}"
                                                              Visibility="{Binding ShowRememberEquivalence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="Usar esta relación automáticamente en próximas compras del proveedor"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ACCIÓN" Width="72" MinWidth="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.CreateProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource KontaxPrimaryButtonStyle}"
                                                        Width="34" Height="34" Padding="0"
                                                        Background="{DynamicResource PrimaryDarkBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Crear producto"
                                                        Visibility="{Binding ShowCreateAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="+" FontSize="20" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Paso 3: revisar compra -->
                    <Grid>
                        <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardStep}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PurchaseFormSectionStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Padding="16,14" Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="11"
                                                Background="#2563EB">
                                            <materialDesign:PackIcon Kind="FileDocumentCheckOutline" Width="22" Height="22"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentNumber, Mode=OneWay}" FontSize="20"
                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="COMPROBANTE XML" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding ImportedIssueDate, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}"
                                                           FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="3" Padding="12,7" CornerRadius="9"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding DocumentValidationDescription}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDocumentAuthorizedSri}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="15" Height="15"
                                                                         Foreground="White">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDocumentAuthorizedSri}" Value="True">
                                                                    <Setter Property="Kind" Value="CheckDecagram"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="{Binding DocumentValidationBadgeText}" Margin="6,0,0,0" FontSize="9"
                                                           FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,14,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PROVEEDOR" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SupplierName}" Margin="0,4,0,0" FontSize="16"
                                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SupplierName}"/>
                                        <TextBlock Text="{Binding SupplierRuc}" Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="11,7" CornerRadius="9"
                                            Background="{DynamicResource ElevatedSurfaceBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListNumbered" Width="16" Height="16"
                                                                     Foreground="{DynamicResource BrandProBrush}"/>
                                            <TextBlock Text="{Binding ImportedLineCount, StringFormat={}{0} líneas}"
                                                       Margin="7,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Margin="16,0,16,16" Style="{StaticResource PurchaseTableShellStyle}">
                                    <ScrollViewer x:Name="ReviewProductsScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  PanningMode="VerticalOnly"
                                                  PreviewMouseWheel="ReviewProductsScroll_PreviewMouseWheel">
                                        <ItemsControl ItemsSource="{Binding LineasImportadas}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="10" Margin="0,0,0,7" CornerRadius="10"
                                                            Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="14"/>
                                                                <ColumnDefinition Width="1.1*"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="8"
                                                                    Background="{DynamicResource PrimaryDarkBrush}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Order}" Foreground="White" FontSize="10"
                                                                           FontWeight="Bold" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                                                <TextBlock Margin="0,3,0,0" FontSize="10"
                                                                           Foreground="{DynamicResource MutedTextBrush}">
                                                                    <Run Text="Cantidad "/><Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.##}}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProductDisplay}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductDisplay}"/>
                                                                <TextBlock Text="{Binding MatchStatus}" Margin="0,3,0,0" FontSize="9"
                                                                           FontWeight="Bold" Foreground="{DynamicResource BrandProBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat={}{0:C2}}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PurchaseFormSectionStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="128"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Padding="14,10" Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource SuccessSoftBrush}">
                                            <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18"
                                                                     Foreground="{DynamicResource BrandProBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Condición comercial" Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                            <TextBlock Text="Confirma la condición acordada con el proveedor." Margin="0,1,0,0" FontSize="9"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="14,12,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="FORMA DE PAGO" Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" Padding="11,0" CornerRadius="9"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                            <CheckBox Content="Compra a crédito" IsChecked="{Binding IsCredit, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource PurchaseImportCheckBoxStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}">
                                            <Run Text="FECHA DE VENCIMIENTO"/><Run Text=" *" Foreground="#DC2626"/>
                                        </TextBlock>
                                        <Border Height="44" MinHeight="44" Style="{StaticResource PurchaseFieldBorderStyle}"
                                                IsEnabled="{Binding IsCredit}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="DueDateInput"
                                                         Text="{Binding DueDate, Mode=TwoWay, StringFormat=dd/MM/yyyy, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                                         Language="es-EC" ToolTip="DD/MM/AAAA"
                                                         behaviors:DateInputBehavior.IsEnabled="True"
                                                         Validation.ErrorTemplate="{x:Null}"
                                                         Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                         materialDesign:HintAssist.Hint="dd/mm/aaaa"/>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="CalendarMonthOutline"
                                                                         Width="18" Height="18"
                                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="14,12,14,4" VerticalAlignment="Top">
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Subtotal" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ImportedSubtotal, StringFormat={}{0:C2}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Descuento" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ImportedDiscount, StringFormat={}{0:C2}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Impuestos" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ImportedTaxTotal, StringFormat={}{0:C2}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Row="3" Margin="14,8,14,14" Padding="12" CornerRadius="11"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        BorderBrush="{DynamicResource BrandProBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TOTAL A REGISTRAR" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrandProBrush}"/>
                                            <TextBlock Text="Revisa el valor antes de continuar." Margin="0,3,0,0"
                                                       FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ImportedTotal, StringFormat={}{0:C2}}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   FontSize="23" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandProBrush}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Paso 4: recepción inmediata o diferida -->
                    <Grid>
                        <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource WizardStep}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource PurchaseFormSectionStyle}" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10"
                                            Background="{DynamicResource PrimaryDarkBrush}"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="PackageDown" Width="20" Height="20"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Recibir mercadería" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="Confirma el ingreso físico a bodega y completa lotes o series cuando el producto lo requiera."
                                                   TextWrapping="Wrap" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="10,6" CornerRadius="10"
                                            Margin="12,0,0,0"
                                            Background="{DynamicResource PrimaryDarkBrush}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ImportReceiptLines.Count, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text=" productos" Margin="4,0,0,0"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="245"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="275"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="TIPO DE RECEPCIÓN"
                                                   Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" Padding="11,0" CornerRadius="9"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1">
                                            <CheckBox Content="Recibir toda la mercadería ahora"
                                                      IsChecked="{Binding ReceiveImportedNow, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource PurchaseImportCheckBoxStyle}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" IsEnabled="{Binding ReceiveImportedNow}">
                                        <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}">
                                            <Run Text="BODEGA DE DESTINO"/><Run Text=" *" Foreground="#DC2626"/>
                                        </TextBlock>
                                        <ComboBox Height="44"
                                                  ItemsSource="{Binding Warehouses, Mode=OneWay}"
                                                  SelectedItem="{Binding ImportReceiptWarehouse, Mode=TwoWay}"
                                                  DisplayMemberPath="Display"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" IsEnabled="{Binding ReceiveImportedNow}">
                                        <TextBlock Text="FECHA DE RECEPCIÓN"
                                                   Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" MinHeight="44"
                                                Style="{StaticResource PurchaseFieldBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding ImportReceiptDate, Mode=TwoWay, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus}"
                                                         Language="es-EC" ToolTip="DD/MM/AAAA"
                                                         behaviors:DateInputBehavior.IsEnabled="True"
                                                         Validation.ErrorTemplate="{x:Null}"
                                                         Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                         materialDesign:HintAssist.Hint="dd/mm/aaaa"/>
                                                <materialDesign:PackIcon Grid.Column="1"
                                                                         Kind="CalendarMonthOutline"
                                                                         Width="18" Height="18"
                                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" IsEnabled="{Binding ReceiveImportedNow}">
                                        <TextBlock Text="OBSERVACIÓN"
                                                   Style="{StaticResource PurchaseFieldLabelStyle}"/>
                                        <Border Height="44" MinHeight="44"
                                                Style="{StaticResource PurchaseFieldBorderStyle}">
                                            <TextBox Text="{Binding ImportReceiptObservation, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                     materialDesign:HintAssist.Hint="Novedad o referencia opcional"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PurchaseTableShellStyle}" IsEnabled="{Binding ReceiveImportedNow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Padding="12,8"
                                        Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="8"
                                                Background="{DynamicResource PrimaryDarkBrush}">
                                            <materialDesign:PackIcon Kind="FormatListChecks" Width="16" Height="16"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Detalle de recepción"
                                                       Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                            <TextBlock Text="Verifica cantidades y trazabilidad antes de guardar."
                                                       Margin="0,2,0,0" FontSize="9"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="9,5" CornerRadius="9"
                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="LOTE · SERIE · CADUCIDAD"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled"
                                               Padding="8">
                                    <ItemsControl ItemsSource="{Binding ImportReceiptLines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="9,7" CornerRadius="10"
                                                        Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="1.25*" MinWidth="210"/>
                                                            <ColumnDefinition Width="11"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="11"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="11"/>
                                                            <ColumnDefinition Width="0.9*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="25" Height="25" CornerRadius="7"
                                                                Background="{DynamicResource PrimaryDarkBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Order}" Foreground="White"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Product, Mode=OneWay}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Product}"/>
                                                            <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                                       Margin="0,2,0,0" FontSize="9"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Description}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="A RECIBIR" FontSize="9" FontWeight="Bold"
                                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                                            <Border Margin="0,3,0,0" Padding="8,5" CornerRadius="7"
                                                                    Background="{DynamicResource PrimaryDarkBrush}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <materialDesign:PackIcon Kind="PackageVariantClosedCheck" Width="15" Height="15"
                                                                                             Margin="0,0,6,0"
                                                                                             Foreground="White"/>
                                                                    <TextBlock Text="{Binding ReceiveNow, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="6" Grid.ColumnSpan="3"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding NeedsTraceability, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="CONTROL DE INVENTARIO" FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TraceabilitySummary}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14"
                                                                                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                        <TextBlock Text="Lotes" Margin="4,0,8,0" FontSize="9"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   Visibility="{Binding HandlesLots, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        <materialDesign:PackIcon Kind="BarcodeScan" Width="14" Height="14"
                                                                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                                 Visibility="{Binding HandlesSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        <TextBlock Text="Series" Margin="4,0,0,0" FontSize="9"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   Visibility="{Binding HandlesSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Margin="10,0,0,0"
                                                                        MinWidth="126" Height="34"
                                                                        Command="{Binding DataContext.OpenTraceabilityEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource KontaxPrimaryButtonStyle}"
                                                                        Background="{DynamicResource PrimaryDarkBrush}"
                                                                        BorderBrush="{DynamicResource PrimaryDarkBrush}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <materialDesign:PackIcon Kind="PlaylistEdit" Width="16" Height="16"/>
                                                                        <TextBlock Text="{Binding TraceabilityButtonText}" Margin="7,0,0,0"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>

                                                        <Border Grid.Column="6" Grid.ColumnSpan="3"
                                                                Padding="10,7" CornerRadius="8"
                                                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1" VerticalAlignment="Center"
                                                                Visibility="{Binding NeedsTraceability, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                                                         Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                <TextBlock Text="CONTROL NORMAL" Margin="6,0,0,0"
                                                                           FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border Width="52" Height="52" CornerRadius="15"
                                            Background="{DynamicResource InputSecondaryBackgroundBrush}">
                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="27" Height="27"
                                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No hay mercadería inventariable por recibir"
                                               Margin="0,10,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="La compra se guardará sin generar una recepción física."
                                               Margin="0,3,0,0" FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasImportInventory, Mode=OneWay}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Width="122" Command="{Binding PreviousStepCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource KontaxSecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="1"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <Button.Content><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/><TextBlock Text="Atrás" Margin="7,0,0,0"/></StackPanel></Button.Content>
                    </Button>
                    <Button Grid.Column="3" Width="122" Command="{Binding NextStepCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource KontaxPrimaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="4"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Continuar"/><materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Grid.Column="3" MinWidth="122" Command="{Binding SaveImportCommand}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource KontaxPrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ImportStep}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18"/><TextBlock Text="Guardar compra" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Editor guiado compartido por recepciones XML y manuales. -->
        <Border Panel.ZIndex="150" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsTraceabilityEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="151" MinWidth="1050" MinHeight="680"
                MaxWidth="1320" MaxHeight="900" Margin="42,30"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsTraceabilityEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="PackageVariantPlus" Width="25" Height="25"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Lotes y series" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding TraceabilityLine.Product}"
                                   Margin="0,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseTraceabilityEditorCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                 Foreground="White"/>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="ManualPurchaseScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" MinWidth="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.35*" MinWidth="430"/>
                            </Grid.ColumnDefinitions>

                            <Border Padding="10,7" CornerRadius="10"
                                    Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource PrimaryDarkBrush}"
                                            VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="CANTIDAD DISTRIBUIDA" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource PrimaryTextBrush}">
                                                <Run Text="Asignado: "/>
                                                <Run Text="{Binding TraceabilityAssignedControl, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                     FontWeight="SemiBold"/>
                                                <Run Text="  —  " Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <Run Text="Requerido: "/>
                                                <Run Text="{Binding TraceabilityRequiredBase, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                     FontWeight="SemiBold"/>
                                                <Run Text="  —  " Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TraceabilityHasExcess}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Pendiente: "/>
                                                <Run Text="{Binding TraceabilityPendingControl, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                     FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Padding="9,6" CornerRadius="10"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding TraceabilityHandlesLots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="ArchiveSearchOutline" Width="17" Height="17"
                                                                 Foreground="{DynamicResource PrimaryDarkBrush}"/>
                                        <TextBlock Grid.Column="2" Text="LOTES REGISTRADOS · STOCK EN BODEGA"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Padding="7,2" CornerRadius="8"
                                                Background="{DynamicResource PrimaryDarkBrush}">
                                            <TextBlock Text="{Binding ExistingReceiptLots.Count, Mode=OneWay}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ExistingReceiptLots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,3" Padding="7,3" CornerRadius="7"
                                                            MinWidth="125"
                                                            Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="13" Height="13"
                                                                                     Margin="0,0,6,0"
                                                                                     Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding NumeroLote, Mode=OneWay}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Margin="7,0,0,0" FontSize="9"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="Stock "/>
                                                                <Run Text="{Binding StockActual, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                                     FontWeight="Bold"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding TraceabilityHandlesLots, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Lotes" Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                    <TextBlock Text="Busca y reutiliza un lote existente, o escribe uno nuevo. Distribuye toda la cantidad base."
                                               Style="{StaticResource PurchaseFieldHelpStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding AddTraceabilityLotCommand}"
                                        Style="{StaticResource KontaxPrimaryButtonStyle}"
                                        Background="{DynamicResource PrimaryDarkBrush}"
                                        BorderBrush="{DynamicResource PrimaryDarkBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17"/>
                                        <TextBlock Text="Agregar lote" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid x:Name="TraceabilityLotsGrid"
                                      ItemsSource="{Binding TraceabilityLots}"
                                      Style="{StaticResource KontaxDataGridStyle}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                                      RowHeight="NaN" MinRowHeight="54" MaxHeight="270">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="TraceabilityLotNumberColumn"
                                                            Header="LOTE" Width="*" MinWidth="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <Grid>
                                                        <Border Height="40" MinHeight="40"
                                                                Style="{StaticResource PurchaseFieldBorderStyle}">
                                                            <TextBox x:Name="ReceiptLotInput"
                                                                     Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     CharacterCasing="Upper"
                                                                     Padding="10,4">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource PurchaseFieldTextBoxStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExisting}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </Border>
                                                        <Popup PlacementTarget="{Binding ElementName=ReceiptLotInput}"
                                                               Placement="Bottom" VerticalOffset="3"
                                                               Width="{Binding ActualWidth, ElementName=ReceiptLotInput}"
                                                               MinWidth="360" MaxHeight="260"
                                                               AllowsTransparency="True" PopupAnimation="Fade"
                                                               StaysOpen="False"
                                                               IsOpen="{Binding ShowSuggestions, Mode=TwoWay}">
                                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                                    BorderThickness="1" CornerRadius="9" Padding="4">
                                                                 <ListBox ItemsSource="{Binding Suggestions}"
                                                                          SelectedItem="{Binding SelectedExistingLot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="TraceabilityLotSuggestion_SelectionChanged"
                                                                          Background="Transparent" BorderThickness="0"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           MaxHeight="250"
                                                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                           ScrollViewer.CanContentScroll="True"
                                                                           VirtualizingPanel.IsVirtualizing="True"
                                                                           VirtualizingPanel.VirtualizationMode="Recycling"
                                                                           VirtualizingPanel.ScrollUnit="Pixel">
                                                                    <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                                        <Border x:Name="ReceiptSuggestionBorder"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                CornerRadius="7" Padding="8,6">
                                                                                            <ContentPresenter/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="ReceiptSuggestionBorder"
                                                                                                        Property="Background"
                                                                                                        Value="{DynamicResource HoverBrush}"/>
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                                <Setter TargetName="ReceiptSuggestionBorder"
                                                                                                        Property="Background"
                                                                                                        Value="{DynamicResource TableSelectedRowBrush}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ListBox.ItemContainerStyle>
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid MinHeight="34">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="34"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Width="28" Height="28" CornerRadius="8"
                                                                                        Background="{DynamicResource PrimaryDarkBrush}"
                                                                                        VerticalAlignment="Center">
                                                                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="15" Height="15"
                                                                                                             Foreground="White"
                                                                                                             HorizontalAlignment="Center"
                                                                                                             VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding NumeroLote, Mode=OneWay}"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                                    <TextBlock Text="Lote existente · reutilizar registro"
                                                                                               FontSize="9"
                                                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                                </StackPanel>
                                                                                <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,4"
                                                                                        CornerRadius="8"
                                                                                        Background="{DynamicResource PrimaryDarkBrush}"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock FontSize="9"
                                                                                               Foreground="White">
                                                                                        <Run Text="Stock "/>
                                                                                        <Run Text="{Binding StockActual, Mode=OneWay, StringFormat={}{0:0.######}}"
                                                                                             FontWeight="Bold"/>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                    <StackPanel Margin="1,5,0,0"
                                                                Visibility="{Binding HasSimilarLot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock TextWrapping="Wrap" FontSize="9"
                                                                   Foreground="{DynamicResource WarningTextBrush}">
                                                            <Run Text="Posible equivalente: "/>
                                                            <Run Text="{Binding SimilarLot.NumeroLote}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Content="USAR EXISTENTE"
                                                                    Command="{Binding DataContext.UseExistingReceiptLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource KontaxSecondaryButtonStyle}"
                                                                    Padding="8,4" FontSize="9"/>
                                                            <Button Content="CREAR DE TODAS FORMAS" Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.CreateSimilarReceiptLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource DangerButtonStyle}"
                                                                    Padding="8,4" FontSize="9"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="TraceabilityLotQuantityColumn"
                                                            Header="CANTIDAD BASE" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Height="40" MinHeight="40"
                                                        Style="{StaticResource PurchaseFieldBorderStyle}">
                                                    <TextBox x:Name="TraceabilityLotQuantityInput"
                                                             Text="{Binding QuantityBase, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.######}}"
                                                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                             Padding="10,4"
                                                             HorizontalContentAlignment="Center"
                                                             behaviors:DecimalInputBehavior.IsEnabled="True"
                                                             behaviors:DecimalInputBehavior.DecimalPlaces="6"
                                                             behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True"
                                                             behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"
                                                             behaviors:DecimalInputBehavior.TrimTrailingZeros="True"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ELABORACIÓN" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Height="40" MinHeight="40"
                                                        Style="{StaticResource PurchaseFieldBorderStyle}">
                                                    <TextBox Text="{Binding ManufactureDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                             Padding="10,4"
                                                             Language="es-EC" ToolTip="DD/MM/AAAA (opcional)"
                                                             IsReadOnly="{Binding IsExisting}"
                                                             behaviors:DateInputBehavior.IsEnabled="True"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CADUCIDAD" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Height="40" MinHeight="40"
                                                        Style="{StaticResource PurchaseFieldBorderStyle}">
                                                    <TextBox Text="{Binding ExpirationDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource PurchaseFieldTextBoxStyle}"
                                                             Padding="10,4"
                                                             Language="es-EC" ToolTip="DD/MM/AAAA"
                                                             IsReadOnly="{Binding IsExisting}"
                                                             behaviors:DateInputBehavior.IsEnabled="True"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveTraceabilityLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource KontaxDeleteIconButtonStyle}"
                                                        ToolTip="Quitar lote">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding TraceabilityHandlesSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Series" Style="{StaticResource PurchaseSectionTitleStyle}"/>
                                    <TextBlock Text="Ingresa una serie única por cada unidad base y selecciona su lote cuando corresponda."
                                               Style="{StaticResource PurchaseFieldHelpStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding AddTraceabilitySeriesCommand}"
                                        Style="{StaticResource KontaxPrimaryButtonStyle}"
                                        Background="{DynamicResource PrimaryDarkBrush}"
                                        BorderBrush="{DynamicResource PrimaryDarkBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17"/>
                                        <TextBlock Text="Agregar serie" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DataGrid ItemsSource="{Binding TraceabilitySeries}"
                                      Style="{StaticResource KontaxDataGridStyle}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                                      MinRowHeight="50" MaxHeight="210">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="NÚMERO DE SERIE" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="LOTE ASOCIADO" Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.TraceabilityLots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Number" SelectedValuePath="RowId"
                                                          SelectedValue="{Binding LotRowId, Mode=TwoWay}"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          IsEnabled="{Binding DataContext.TraceabilityHandlesLots, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveTraceabilitySeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource KontaxDeleteIconButtonStyle}"
                                                        ToolTip="Quitar serie">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="11,8" CornerRadius="9" Margin="0,0,14,0"
                            Background="{DynamicResource DangerSoftBrush}"
                            Visibility="{Binding TraceabilityError, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                                     Foreground="#DC2626"/>
                            <TextBlock Text="{Binding TraceabilityError}" Margin="7,0,0,0"
                                       TextWrapping="Wrap" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1"
                            Command="{Binding CloseTraceabilityEditorCommand}"
                            Style="{StaticResource InventoryDialogCancelButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding SaveTraceabilityCommand}"
                            Style="{StaticResource InventoryDialogPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Aplicar control" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Compra manual: captura compacta con las mismas reglas visuales del importador XML. -->
        <Border Panel.ZIndex="120" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsManualFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Panel.ZIndex="121" Style="{StaticResource PurchaseWorkspaceStyle}"
                Visibility="{Binding IsManualFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{DynamicResource PrimaryDarkBrush}">
                        <materialDesign:PackIcon Kind="CartPlus" Width="25" Height="25"
                                                 Foreground="White" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                         <TextBlock Text="{Binding ManualFormTitle}" FontSize="23" FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"/>
                         <TextBlock Text="{Binding ManualFormDescription}"
                                   Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding CloseManualCommand}"
                            Style="{StaticResource PurchaseCloseButtonStyle}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,72">
                        <Border Style="{StaticResource PurchaseFormSectionStyle}" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,9,0">
                                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="17" Height="17"
                                                                 Foreground="White" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Información de la compra" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Identifica al proveedor y el documento que respalda la operación."
                                                   FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.15*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource PurchaseFieldLabelStyle}"><Run Text="PROVEEDOR"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                        <Border x:Name="ManualSupplierSearchBorder" Height="38" MinHeight="38"
                                                Style="{StaticResource PurchaseFieldBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19"
                                                                         Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox x:Name="ManualSupplierSearchInput" Grid.Column="1"
                                                         Text="{Binding ManualSupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding HasManualSupplierSelected, Mode=OneWay}"
                                                         Style="{StaticResource PurchaseFieldTextBoxStyle}" Padding="2,0,10,0"
                                                         materialDesign:HintAssist.Hint="Busca por RUC o razón social"/>
                                                <Button Grid.Column="2" Command="{Binding ClearManualSupplierSelectionCommand}"
                                                        Width="28" Height="28" Padding="0" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Quitar proveedor"
                                                        Visibility="{Binding HasManualSupplierSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ClearSupplierBorder" Width="26" Height="26"
                                                                    CornerRadius="8" Background="Transparent">
                                                                <materialDesign:PackIcon x:Name="ClearSupplierIcon"
                                                                                         Kind="Close" Width="16" Height="16"
                                                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ClearSupplierBorder" Property="Background"
                                                                            Value="{DynamicResource DangerSoftBrush}"/>
                                                                    <Setter TargetName="ClearSupplierIcon" Property="Foreground"
                                                                            Value="#DC2626"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="ClearSupplierBorder" Property="Background"
                                                                            Value="#DC2626"/>
                                                                    <Setter TargetName="ClearSupplierIcon" Property="Foreground"
                                                                            Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="ClearSupplierBorder" Property="BorderBrush"
                                                                            Value="#DC2626"/>
                                                                    <Setter TargetName="ClearSupplierBorder" Property="BorderThickness"
                                                                            Value="1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=ManualSupplierSearchBorder}"
                                               IsOpen="{Binding ShowManualSupplierSuggestions, Mode=TwoWay}"
                                               StaysOpen="False" AllowsTransparency="True"
                                               Width="{Binding ActualWidth, ElementName=ManualSupplierSearchBorder}">
                                            <Border Margin="0,4,0,0" Padding="6" CornerRadius="10"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                         <ListBox ItemsSource="{Binding ManualSupplierSuggestions}"
                                                                  SelectionChanged="ManualSupplierSuggestion_SelectionChanged"
                                                                  Background="Transparent" BorderThickness="0"
                                                                  ScrollViewer.CanContentScroll="True"
                                                                  VirtualizingPanel.IsVirtualizing="True"
                                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                                  VirtualizingPanel.ScrollUnit="Pixel">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="11,9" Background="Transparent">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}">
                                                                                <materialDesign:PackIcon Kind="StoreOutline" Width="17" Height="17" Foreground="#3B82F6"
                                                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Margin="0,3,0,0" FontSize="11"
                                                                                           Foreground="{DynamicResource MutedTextBrush}">
                                                                                    <Run Text="RUC  "/><Run Text="{Binding Identificacion}" FontWeight="SemiBold"/>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </ScrollViewer>
                                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,3,4,5"/>
                                                    <Button Command="{Binding RegisterManualSupplierCommand}"
                                                            Padding="10,8" Background="Transparent" BorderThickness="0"
                                                            HorizontalContentAlignment="Left" Cursor="Hand">
