<Window x:Class="KONTAXPRO.Desktop.Views.FacturacionElectronica.CertificatePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Contraseña del certificado"
        Width="480"
        Height="320"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}">
    <Border Margin="18"
            Padding="20"
            CornerRadius="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource PrimaryDarkBrush}">
                    <materialDesign:PackIcon Kind="KeyVariant"
                                             Foreground="White"
                                             Width="22"
                                             Height="22"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CERTIFICADO ELECTRÓNICO"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrandProBrush}"/>
                    <TextBlock Text="Ingresa la contraseña"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Se utilizará una sola vez para validar e importar la firma. KONTAXPRO no guarda la contraseña en texto visible."
                       TextWrapping="Wrap"
                       FontSize="10.5"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <PasswordBox x:Name="PasswordInput"
                         Grid.Row="4"
                         Height="44"
                         Padding="12,8"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         PasswordChar="●"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        MinWidth="104"
                        IsCancel="True"
                        Style="{StaticResource DangerButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="17"
                                                 Height="17"
                                                 Foreground="White"/>
                        <TextBlock Text="Cancelar"
                                   Margin="7,0,0,0"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        MinWidth="152"
                        IsDefault="True"
                        Click="Accept_Click"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheck"
                                                 Width="17"
                                                 Height="17"
                                                 Foreground="White"/>
                        <TextBlock Text="Validar certificado"
                                   Margin="7,0,0,0"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
