           <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryDarkBrush}"><materialDesign:PackIcon Kind="PencilRuler" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="CONFIGURAR SECUENCIAL" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Último número realmente emitido" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel>
           <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PUNTO" Style="{StaticResource SriLabel}"/><TextBlock Text="{Binding NumeracionSeleccionada.PuntoEmisionCodigo, TargetNullValue=—}" Style="{StaticResource SriValue}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="AMBIENTE" Style="{StaticResource SriLabel}"/><TextBlock Text="{Binding NumeracionSeleccionada.Ambiente, TargetNullValue=—}" Style="{StaticResource SriValue}"/></StackPanel></Grid>
           <StackPanel Grid.Row="4"><TextBlock Text="COMPROBANTE" Style="{StaticResource SriLabel}"/><TextBlock Text="{Binding NumeracionSeleccionada.TipoComprobanteNombre, TargetNullValue=—}" Style="{StaticResource SriValue}"/></StackPanel>
           <StackPanel Grid.Row="6"><TextBlock Text="ÚLTIMO NÚMERO EMITIDO" Style="{StaticResource SriLabel}"/><TextBox Height="44" Margin="0,4,0,0" Padding="10,3" FontSize="14" VerticalContentAlignment="Center" Text="{Binding UltimoSecuencialEditado, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NumeracionBloqueada, Converter={StaticResource BooleanInverterConverter}}" Style="{StaticResource SriSequenceTextBoxStyle}" TextAlignment="Center" MaxLength="9" behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="0" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/></StackPanel>
           <Border Grid.Row="8" Padding="10,8" CornerRadius="10" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource PrimaryDarkBrush}" BorderThickness="1"><StackPanel><TextBlock Text="PRÓXIMO COMPROBANTE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkBrush}"/><TextBlock Text="{Binding ProximoNumeroCompleto}" Margin="0,3,0,0" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center"/></StackPanel></Border>
           <TextBlock Grid.Row="9" Text="{Binding EstadoEdicionNumeracion}" Margin="0,10,0,6" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
           <Button Grid.Row="10" Height="40" Command="{Binding GuardarNumeracionCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="17" Height="17" Foreground="White"/><TextBlock Text="Guardar numeración" Margin="7,0,0,0" Foreground="White"/></StackPanel></Button>
          </Grid>

          <Grid Visibility="{Binding MostrarAdministracionPunto, Converter={StaticResource BooleanToVisibilityConverter}}">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="#2563EB"><materialDesign:PackIcon Kind="PointOfSale" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="ADMINISTRAR PUNTO" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Nombre, preferencia y disponibilidad" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel><Button Grid.Column="1" Width="34" Height="34" Command="{Binding AbrirEditorSecuencialCommand}" Style="{StaticResource NeutralButtonStyle}" Padding="0" ToolTip="Volver a configurar secuenciales"><materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"/></Button></Grid>
           <Border Grid.Row="2" Padding="11,9" CornerRadius="10" Background="{DynamicResource InputSecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PUNTO SELECCIONADO" Style="{StaticResource SriLabel}"/><TextBlock Text="{Binding PuntoEmisionSeleccionado.Descripcion, TargetNullValue=—}" Style="{StaticResource SriValue}"/></StackPanel><Border Grid.Column="1" Padding="9,4" CornerRadius="8" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#6B7280"/><Style.Triggers><DataTrigger Binding="{Binding PuntoEmisionSeleccionado.Activo}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding PuntoEmisionSeleccionado.EstadoPresentacion, TargetNullValue=—}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border></Grid></Border>
           <StackPanel Grid.Row="4"><TextBlock Text="NOMBRE INTERNO" Style="{StaticResource SriLabel}"/><TextBox Height="40" Margin="0,4,0,0" Text="{Binding NombrePuntoSeleccionadoEditado, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="150" Style="{StaticResource SriPointTextBoxStyle}"/></StackPanel>
           <Button Grid.Row="6" Height="40" Command="{Binding RenombrarPuntoEmisionCommand}" Style="{StaticResource SriBlueActionButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveEditOutline" Width="17" Height="17" Foreground="White"/><TextBlock Text="Guardar nombre" Margin="7,0,0,0" Foreground="White"/></StackPanel></Button>
           <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="40" Command="{Binding EstablecerPuntoPredeterminadoCommand}" Style="{StaticResource SriBlueActionButtonStyle}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="StarCheckOutline" Width="16" Height="16" Foreground="White"/><TextBlock Text="Usar como preferido" Margin="6,0,0,0" FontSize="9.5" Foreground="White"/></StackPanel></Button><Button Grid.Column="2" Height="40" Command="{Binding CambiarEstadoPuntoCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SriSolidActionButtonStyle}"><Setter Property="Background" Value="#D97706"/><Style.Triggers><DataTrigger Binding="{Binding PuntoEmisionSeleccionado.Activo}" Value="False"><Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArchiveArrowDownOutline" Width="16" Height="16" Foreground="White"/><TextBlock Text="{Binding TextoEstadoPunto}" Margin="6,0,0,0" FontSize="9.5" Foreground="White"/></StackPanel></Button></Grid>
          </Grid>

          <Grid Visibility="{Binding MostrarCreacionPunto, Converter={StaticResource BooleanToVisibilityConverter}}">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryDarkBrush}"><materialDesign:PackIcon Kind="Plus" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="NUEVO PUNTO DE EMISIÓN" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Nuevo o procedente de KONTAX anterior" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></StackPanel><Button Grid.Column="1" Width="34" Height="34" Command="{Binding AbrirEditorSecuencialCommand}" Style="{StaticResource NeutralButtonStyle}" Padding="0" ToolTip="Volver a configurar secuenciales"><materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"/></Button></Grid>
           <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CÓDIGO" Style="{StaticResource SriLabel}"/><TextBox Height="40" Margin="0,3,0,0" Text="{Binding CodigoNuevoPunto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SriPointTextBoxStyle}" TextAlignment="Center" MaxLength="3" behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="0" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="NOMBRE INTERNO" Style="{StaticResource SriLabel}"/><TextBox Height="40" Margin="0,3,0,0" Text="{Binding NombreNuevoPunto, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource SriPointTextBoxStyle}" MaxLength="150"/></StackPanel></Grid>
           <Border Grid.Row="4" Height="38" Padding="10,0" CornerRadius="9" Background="{DynamicResource InputSecondaryBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"><CheckBox IsChecked="{Binding NuevoPuntoPredeterminado}" IsEnabled="{Binding PuedePredeterminarPuntoNuevo}" Content="Usar como punto preferido" Style="{StaticResource KontaxCheckBoxStyle}" VerticalAlignment="Center"/></Border>
           <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton Height="38" GroupName="OrigenNumeracionPunto" IsChecked="{Binding ContinuarNumeracionExistente, Mode=TwoWay, Converter={StaticResource BooleanInverterConverter}}" Content="PUNTO NUEVO" FontSize="9.5" Style="{StaticResource SriChoice}"/><RadioButton Grid.Column="2" Height="38" GroupName="OrigenNumeracionPunto" IsChecked="{Binding ContinuarNumeracionExistente, Mode=TwoWay}" Content="CONTINUAR EXISTENTE" FontSize="9.5" Style="{StaticResource SriChoice}"/></Grid>
           <Border Grid.Row="8" Padding="7" CornerRadius="9" Background="{DynamicResource InputSecondaryBackgroundBrush}" BorderBrush="#D97706" BorderThickness="1" Visibility="{Binding ContinuarNumeracionExistente, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ÚLTIMO NÚMERO EMITIDO POR AMBIENTE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}"/><DataGrid Grid.Row="2" ItemsSource="{Binding InicializacionSecuenciales}" AutoGenerateColumns="False" IsReadOnly="False" Style="{StaticResource KontaxDataGridStyle}" ColumnHeaderStyle="{StaticResource SriCompactSequenceHeaderStyle}" BorderThickness="0" GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" MinRowHeight="38" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"><DataGrid.Columns><DataGridTemplateColumn Header="COMPROBANTE" Width="1.05*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Comprobante}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="PRUEBAS" Width="*" HeaderStyle="{StaticResource SriCompactCenteredHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><CheckBox IsChecked="{Binding TieneEmisionesPruebas}" Content="Emitió" FontSize="8" Style="{StaticResource KontaxCheckBoxStyle}"/><TextBox Height="27" Text="{Binding UltimoSecuencialPruebas, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TieneEmisionesPruebas}" Style="{StaticResource SriSequenceTextBoxStyle}" Padding="5,1" FontSize="9" TextAlignment="Center" MaxLength="9" behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="0" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="PRODUCCIÓN" Width="*" HeaderStyle="{StaticResource SriCompactCenteredHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><CheckBox IsChecked="{Binding TieneEmisionesProduccion}" Content="Emitió" FontSize="8" Style="{StaticResource KontaxCheckBoxStyle}"/><TextBox Height="27" Text="{Binding UltimoSecuencialProduccion, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TieneEmisionesProduccion}" Style="{StaticResource SriSequenceTextBoxStyle}" Padding="5,1" FontSize="9" TextAlignment="Center" MaxLength="9" behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="0" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
           </Border>
           <Button Grid.Row="10" Height="40" Command="{Binding CrearPuntoEmisionCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PlusCircleOutline" Width="17" Height="17" Foreground="White"/><TextBlock Text="Crear punto de emisión" Margin="7,0,0,0" Foreground="White"/></StackPanel></Button>
          </Grid>
         </Grid>
        </Border>
       </Grid>
      </Grid>
    </TabItem>
   </TabControl>
 </Grid>
</UserControl>
