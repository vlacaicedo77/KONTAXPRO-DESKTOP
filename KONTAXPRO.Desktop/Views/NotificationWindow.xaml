<Window x:Class="KONTAXPRO.Desktop.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Border Style="{StaticResource KontaxNotificationCardStyle}" Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="5"
                    Margin="0,0,14,0"
                    CornerRadius="3"
                    Background="{Binding AccentBrush}"/>

            <materialDesign:PackIcon Grid.Column="1"
                                     Kind="{Binding IconKind}"
                                     Width="23"
                                     Height="23"
                                     Margin="0,1,13,0"
                                     Foreground="{Binding AccentBrush}"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding NotificationTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Message}"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="3"
                    Width="30"
                    Height="30"
                    Margin="12,-5,-5,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Cerrar"
                    Click="CloseButton_Click">
                <materialDesign:PackIcon Kind="Close"
                                         Width="16"
                                         Height="16"
                                         Foreground="{DynamicResource TextMutedBrush}"/>
            </Button>
        </Grid>
    </Border>
</Window>
