<UserControl x:Class="KONTAXPRO.Desktop.Views.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:productViews="clr-namespace:KONTAXPRO.Desktop.Views.Products"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1250">



    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <!-- =====================================================
             LISTADO
             ===================================================== -->

        <productViews:ProductsCatalogContentView DataContext="{Binding}"/>

        <!-- =====================================================
             FORMULARIO FULL WORKSPACE
             ===================================================== -->

        <Border Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsProductFormOpen,
                    Converter={StaticResource BooleanToVisibilityConverter}}"/>


        <Border Margin="18"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Visibility="{Binding IsProductFormOpen,
            Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="35"
                                  ShadowDepth="0"
                                  Opacity="0.32" />

            </Border.Effect>

            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProductFormOpen}"
                                         Value="True">
                                <Setter Property="Content"
                                        Value="{Binding ProductForm}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <productViews:ProductFormView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Border>

        <!-- =====================================================
     MODAL - VERIFICACIÓN PREVIA DE PRODUCTO
     ===================================================== -->

        <!-- Atenuación -->
        <Border Panel.ZIndex="200"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsNewProductCheckOpen,
            Converter={StaticResource BooleanToVisibilityConverter}}" />


        <!-- Modal -->
        <Border Panel.ZIndex="201"
                Width="520"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="{Binding IsNewProductCheckOpen,
            Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="36"
                                  ShadowDepth="0"
                                  Opacity="0.32" />

            </Border.Effect>


            <StackPanel>

                <!-- =============================================
             CABECERA
             ============================================= -->

                <Grid Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!-- Icono -->

                     <Border Width="46"
                             Height="46"
                             CornerRadius="13"
                             Background="{DynamicResource PrimaryDarkBrush}"
                             Margin="0,0,13,0">

                        <materialDesign:PackIcon Kind="BarcodeScan"
                                                 Width="24"
                                                 Height="24"
                                                  Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />

                    </Border>


                    <!-- Título -->

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="Verificar producto"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="Comprueba el código antes de registrar una nueva presentación."
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>


                    <!-- Cerrar -->

                    <Button Grid.Column="2"
                            Width="38"
                            Height="38"
                            Padding="0"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelarVerificacionNuevoProductoCommand}">

                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White" />

                    </Button>

                </Grid>


                <!-- =============================================
             EXPLICACIÓN
             ============================================= -->

                <Border Padding="13"
                        Margin="0,0,0,18"
                        CornerRadius="10"
                        Background="{DynamicResource InfoSoftBrush}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="19"
                                                 Height="19"
                                                 Margin="0,1,10,0"
                                                 Foreground="#3B82F6" />

                        <TextBlock Grid.Column="1"
                                   Text="Escanea el código de barras del producto o ingrésalo manualmente. Esto permite comprobar si la presentación ya está registrada."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </Grid>

                </Border>


                <!-- =============================================
             CÓDIGO DE BARRAS
             ============================================= -->

                <TextBlock Text="Código de barras"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,7" />


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!-- Entrada -->

                    <Border Height="46"
                            Background="{DynamicResource InputSecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="Barcode"
                                                     Width="19"
                                                     Height="19"
                                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />

                            <TextBox x:Name="CodigoBarrasVerificacionInput"
                                     Grid.Column="1"
                                     Text="{Binding CodigoBarrasNuevoProducto,
                                 UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource BrandProBrush}"
                                     FontSize="14"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                                Command="{Binding VerificarCodigoBarrasCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                        </Grid>

                    </Border>


                    <!-- Verificar -->

                    <Button Grid.Column="2"
                            Height="46"
                            MinWidth="112"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding VerificarCodigoBarrasCommand}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="Magnify"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="White"
                                                     VerticalAlignment="Center" />

                            <TextBlock Text="Verificar"
                                       Margin="7,0,0,0"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- =============================================
             MENSAJE DE VALIDACIÓN
             ============================================= -->

                <TextBlock Text="{Binding MensajeVerificacionBarcode}"
                           Margin="2,10,0,0"
                           Foreground="#EF4444"
                           FontSize="11"
                           FontWeight="Medium"
                           TextWrapping="Wrap" />


                <!-- =============================================
             PRODUCTO ENCONTRADO
             ============================================= -->

                <Border Margin="0,14,0,0"
                        Padding="14"
                        CornerRadius="12"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        Visibility="{Binding HayProductoCodigoEncontrado,
            Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding ProductoCodigoEncontrado}"
                                             Value="{x:Null}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                </DataTrigger>

                                <DataTrigger Binding="{Binding ProductoCodigoEncontrado,
                            TargetNullValue=False}"
                                             Value="False">

                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <Border Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="#22F59E0B">

                            <materialDesign:PackIcon Kind="AlertOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="#F59E0B"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />

                        </Border>


                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Presentación ya registrada"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Text="{Binding ProductoCodigoEncontrado.Nombre}"
                                       Margin="0,7,0,0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Text="{Binding ProductoCodigoEncontrado.Modelo}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,6,0,0">

                                <TextBlock Text="Presentación: "
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock Text="{Binding ProductoCodigoEncontrado.Presentacion}"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

                <Button Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AbrirProductoEncontradoCommand}"
                        Visibility="{Binding HayProductoCodigoEncontrado,
                            Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="OpenInNew"
                                                 Width="17"
                                                 Height="17"
                                                 Margin="0,0,7,0"
                                                 Foreground="White" />

                        <TextBlock Text="Abrir producto existente"
                                   FontWeight="SemiBold"
                                   Foreground="White" />

                    </StackPanel>

                </Button>


                <!-- =============================================
             SEPARADOR
             ============================================= -->

                <Border Height="1"
                        Margin="0,20,0,18"
                        Background="{DynamicResource BorderBrush}" />


                <!-- =============================================
             SIN CÓDIGO
             ============================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="¿La presentación no tiene código?"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="KONTAXPRO generará uno automáticamente al guardar."
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>


                    <Button Grid.Column="1"
                            Margin="16,0,0,0"
                            Command="{Binding ContinuarSinCodigoBarrasCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="BarcodeOff"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,7,0" />

                            <TextBlock Text="Continuar sin código"
                                       FontWeight="SemiBold" />

                        </StackPanel>

                    </Button>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
