<UserControl x:Class="KONTAXPRO.Desktop.Views.Products.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

        </Style>


        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="Margin"
                    Value="1,0,0,6" />

        </Style>


        <Style x:Key="FieldHelpStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="Foreground"
                    Value="{DynamicResource MutedTextBrush}" />

            <Setter Property="Margin"
                    Value="1,5,0,0" />

        </Style>


        <Style x:Key="FormSectionStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource SecondarySurfaceBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="14" />

            <Setter Property="Padding"
                    Value="18" />

        </Style>


        <Style x:Key="FormFieldBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="9" />

            <Setter Property="MinHeight"
                    Value="48" />

            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource FocusBorderBrush}" />

                    <Setter Property="BorderThickness"
                            Value="2" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="CaretBrush"
                    Value="{DynamicResource FocusBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="13,10" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

        </Style>

        <!-- ============================================================
     CHECKBOX KONTAXPRO
     ============================================================ -->

        <Style x:Key="ProductCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="CheckBorder"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">

                                <materialDesign:PackIcon x:Name="CheckIcon"
                                                         Kind="Check"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="Collapsed" />

                            </Border>


                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center" />

                        </StackPanel>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="#A855F7" />

                            </Trigger>


                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="#9333EA" />

                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="#9333EA" />

                                <Setter TargetName="CheckIcon"
                                        Property="Visibility"
                                        Value="Visible" />

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.50" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ModernComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="MinHeight"
                    Value="46" />

            <Setter Property="Padding"
                    Value="13,0,38,0" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />


            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- CAMPO -->
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>


                                    <!-- VALOR -->
                                    <ContentPresenter Margin="13,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />


                                    <!-- FLECHA -->
                                    <Border Grid.Column="1"
                                            Background="Transparent">

                                        <materialDesign:PackIcon Kind="ChevronDown"
                                                                 Width="18"
                                                                 Height="18"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{TemplateBinding Foreground}" />

                                    </Border>


                                    <!-- ÁREA DE CLICK -->
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">

                                        <ToggleButton.Template>

                                            <ControlTemplate TargetType="ToggleButton">

                                                <Border Background="Transparent" />

                                            </ControlTemplate>

                                        </ToggleButton.Template>

                                    </ToggleButton>

                                </Grid>

                            </Border>


                            <!-- POPUP -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Margin="0,5,0,0"
                                        MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="3"
                                                          Opacity="0.18" />

                                    </Border.Effect>


                                    <ScrollViewer>

                                        <ItemsPresenter />

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">

                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBorderBrush}" />

                                <Setter TargetName="ComboBorder"
                                        Property="BorderThickness"
                                        Value="2" />

                            </Trigger>


                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBorderBrush}" />

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>


            <!-- ITEMS -->
            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Padding"
                                Value="12,9" />

                        <Setter Property="Foreground"
                                Value="{DynamicResource PrimaryTextBrush}" />

                        <Setter Property="Background"
                                Value="Transparent" />

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />

                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}" />


                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}" />

                            </Trigger>


                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{DynamicResource SelectionBackgroundBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}" />

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="{DynamicResource ElevatedSurfaceBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- =====================================================
             CABECERA
             ===================================================== -->

        <Border Grid.Row="0"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="13" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <Border Width="48"
                        Height="48"
                        CornerRadius="14"
                        Background="{DynamicResource SuccessSoftBrush}">

                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                             Width="25"
                                             Height="25"
                                             Foreground="{DynamicResource BrandProBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />

                </Border>


                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding TituloFormulario}"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Text="Información comercial, tributaria y control de inventario"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />

                </StackPanel>


                <Button Grid.Column="3"
                        Width="42"
                        Height="42"
                        Padding="0"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding CancelarCommand}">

                    <materialDesign:PackIcon Kind="Close"
                                             Foreground="White" />

                </Button>

            </Grid>

        </Border>


        <!-- =====================================================
             CONTENIDO
             ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="26">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <!-- Producto / Clasificación -->
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="18" />

                    <!-- Presentación base -->
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="18" />

                    <!-- Inventario -->
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="18" />

                    <!-- Observaciones -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- =================================================
     INFORMACIÓN GENERAL
     ================================================= -->

                <Border Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource FormSectionStyle}">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,18">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{DynamicResource SuccessSoftBrush}"
                                    Margin="0,0,10,0">

                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Foreground="{DynamicResource BrandProBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="Información general"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />

                        </StackPanel>


                        <!-- NOMBRE -->

                        <TextBlock Text="Nombre comercial *"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,15">

                            <!-- CAMPO -->
                            <Border x:Name="NombreField"
                                    Style="{StaticResource FormFieldBorderStyle}">

                                <TextBox Text="{Binding Nombre,
                    UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" />

                            </Border>


                            <!-- SUGERENCIAS -->
                            <Popup PlacementTarget="{Binding ElementName=NombreField}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="True"
                                   IsOpen="{Binding MostrarSugerenciasNombre,
                                   Mode=OneWay}">

                                <Border Width="{Binding ActualWidth,
                    ElementName=NombreField}"
                                        MaxHeight="280"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="3"
                                                          Opacity="0.22" />

                                    </Border.Effect>


                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding SugerenciasProductos}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Button Command="{Binding DataContext.AbrirProductoSugeridoCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand">

                                                        <Button.Template>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border x:Name="SuggestionBorder"
                                                                        Background="Transparent"
                                                                        Padding="13,11">

                                                                    <Grid>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>


                                                                        <StackPanel>

                                                                            <!-- PRODUCTO -->
                                                                            <TextBlock Text="{Binding Nombre}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />


                                                                            <!-- MODELO / MARCA -->
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        Margin="0,3,0,0">

                                                                                <TextBlock Text="{Binding Modelo}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                                                                <TextBlock Text=" · "
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource MutedTextBrush}" />

                                                                                <TextBlock Text="{Binding Marca}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                                                            </StackPanel>


                                                                            <!-- PRESENTACIONES -->
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        Margin="0,5,0,0">

                                                                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                                                         Width="13"
                                                                                                         Height="13"
                                                                                                         Margin="0,0,5,0"
                                                                                                         Foreground="{DynamicResource BrandProBrush}" />

                                                                                <TextBlock Text="{Binding PresentacionesTexto}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />

                                                                            </StackPanel>

                                                                        </StackPanel>


                                                                        <materialDesign:PackIcon Grid.Column="1"
                                                                                                 Kind="ChevronRight"
                                                                                                 Width="19"
                                                                                                 Height="19"
                                                                                                 Margin="12,0,0,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="{DynamicResource BrandProBrush}" />

                                                                    </Grid>

                                                                </Border>


                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                                                             Value="True">

                                                                        <Setter TargetName="SuggestionBorder"
                                                                                Property="Background"
                                                                                Value="{DynamicResource SuccessSoftBrush}" />

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Button.Template>

                                                    </Button>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <!-- MODELO / ESPECIFICACIÓN -->

                        <TextBlock Text="Modelo / especificación"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,15">

                            <Border x:Name="ModeloField"
                                    Style="{StaticResource FormFieldBorderStyle}">

                                <TextBox Text="{Binding Modelo,
                    UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" />

                            </Border>


                            <Popup PlacementTarget="{Binding ElementName=ModeloField}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="True"
                                   IsOpen="{Binding MostrarSugerenciasModelo,
                                    Mode=OneWay}">

                                <Border Width="{Binding ActualWidth,
                    ElementName=ModeloField}"
                                        MaxHeight="280"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="3"
                                                          Opacity="0.22" />

                                    </Border.Effect>


                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding SugerenciasProductos}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Button Command="{Binding DataContext.AbrirProductoSugeridoCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand">

                                                        <Button.Template>

                                                            <ControlTemplate TargetType="Button">

                                                                <Border x:Name="SuggestionBorder"
                                                                        Background="Transparent"
                                                                        Padding="13,11">

                                                                    <Grid>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>


                                                                        <StackPanel>

                                                                            <TextBlock Text="{Binding Nombre}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                                                                            <TextBlock Text="{Binding Modelo}"
                                                                                       Margin="0,3,0,0"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                                                                            <StackPanel Orientation="Horizontal"
                                                                                        Margin="0,5,0,0">

                                                                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                                                         Width="13"
                                                                                                         Height="13"
                                                                                                         Margin="0,0,5,0"
                                                                                                         Foreground="{DynamicResource BrandProBrush}" />

                                                                                <TextBlock Text="{Binding PresentacionesTexto}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />

                                                                            </StackPanel>

                                                                        </StackPanel>


                                                                        <materialDesign:PackIcon Grid.Column="1"
                                                                                                 Kind="ChevronRight"
                                                                                                 Width="19"
                                                                                                 Height="19"
                                                                                                 Margin="12,0,0,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="{DynamicResource BrandProBrush}" />

                                                                    </Grid>

                                                                </Border>


                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver"
                                                                             Value="True">

                                                                        <Setter TargetName="SuggestionBorder"
                                                                                Property="Background"
                                                                                Value="{DynamicResource SuccessSoftBrush}" />

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Button.Template>

                                                    </Button>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <TextBlock Text="Modelo, composición, concentración o referencia que identifica al producto."
                                   Style="{StaticResource FieldHelpStyle}"
                                   Margin="0,-10,0,15" />


                        <!-- DESCRIPCIÓN -->

                        <TextBlock Text="Descripción"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Border Style="{StaticResource FormFieldBorderStyle}"
                                MinHeight="95">

                            <TextBox Text="{Binding Descripcion,
                        UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="90" />

                        </Border>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     CLASIFICACIÓN
                     ================================================= -->

                <Border Grid.Column="2"
                        Grid.Row="0"
                        Style="{StaticResource FormSectionStyle}">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,18">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{DynamicResource InfoSoftBrush}"
                                    Margin="0,0,10,0">

                                <materialDesign:PackIcon Kind="ShapeOutline"
                                                         Foreground="#3B82F6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="Clasificación"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />

                        </StackPanel>


                        <!-- CATEGORÍA -->

                        <TextBlock Text="Categoría"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox ItemsSource="{Binding Categorias}"
                                      DisplayMemberPath="Nombre"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding CategoriaProductoId}"
                                      Style="{StaticResource ModernComboBoxStyle}" />

                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{DynamicResource CatalogAddButtonStyle}"
                                    Command="{Binding NuevaCategoriaCommand}">

                                <materialDesign:PackIcon Kind="Plus"
                                                         Width="19"
                                                         Height="19"
                                                         Foreground="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=Button}}" />

                            </Button>

                        </Grid>

                        <TextBlock Text="Puedes crear una categoría sin abandonar el producto."
                                   Style="{StaticResource FieldHelpStyle}"
                                   Margin="0,0,0,14" />


                        <!-- MARCA -->

                        <TextBlock Text="Marca"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>


                            <ComboBox ItemsSource="{Binding Marcas}"
                                      DisplayMemberPath="Nombre"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding MarcaId}"
                                      Style="{StaticResource ModernComboBoxStyle}" />


                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource CatalogAddButtonStyle}"
                                    Command="{Binding NuevaMarcaCommand}">

                                <materialDesign:PackIcon Kind="Plus"
                                                         Foreground="{DynamicResource CatalogButtonForegroundBrush}" />

                            </Button>

                        </Grid>

                        <TextBlock Text="Fabricante o marca comercial."
                                   Style="{StaticResource FieldHelpStyle}"
                                   Margin="0,0,0,14" />

                        <!-- IVA -->

                        <TextBlock Text="IVA / impuesto *"
                                   Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox ItemsSource="{Binding TarifasImpuesto}"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding TarifaImpuestoId}"
                                  Style="{StaticResource ModernComboBoxStyle}" />


                    </StackPanel>

                </Border>

                <!-- =================================================
     PRESENTACIÓN BASE
     ================================================= -->

                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource FormSectionStyle}">

                    <StackPanel>

                        <!-- CABECERA -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,18">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{DynamicResource PurpleSoftBrush}"
                                    Margin="0,0,10,0">

                                <materialDesign:PackIcon Kind="Barcode"
                                                         Width="19"
                                                         Height="19"
                                                         Foreground="#9333EA"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />

                            </Border>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Presentación base"
                                           Style="{StaticResource SectionTitleStyle}" />

                                <TextBlock Text="Define cómo se identifica y comercializa inicialmente este producto."
                                           Style="{StaticResource FieldHelpStyle}"
                                           Margin="0,2,0,0" />

                            </StackPanel>

                        </StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <!-- =============================================
                 IZQUIERDA
                 ============================================= -->

                            <StackPanel>

                                <!-- NOMBRE PRESENTACIÓN -->

                                <TextBlock Text="Nombre de presentación *"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <Border Style="{StaticResource FormFieldBorderStyle}"
                                        Margin="0,0,0,15">

                                    <TextBox Text="{Binding PresentacionNombre,
                                UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}" />

                                </Border>

                                <TextBlock Text="Ej.: Frasco 50 ML, Caja x 12, Botella 1 L, Unidad."
                                           Style="{StaticResource FieldHelpStyle}"
                                           Margin="0,-10,0,15" />


                                <!-- UNIDAD -->

                                <TextBlock Text="Unidad de medida *"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <ComboBox ItemsSource="{Binding UnidadesMedida}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding UnidadMedidaBaseId}"
                                          Style="{StaticResource ModernComboBoxStyle}" />

                            </StackPanel>


                            <!-- =============================================
                 DERECHA
                 ============================================= -->

                            <StackPanel Grid.Column="2">

                                <!-- CÓDIGO DE BARRAS -->

                                <TextBlock Text="Código de barras"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <Border Style="{StaticResource FormFieldBorderStyle}">

                                    <TextBox Text="{Binding CodigoBarras,
                                             UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             IsReadOnly="{Binding SinCodigoBarras}" />

                                </Border>


                                <!-- SIN CÓDIGO -->

                                <CheckBox Content="No posee código de barras del fabricante"
                                          IsChecked="{Binding SinCodigoBarras}"
                                          Style="{StaticResource ProductCheckBoxStyle}"
                                          Margin="2,14,0,0"
                                          FontWeight="SemiBold" />


                                <!-- AYUDA -->

                                <Border Margin="0,14,0,0"
                                        Padding="12"
                                        CornerRadius="9"
                                        Background="{DynamicResource InfoSoftBrush}">

                                    <StackPanel Orientation="Horizontal">

                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,1,9,0"
                                                                 Foreground="{DynamicResource BrandProBrush}" />

                                        <TextBlock Text="{Binding TextoAyudaCodigoBarras}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     INVENTARIO
                     ================================================= -->

                <Border Grid.Row="4"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource FormSectionStyle}">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,18">

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="9"
                                    Background="{DynamicResource WarningSoftBrush}"
                                    Margin="0,0,10,0">

                                <materialDesign:PackIcon Kind="Warehouse"
                                                         Foreground="#F59E0B"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />

                            </Border>

                            <TextBlock Text="Comportamiento e inventario"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />

                        </StackPanel>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <!-- IZQUIERDA -->

                            <StackPanel>

                                <TextBlock Text="Tipo de registro *"
                                           Style="{StaticResource FieldLabelStyle}" />


                                    <ComboBox ItemsSource="{Binding TiposProducto}"
                                              SelectedItem="{Binding TipoProducto}"
                                              Style="{StaticResource ModernComboBoxStyle}" />


                                <StackPanel Visibility="{Binding MostrarConfiguracionInventario,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <TextBlock Text="Tipo de control"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,14,0,6" />


                                    <ComboBox ItemsSource="{Binding TiposControlInventario}"
                                              SelectedItem="{Binding TipoControlInventario}"
                                              Style="{StaticResource ModernComboBoxStyle}" />

                                </StackPanel>

                            </StackPanel>


                            <!-- DERECHA -->

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding MostrarConfiguracionInventario,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">

                                        <CheckBox Content="Alertar stock mínimo"
                                                  IsChecked="{Binding AlertaStockMinimo}"
                                                  Style="{StaticResource ProductCheckBoxStyle}"
                                                  FontWeight="SemiBold" />

                                        <TextBlock Text="Avisar cuando la existencia alcance el nivel mínimo."
                                                   Style="{StaticResource FieldHelpStyle}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Stock mínimo"
                                                   Style="{StaticResource FieldLabelStyle}" />

                                        <Border Style="{StaticResource FormFieldBorderStyle}">

                                            <TextBox Text="{Binding StockMinimo,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBoxStyle}" />

                                        </Border>

                                    </StackPanel>

                                </Grid>


                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource OrangeSoftBrush}"
                                        BorderBrush="#F59E0B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding MostrarConfiguracionCaducidad,
                                            Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="Control de caducidad"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                                            <CheckBox Content="Controlar fecha de caducidad"
                                                      IsChecked="{Binding AlertaCaducidad}"
                                                      Style="{StaticResource ProductCheckBoxStyle}"
                                                      Margin="0,10,0,0" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="Días de anticipación"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <Border Style="{StaticResource FormFieldBorderStyle}">

                                                <TextBox Text="{Binding DiasAlertaCaducidad,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" />

                                            </Border>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- =================================================
                     OBSERVACIONES
                     ================================================= -->

                <Border Grid.Row="6"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource FormSectionStyle}">

                    <StackPanel>

                        <TextBlock Text="Observaciones"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,12" />

                        <Border Style="{StaticResource FormFieldBorderStyle}"
                                MinHeight="90">

                            <TextBox Text="{Binding Observacion,
                                        UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MinHeight="85" />

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <Border Grid.Row="2"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,14">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0"
                      VerticalAlignment="Center">

                    <!-- CARGANDO -->

                    <ProgressBar Width="130"
                                 Height="4"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading,
                    Converter={StaticResource BooleanToVisibilityConverter}}" />


                    <!-- ERROR -->

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <StackPanel.Style>

                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding MensajeError}"
                                                 Value="{x:Null}">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding MensajeError}"
                                                 Value="">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </StackPanel.Style>


                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 Foreground="#EF4444" />

                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="#EF4444"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxWidth="600" />

                    </StackPanel>

                </Grid>


                <Button Grid.Column="1"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding CancelarCommand}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="Close"
                                                 Foreground="White"
                                                 VerticalAlignment="Center" />

                        <TextBlock Text="Cancelar"
                                   Margin="8,0,0,0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>


                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding IsLoading,
            Converter={StaticResource BooleanInverterConverter}}">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ContentSaveOutline"
                                                 Foreground="White"
                                                 VerticalAlignment="Center" />

                        <TextBlock Text="{Binding TextoBotonGuardar}"
                                   Margin="8,0,0,0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

            </Grid>

        </Border>


        <!-- =====================================================
             MINI MODAL - NUEVA CATEGORÍA / MARCA
             ===================================================== -->

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsQuickCatalogOpen,
            Converter={StaticResource BooleanToVisibilityConverter}}" />


        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="101"
                Width="460"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{Binding IsQuickCatalogOpen,
            Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border.Effect>

                <DropShadowEffect BlurRadius="32"
                                  ShadowDepth="0"
                                  Opacity="0.35" />

            </Border.Effect>


            <StackPanel>

                <Grid Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <Border Width="42"
                            Height="42"
                            CornerRadius="11"
                            Background="{DynamicResource SuccessSoftBrush}">

                        <materialDesign:PackIcon Kind="{Binding QuickCatalogIcon}"
                                                 Width="21"
                                                 Height="21"
                                                 Foreground="{DynamicResource BrandProBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />

                    </Border>


                    <StackPanel Grid.Column="2">

                        <TextBlock Text="{Binding QuickCatalogTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="El nuevo registro quedará seleccionado automáticamente."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" />

                    </StackPanel>


                    <Button Grid.Column="3"
                            Width="38"
                            Height="38"
                            Padding="0"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelarCatalogoRapidoCommand}">

                        <materialDesign:PackIcon Kind="Close"
                                                 Foreground="White" />

                    </Button>

                </Grid>


                <TextBlock Text="{Binding QuickCatalogLabel}"
                           Style="{StaticResource FieldLabelStyle}" />

                <Border Style="{StaticResource FormFieldBorderStyle}">

                    <TextBox Text="{Binding QuickCatalogName,
                                UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" />

                </Border>


                <TextBlock Text="{Binding QuickCatalogError}"
                           Foreground="#EF4444"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />


                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="1"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="Cancelar"
                            Command="{Binding CancelarCatalogoRapidoCommand}" />


                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Guardar"
                            IsEnabled="{Binding IsQuickCatalogSaving,
            Converter={StaticResource BooleanInverterConverter}}"
                            Command="{Binding GuardarCatalogoRapidoCommand}" />

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>