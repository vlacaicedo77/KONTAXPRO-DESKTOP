<UserControl x:Class="KONTAXPRO.Desktop.Views.Products.ProductsCatalogContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:productModels="clr-namespace:KONTAXPRO.Application.Models.Productos;assembly=KONTAXPRO.Application">

    <UserControl.Resources>
        <Style x:Key="CatalogKpiButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogCenteredSortHeaderStyle"
               TargetType="Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SortHeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogSortHeaderStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SortHeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource KontaxDataGridColumnHeaderStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource TableAlternateRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogCenteredColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource CatalogColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CatalogMorePresentationsStyle" TargetType="Button">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MoreBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MoreBorder"
                                        Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogSearchClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearBackground"
                                        Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogKpiProductsStyle" TargetType="Button" BasedOn="{StaticResource CatalogKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="#3B82F6"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CatalogKpiLowStockStyle" TargetType="Button" BasedOn="{StaticResource CatalogKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="#F59E0B"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CatalogKpiNoStockStyle" TargetType="Button" BasedOn="{StaticResource CatalogKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="#EF4444"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CatalogKpiExpiryStyle" TargetType="Button" BasedOn="{StaticResource CatalogKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource PurpleSoftBrush}"/><Setter Property="BorderBrush" Value="#A855F7"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="CatalogActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource KontaxBaseButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CatalogEditButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CatalogActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                    <Setter Property="BorderBrush" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#64748B"/>
                    <Setter Property="BorderBrush" Value="#64748B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatalogDeactivateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CatalogActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatalogActivateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CatalogActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatalogPageButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
        </Style>

        <Style x:Key="CatalogLoadingBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>
                            <Border x:Name="LoadingIndicator"
                                    Width="190"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    Opacity="0.95">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-210"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LoadingIndicator"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-210" To="2400"
                                                             Duration="0:0:1.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="13"
                        Background="{DynamicResource PrimaryDarkBrush}"
                        Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                             Width="24" Height="24"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Productos" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Gestiona productos, presentaciones, precios y control de inventario"
                               Margin="0,3,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NuevoProductoCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="19" Height="19"/>
                    <TextBlock Text="Nuevo producto" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource CatalogKpiProductsStyle}"
                    Tag="{Binding EsKpiProductos}"
                    ToolTip="Mostrar todos los productos"
                    Command="{Binding SeleccionarKpiCommand}"
                    CommandParameter="{x:Static productModels:ProductoCatalogoKpi.Todos}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#3B82F6">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalProductos}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="PRODUCTOS" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource CatalogKpiLowStockStyle}"
                    Tag="{Binding EsKpiStockBajo}"
                    ToolTip="Mostrar productos con stock bajo"
                    Command="{Binding SeleccionarKpiCommand}"
                    CommandParameter="{x:Static productModels:ProductoCatalogoKpi.StockBajo}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#F59E0B">
                        <materialDesign:PackIcon Kind="PackageVariantClosedMinus" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalStockBajo}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="STOCK BAJO" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource CatalogKpiNoStockStyle}"
                    Tag="{Binding EsKpiSinStock}"
                    ToolTip="Mostrar productos sin stock"
                    Command="{Binding SeleccionarKpiCommand}"
                    CommandParameter="{x:Static productModels:ProductoCatalogoKpi.SinStock}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#EF4444">
                        <materialDesign:PackIcon Kind="PackageVariantRemove" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalSinStock}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="SIN STOCK" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource CatalogKpiExpiryStyle}"
                    Tag="{Binding EsKpiPorCaducar}"
                    ToolTip="Mostrar productos por caducar"
                    Command="{Binding SeleccionarKpiCommand}"
                    CommandParameter="{x:Static productModels:ProductoCatalogoKpi.PorCaducar}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="#A855F7">
                        <materialDesign:PackIcon Kind="CalendarAlert" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPorCaducar}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="POR CADUCAR" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <Border Height="46" Background="{DynamicResource InputSecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19"
                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="CatalogSearchInput" BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource BrandProBrush}"
                                     Padding="0,0,38,0"
                                     VerticalContentAlignment="Center" FontSize="13"
                                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Buscar por nombre, código, modelo, marca o código de barras..."
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CatalogSearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Panel.ZIndex="2"
                                    Style="{StaticResource CatalogSearchClearButtonStyle}"
                                    Command="{Binding LimpiarBusquedaCommand}"
                                    ToolTip="Limpiar búsqueda"
                                    Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="17" Height="17"
                                                         Foreground="{Binding Foreground,
                                                             RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <ComboBox Grid.Column="2" Width="150"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding EstadosDisponibles}"
                          DisplayMemberPath="Texto" SelectedValuePath="Valor"
                          Style="{StaticResource ModernComboBoxStyle}"
                          SelectedValue="{Binding EstadoSeleccionado}"/>
                <Button Grid.Column="4" Width="46" Height="46"
                        VerticalAlignment="Center"
                        Style="{StaticResource RefreshButtonStyle}"
                        Command="{Binding RecargarCommand}" ToolTip="Actualizar productos">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"
                                             Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="{DynamicResource TableBackgroundBrush}"
                CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/><RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Margin="12,2"
                             Style="{StaticResource CatalogLoadingBarStyle}"
                             ToolTip="Cargando productos..."
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Productos}"
                          Style="{StaticResource KontaxDataGridStyle}"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                           CanUserAddRows="False" CanUserDeleteRows="False"
                           BorderThickness="0" HeadersVisibility="Column"
                            MinRowHeight="92" ColumnHeaderHeight="46"
                           ColumnHeaderStyle="{StaticResource CatalogColumnHeaderStyle}"
                           SelectionMode="Single" SelectionUnit="FullRow">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="5*" MinWidth="430">
                            <DataGridTemplateColumn.Header><Button Style="{StaticResource CatalogSortHeaderStyle}" Command="{Binding DataContext.OrdenarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static productModels:ProductoCatalogoOrden.Producto}"><StackPanel Orientation="Horizontal"><TextBlock Text="PRODUCTO"/><TextBlock Text="{Binding DataContext.IndicadorProducto, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10"
                                                ToolTip="{Binding ControlVisual}"
                                                VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ControlVisual}" Value="LOTE"><Setter Property="Background" Value="#0F766E"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ControlVisual}" Value="SERIE"><Setter Property="Background" Value="#4F46E5"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ControlVisual}" Value="LOTE Y SERIE"><Setter Property="Background" Value="#7E22CE"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ControlVisual}" Value="SERVICIO"><Setter Property="Background" Value="#475569"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <materialDesign:PackIcon Width="21" Height="21"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="PackageVariant"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ControlVisual}" Value="LOTE"><Setter Property="Kind" Value="ArchiveOutline"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ControlVisual}" Value="SERIE"><Setter Property="Kind" Value="Barcode"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ControlVisual}" Value="LOTE Y SERIE"><Setter Property="Kind" Value="PackageVariantClosedCheck"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding ControlVisual}" Value="SERVICIO"><Setter Property="Kind" Value="OfficeBuildingCog"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource KontaxCatalogPrimaryTextStyle}"
                                                       ToolTip="{Binding NombreConMarca}">
                                                <Run Text="{Binding Nombre, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Marca, Mode=OneWay}"/>
                                            </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                    ToolTip="{Binding CategoriaModeloTexto}"
                                                    Visibility="{Binding CategoriaModeloTexto, Converter={StaticResource StringToVisibilityConverter}}">
                                            <Border Padding="6,2" CornerRadius="6"
                                                    Margin="0,0,6,0"
                                                    Background="#475569"
                                                    Visibility="{Binding TieneCategoria, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ShapeOutline"
                                                                             Width="11" Height="11"
                                                                             Margin="0,0,4,0"
                                                                             Foreground="White"/>
                                                    <TextBlock Text="{Binding Categoria}"
                                                               MaxWidth="135"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="·" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding MostrarSeparadorCategoriaModelo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Modelo}"
                                                       MaxWidth="210"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding TieneModelo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{Binding PresentacionesDetalleVisibles}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Padding="7,3" Margin="0,0,5,0" CornerRadius="8"
                                                                    ToolTip="{Binding Etiqueta}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#2563EB"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EsBase}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Etiqueta}" Foreground="White"
                                                                           FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="·" Margin="0,0,5,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       Visibility="{Binding MostrarSeparador, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="MorePresentationsButton" Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    Style="{StaticResource CatalogMorePresentationsStyle}"
                                                    Content="{Binding TextoPresentacionesAdicionales}"
                                                    Command="{Binding DataContext.AlternarPresentacionesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding PresentacionesRestantesTexto}"
                                                    Visibility="{Binding TienePresentacionesAdicionales, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Popup PlacementTarget="{Binding ElementName=MorePresentationsButton}"
                                                   Placement="Bottom"
                                                   HorizontalOffset="-8" VerticalOffset="4"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade"
                                                   StaysOpen="False"
                                                   IsOpen="{Binding IsPresentacionesPopupOpen, Mode=TwoWay}">
                                                <Border MinWidth="210" MaxWidth="320"
                                                        Padding="14,12"
                                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.20"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="PRESENTACIONES" Margin="0,0,0,8"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <ItemsControl ItemsSource="{Binding PresentacionesDetalleRestantes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                        <Border Padding="8,4" CornerRadius="8" Background="#2563EB">
                                                                            <TextBlock Text="{Binding Etiqueta}" FontSize="10"
                                                                                       FontWeight="Bold" Foreground="White"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="112"
                                                HeaderStyle="{StaticResource CatalogCenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.Header><Button Style="{StaticResource CatalogCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static productModels:ProductoCatalogoOrden.Stock}"><StackPanel Orientation="Horizontal"><TextBlock Text="STOCK"/><TextBlock Text="{Binding DataContext.IndicadorStock, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StockDisponible, StringFormat={}{0:0.###}}"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding TieneStockBajo}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding SinStock}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerButtonBackgroundBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding MostrarStockBajo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                                     Margin="0,0,3,0"
                                                                     Foreground="{DynamicResource WarningTextBrush}"/>
                                            <TextBlock Text="STOCK BAJO" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="SIN STOCK" Margin="0,3,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerButtonBackgroundBrush}"
                                                   Visibility="{Binding SinStock, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding MostrarPorCaducar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                                                     Margin="0,0,3,0"
                                                                     Foreground="{DynamicResource WarningTextBrush}"/>
                                            <TextBlock Text="{Binding CantidadPorCaducar, StringFormat={}{0:0.###} POR CADUCAR}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="120"
                                                HeaderStyle="{StaticResource CatalogCenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.Header><Button Style="{StaticResource CatalogCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static productModels:ProductoCatalogoOrden.CostoPromedio}"><StackPanel Orientation="Horizontal"><TextBlock Text="COSTO PROM."/><TextBlock Text="{Binding DataContext.IndicadorCosto, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CostoPromedio, StringFormat={}{0:C2}, ConverterCulture=es-EC}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="185">
                            <DataGridTemplateColumn.Header><Button Style="{StaticResource CatalogSortHeaderStyle}" Command="{Binding DataContext.OrdenarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static productModels:ProductoCatalogoOrden.PrecioBase}"><StackPanel Orientation="Horizontal"><TextBlock Text="PRECIOS"/><TextBlock Text="{Binding DataContext.IndicadorPrecio, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Padding="6,2" CornerRadius="6"
                                                        Margin="0,0,6,0"
                                                        Background="#16A34A"
                                                        ToolTip="Presentación base">
                                                    <TextBlock Text="{Binding PrecioPresentacionPrincipal.Nombre}"
                                                               Foreground="White" FontSize="8"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <Border Width="20" Height="18" CornerRadius="6"
                                                        Background="#2563EB"
                                                        ToolTip="{Binding PrecioPrincipalFinal.ListaNombre}">
                                                    <TextBlock Text="{Binding PrecioPrincipalFinal.ClasificacionPrecio}"
                                                               Foreground="White" FontSize="8"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                             <TextBlock Margin="0,3,0,0" FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding PrecioPrincipalFinal.PrecioFinal, StringFormat={}{0:C2}, ConverterCulture=es-EC}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PrecioPrincipalFinal.PrecioFinal}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="SIN PRECIO"/>
                                                                <Setter Property="FontSize" Value="9"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CondicionTributaria}"
                                                       Margin="0,2,0,0" FontSize="8"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                         <ToggleButton x:Name="ShowPricesButton" Grid.Column="1"
                                                      Width="30" Height="30" Margin="5,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Ver precios por presentación y lista"
                                                      Background="#0891B2" BorderThickness="0"
                                                      Cursor="Hand">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="#0891B2"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="ButtonSurface"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="9">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonSurface" Property="Background" Value="#0E7490"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ButtonSurface" Property="Background" Value="#155E75"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                             <materialDesign:PackIcon Kind="TagMultipleOutline"
                                                                      Width="17" Height="17"
                                                                      Foreground="White"/>
                                         </ToggleButton>
                                        <Popup Grid.ColumnSpan="2"
                                               Placement="Bottom"
                                               PlacementTarget="{Binding ElementName=ShowPricesButton}"
                                               IsOpen="{Binding IsChecked, ElementName=ShowPricesButton, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Width="440" MaxHeight="430" Margin="0,5,0,0"
                                                    Padding="14" CornerRadius="12"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.22"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,10">
                                                        <Border Width="32" Height="32" CornerRadius="9"
                                                                Background="{DynamicResource PrimaryDarkBrush}"
                                                                DockPanel.Dock="Left" Margin="0,0,9,0">
                                                            <materialDesign:PackIcon Kind="TagMultipleOutline"
                                                                                     Width="17" Height="17"
                                                                                     Foreground="White"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="PRECIOS DE VENTA" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="Valores finales con impuestos incluidos"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ScrollViewer MaxHeight="345"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding PreciosPorPresentacion}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,8" Padding="10"
                                                                            CornerRadius="10"
                                                                            Background="{DynamicResource BackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="115"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Nombre}"
                                                                                           TextWrapping="Wrap"
                                                                                           FontSize="10" FontWeight="Bold"
                                                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                                <TextBlock Text="{Binding EtiquetaFactor, StringFormat=Factor ×{0}}"
                                                                                           Margin="0,3,0,0" FontSize="8"
                                                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                            </StackPanel>
                                                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Precios}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Width="64" Margin="3,1"
                                                                                                    HorizontalAlignment="Center">
                                                                                            <Border Width="22" Height="20" CornerRadius="6"
                                                                                                    HorizontalAlignment="Center"
                                                                                                    ToolTip="{Binding ListaNombre}">
                                                                                                <Border.Style>
                                                                                                    <Style TargetType="Border">
                                                                                                        <Setter Property="Background" Value="#2563EB"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding ClasificacionPrecio}" Value="B"><Setter Property="Background" Value="#16A34A"/></DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding ClasificacionPrecio}" Value="C"><Setter Property="Background" Value="#9333EA"/></DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding ClasificacionPrecio}" Value="D"><Setter Property="Background" Value="#D97706"/></DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding ClasificacionPrecio}" Value="E"><Setter Property="Background" Value="#DB2777"/></DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock Text="{Binding ClasificacionPrecio}"
                                                                                                           Foreground="White" FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <TextBlock Margin="0,3,0,0"
                                                                                                       TextAlignment="Center" FontSize="9"
                                                                                                       FontWeight="Bold">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Text" Value="{Binding PrecioFinal, StringFormat={}{0:C2}, ConverterCulture=es-EC}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding PrecioFinal}" Value="{x:Null}">
                                                                                                                <Setter Property="Text" Value="—"/>
                                                                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="98"
                                                HeaderStyle="{StaticResource CatalogCenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.Header><Button Style="{StaticResource CatalogCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static productModels:ProductoCatalogoOrden.Estado}"><StackPanel Orientation="Horizontal"><TextBlock Text="ESTADO"/><TextBlock Text="{Binding DataContext.IndicadorEstado, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#4B5563"/><Style.Triggers><DataTrigger Binding="{Binding Activo}" Value="True"><Setter Property="Background" Value="#16A34A"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontSize="10" FontWeight="Bold" TextAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="104">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CatalogEditButtonStyle}" ToolTip="Editar producto"
                                                Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17" Foreground="White"/>
                                        </Button>
                                        <Button Style="{StaticResource CatalogDeactivateButtonStyle}" Margin="6,0,0,0" ToolTip="Inactivar producto"
                                                Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding Activo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Power" Width="17" Height="17" Foreground="White"/>
                                        </Button>
                                        <Button Style="{StaticResource CatalogActivateButtonStyle}" Margin="6,0,0,0" ToolTip="Activar producto"
                                                Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                Visibility="{Binding Activo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Power" Width="17" Height="17" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding MostrarEstadoVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Style="{StaticResource KontaxEmptyListIconStyle}"/>
                    <TextBlock Text="No se encontraron registros" Style="{StaticResource KontaxEmptyListTextStyle}"/>
                    <Button Content="Limpiar filtros" Margin="0,14,0,0"
                            Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding LimpiarFiltrosCommand}"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="14,10" MinHeight="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TextoPaginacion}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="POR PÁGINA" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                        <ComboBox Width="82" ItemsSource="{Binding TamanosPagina}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedItem="{Binding TamanoPagina}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CatalogPageButtonStyle}" Command="{Binding PaginaAnteriorCommand}" IsEnabled="{Binding PuedeIrPaginaAnterior}" ToolTip="Página anterior"><materialDesign:PackIcon Kind="ChevronLeft" Width="17" Height="17"/></Button>
                        <ItemsControl ItemsSource="{Binding PaginasVisibles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Texto}" Margin="4,0,0,0" Command="{Binding DataContext.IrPaginaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CatalogPageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding EsActual}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding EsSeparador}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource CatalogPageButtonStyle}" Margin="4,0,0,0" Command="{Binding PaginaSiguienteCommand}" IsEnabled="{Binding PuedeIrPaginaSiguiente}" ToolTip="Página siguiente"><materialDesign:PackIcon Kind="ChevronRight" Width="17" Height="17"/></Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
