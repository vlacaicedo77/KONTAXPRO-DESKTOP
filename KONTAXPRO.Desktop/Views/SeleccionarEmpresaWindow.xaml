<Window x:Class="KONTAXPRO.Desktop.Views.SeleccionarEmpresaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Seleccionar empresa"
        Icon="/KONTAXPRO.Desktop;component/Assets/kontaxpro.ico"
        Width="780"
        Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- =====================================================
             TARJETA DE EMPRESA
             Exclusiva de esta ventana
             ===================================================== -->

        <Style x:Key="EmpresaListItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="Margin"
                    Value="0,0,0,12" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="CardBorder"
                                Background="{DynamicResource SecondarySurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">

                            <ContentPresenter />

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER NORMAL -->
                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsMouseOver"
                                               Value="True" />

                                    <Condition Property="IsSelected"
                                               Value="False" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BrandProBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource BrandProBrush}" />

                            </MultiTrigger>


                            <!-- SELECCIONADO -->
                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectionBackgroundBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SelectionBorderBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource SelectionForegroundBrush}" />

                            </Trigger>


                            <!-- HOVER SOBRE SELECCIONADO -->
                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsMouseOver"
                                               Value="True" />

                                    <Condition Property="IsSelected"
                                               Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectionHoverBackgroundBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource SelectionBorderBrush}" />

                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />

                            </MultiTrigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         CONTENEDOR PRINCIPAL
         ========================================================= -->

    <Border Margin="24"
            CornerRadius="24"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect BlurRadius="34"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.30" />

        </Border.Effect>


        <Grid ClipToBounds="True">


            <!-- =================================================
                 DETALLE DE IDENTIDAD KONTAXPRO
                 ================================================= -->

            <Border Height="6"
                    Margin="12,0,12,0"
                    VerticalAlignment="Top"
                    CornerRadius="8,8,0,0">

                <Border.Background>

                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,0">

                        <GradientStop Color="#16A34A"
                                      Offset="0" />

                        <GradientStop Color="#FACC15"
                                      Offset="0.58" />

                        <GradientStop Color="#DC2626"
                                      Offset="1" />

                    </LinearGradientBrush>

                </Border.Background>

            </Border>


            <!-- =================================================
                 BOTÓN CERRAR
                 ================================================= -->

            <Button Width="38"
                    Height="38"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Style="{DynamicResource DangerButtonStyle}"
                    ToolTip="Cerrar"
                    Click="Cerrar_Click">

                <materialDesign:PackIcon Kind="Close"
                                         Width="18"
                                         Height="18" />

            </Button>


            <!-- =================================================
                 CONTENIDO
                 ================================================= -->

            <Grid Margin="44,42,44,36">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>


                <!-- =================================================
                     ENCABEZADO
                     ================================================= -->

                <StackPanel Grid.Row="0">

                    <StackPanel Orientation="Horizontal">

                        <!-- Icono -->
                        <Border Width="54"
                                Height="54"
                                CornerRadius="15"
                                Background="{DynamicResource PrimaryDarkBrush}"
                                Margin="0,0,16,0">

                            <materialDesign:PackIcon Kind="OfficeBuilding"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />

                        </Border>


                        <!-- Títulos -->
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Seleccionar empresa"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Text="ESPACIO DE TRABAJO"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrandProBrush}" />

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- =================================================
                     INSTRUCCIÓN
                     ================================================= -->

                <TextBlock Grid.Row="1"
                           Text="Selecciona la empresa con la que deseas trabajar."
                           Margin="0,22,0,18"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />


                <!-- =================================================
                     EMPRESAS
                     ================================================= -->

                <ListBox Grid.Row="2"
                         AutomationProperties.Name="Empresas disponibles"
                         ItemsSource="{Binding Empresas}"
                         SelectedItem="{Binding EmpresaActual}"
                         ItemContainerStyle="{StaticResource EmpresaListItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="62" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>


                                <!-- =================================================
             ICONO
             ================================================= -->

                                <Border Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                    <materialDesign:PackIcon Kind="OfficeBuildingOutline"
                                                             Width="22"
                                                             Height="22"
                                                             Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />

                                </Border>


                                <!-- =================================================
             INFORMACIÓN
             ================================================= -->

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">

                                    <TextBlock Text="{Binding NombreComercial}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               TextTrimming="CharacterEllipsis" />


                                    <TextBlock Text="{Binding NumeroIdentificacion}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />


                                    <TextBlock Text="{Binding RazonSocial}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               TextTrimming="CharacterEllipsis" />

                                </StackPanel>


                                <!-- =================================================
                                 CHEVRON
                                 ================================================= -->

                                <Border Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="10"
                                        Background="Transparent"
                                        VerticalAlignment="Center">

                                    <materialDesign:PackIcon Kind="ChevronRight"
                                                             Width="22"
                                                             Height="22"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                                </Border>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>


                <!-- =================================================
                     MENSAJE / ERROR
                     ================================================= -->

                <TextBlock Grid.Row="3"
                           Text="{Binding Mensaje}"
                           Margin="0,14,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerButtonBackgroundBrush}" />


                <!-- =================================================
                     CONTINUAR
                     ================================================= -->

                <Button Grid.Row="4"
                        Width="180"
                        Height="46"
                        AutomationProperties.Name="Continuar"
                        Command="{Binding SeleccionarEmpresaCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                    <StackPanel Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="ArrowRightCircleOutline"
                                                 Width="19"
                                                 Height="19"
                                                 Margin="0,0,9,0" />

                        <TextBlock Text="Continuar"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>
