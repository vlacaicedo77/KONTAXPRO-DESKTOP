<Window x:Class="KONTAXPRO.Desktop.Views.SeleccionarEstablecimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cambiar establecimiento" Width="760" Height="590"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="EstablishmentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14"
                                Background="{DynamicResource SecondarySurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryDarkBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="22" Padding="28" CornerRadius="22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="14"
                        Background="{DynamicResource PrimaryDarkBrush}">
                    <materialDesign:PackIcon Kind="Store" Width="27" Height="27"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="CONTEXTO OPERATIVO" FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrandProBrush}"/>
                    <TextBlock Text="Cambiar establecimiento" FontSize="23"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding Empresa}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="3" Width="38" Height="38" Padding="0"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="Cerrar" Click="Cerrar_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <ListBox Grid.Row="2" ItemsSource="{Binding Establecimientos}"
                     SelectedItem="{Binding EstablecimientoActual}"
                     ItemContainerStyle="{StaticResource EstablishmentItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource PrimaryDarkBrush}">
                                <TextBlock Text="{Binding Codigo}" Foreground="White"
                                           FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreComercial}" FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <materialDesign:PackIcon Kind="MapMarker" Width="14"
                                                             Height="14"
                                                             Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding Direccion}" Margin="5,0,0,0"
                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" Padding="9,5" CornerRadius="8"
                                    Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EtiquetaTipo}" FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Margin="0,8"
                       TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource DangerForegroundBrush}"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"
                        Style="{StaticResource NeutralButtonStyle}"/>
                <Button Command="{Binding SeleccionarCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanInverterConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18"
                                                 Foreground="White"/>
                        <TextBlock Text="Trabajar aquí" Margin="8,0,0,0"
                                   Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ProgressBar Grid.RowSpan="5" IsIndeterminate="True" Height="4"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Foreground="{DynamicResource PrimaryDarkBrush}"/>
        </Grid>
    </Border>
</Window>
