<UserControl x:Class="KONTAXPRO.Desktop.Views.Proveedores.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:KONTAXPRO.Desktop.Behaviors"
             xmlns:supplierModels="clr-namespace:KONTAXPRO.Application.Models.Proveedores;assembly=KONTAXPRO.Application"
             xmlns:supplierViews="clr-namespace:KONTAXPRO.Desktop.Views.Proveedores">
    <UserControl.Resources>
        <Style x:Key="SupplierColumnHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource KontaxDataGridColumnHeaderStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" Width="7" HorizontalAlignment="Left"
                                   Cursor="SizeWE" Background="Transparent" Opacity="0"/>
                            <Thumb x:Name="PART_RightHeaderGripper" Width="7" HorizontalAlignment="Right"
                                   Cursor="SizeWE" Background="Transparent" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource TableAlternateRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SupplierCenteredColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource SupplierColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SupplierKpiButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupplierKpiTotalStyle" TargetType="Button"
               BasedOn="{StaticResource SupplierKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="#3B82F6"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierKpiVerificationStyle" TargetType="Button"
               BasedOn="{StaticResource SupplierKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="#F59E0B"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierKpiEmailStyle" TargetType="Button"
               BasedOn="{StaticResource SupplierKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="#EF4444"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierKpiContactStyle" TargetType="Button"
               BasedOn="{StaticResource SupplierKpiButtonStyle}">
            <Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource PurpleSoftBrush}"/><Setter Property="BorderBrush" Value="#A855F7"/></Trigger></Style.Triggers>
        </Style>

        <Style x:Key="SupplierSearchClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBackground" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClearBackground" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupplierRefreshButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupplierActionButtonStyle" TargetType="Button" BasedOn="{StaticResource KontaxBaseButtonStyle}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SupplierEditButtonStyle" TargetType="Button" BasedOn="{StaticResource SupplierActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierDeactivateButtonStyle" TargetType="Button" BasedOn="{StaticResource SupplierActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBackgroundBrush}"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerButtonHoverBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierActivateButtonStyle" TargetType="Button" BasedOn="{StaticResource SupplierActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupplierPageButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="34"/><Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/>
        </Style>
        <Style x:Key="SupplierLoadingBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsIndeterminate" Value="True"/>
        </Style>
        <Style x:Key="TrimmedSupplierTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="CompactSupplierTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TrimmedSupplierTextStyle}">
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="Truck" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Proveedores" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Consulta y administra el catálogo global de proveedores"
                                   Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NuevoProveedorCommand}" ToolTip="Registrar un nuevo proveedor">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="19" Height="19"/>
                        <TextBlock Text="Nuevo proveedor" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SupplierKpiTotalStyle}" Tag="{Binding EsKpiActivos}"
                        ToolTip="Mostrar proveedores activos" Command="{Binding SeleccionarKpiCommand}"
                        CommandParameter="{x:Static supplierModels:ProveedorCatalogoKpi.Activos}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#3B82F6"><materialDesign:PackIcon Kind="Truck" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding TotalActivos}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="PROVEEDORES ACTIVOS" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SupplierKpiVerificationStyle}" Tag="{Binding EsKpiPendientes}"
                        ToolTip="Mostrar RUC pendientes de verificación oficial" Command="{Binding SeleccionarKpiCommand}"
                        CommandParameter="{x:Static supplierModels:ProveedorCatalogoKpi.PendientesVerificar}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#F59E0B"><materialDesign:PackIcon Kind="ShieldAlert" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding TotalPendientesVerificar}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="PENDIENTES DE VERIFICAR" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SupplierKpiEmailStyle}" Tag="{Binding EsKpiSinCorreo}"
                        ToolTip="Mostrar proveedores sin correo electrónico" Command="{Binding SeleccionarKpiCommand}"
                        CommandParameter="{x:Static supplierModels:ProveedorCatalogoKpi.SinCorreo}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#EF4444"><materialDesign:PackIcon Kind="EmailOffOutline" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding TotalSinCorreo}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="SIN CORREO" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource SupplierKpiContactStyle}" Tag="{Binding EsKpiSinContacto}"
                        ToolTip="Mostrar proveedores sin correo ni teléfono/WhatsApp" Command="{Binding SeleccionarKpiCommand}"
                        CommandParameter="{x:Static supplierModels:ProveedorCatalogoKpi.SinContactoDigital}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#A855F7"><materialDesign:PackIcon Kind="CardAccountPhoneOutline" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding TotalSinContactoDigital}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="SIN CONTACTO DIGITAL" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="145"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="46" Background="{DynamicResource InputSecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SupplierSearchInput" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource BrandProBrush}" Padding="0,0,38,0"
                                         VerticalContentAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Buscar por RUC, razón social, correo o teléfono..." IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SupplierSearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Panel.ZIndex="2"
                                        Style="{StaticResource SupplierSearchClearButtonStyle}" Command="{Binding LimpiarBusquedaCommand}"
                                        ToolTip="Limpiar búsqueda" Visibility="{Binding TextoBusqueda, Converter={StaticResource StringToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="Close" Width="17" Height="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="2" Width="145" VerticalAlignment="Center" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Verificaciones}" SelectedItem="{Binding VerificacionSeleccionada}" DisplayMemberPath="Nombre" ToolTip="Filtrar por verificación"/>
                    <ComboBox Grid.Column="4" Width="130" VerticalAlignment="Center" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}" DisplayMemberPath="Nombre" ToolTip="Filtrar por estado"/>
                    <Button Grid.Column="6" Style="{StaticResource SupplierRefreshButtonStyle}" Command="{Binding RecargarCommand}" ToolTip="Actualizar proveedores">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="6" Background="{DynamicResource TableBackgroundBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Margin="12,2" Style="{StaticResource SupplierLoadingBarStyle}"
                                 ToolTip="Cargando proveedores..." Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Proveedores}" Style="{StaticResource KontaxDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="False" BorderThickness="0"
                              HeadersVisibility="Column" RowHeight="58" ColumnHeaderHeight="42"
                              ColumnHeaderStyle="{StaticResource SupplierColumnHeaderStyle}" SelectionMode="Single"
                              SelectionUnit="FullRow" behaviors:ResponsiveDataGridBehavior.IsEnabled="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="150" MinWidth="140" behaviors:ResponsiveDataGridBehavior.Priority="Always">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxSortHeaderStyle}" Command="{Binding DataContext.OrdenarProveedoresCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static supplierModels:ProveedorCatalogoOrden.Ruc}"><StackPanel Orientation="Horizontal"><TextBlock Text="RUC"/><TextBlock Text="{Binding DataContext.IndicadorRuc, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Grid ToolTip="{Binding FuenteVerificacion}"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="21" Height="21" VerticalAlignment="Center" Foreground="#2563EB">
                                            <materialDesign:PackIcon.Style><Style TargetType="materialDesign:PackIcon"><Setter Property="Kind" Value="ShieldAlert"/><Style.Triggers><DataTrigger Binding="{Binding Verificado}" Value="True"><Setter Property="Kind" Value="ShieldCheck"/><Setter Property="Foreground" Value="#16A34A"/></DataTrigger></Style.Triggers></Style></materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Grid.Column="1" Text="{Binding Ruc}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="1.4*" MinWidth="230" behaviors:ResponsiveDataGridBehavior.Priority="Always">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxSortHeaderStyle}" Command="{Binding DataContext.OrdenarProveedoresCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static supplierModels:ProveedorCatalogoOrden.RazonSocial}"><StackPanel Orientation="Horizontal"><TextBlock Text="RAZÓN SOCIAL"/><TextBlock Text="{Binding DataContext.IndicadorRazonSocial, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RazonSocial}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" ToolTip="{Binding RazonSocial}" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DIRECCIÓN" Binding="{Binding Direccion}" Width="1.1*" MinWidth="150" ElementStyle="{StaticResource CompactSupplierTextStyle}" behaviors:ResponsiveDataGridBehavior.Priority="Wide"/>
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="105" ElementStyle="{StaticResource CompactSupplierTextStyle}" behaviors:ResponsiveDataGridBehavior.Priority="Medium"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Correo}" Width="1.1*" MinWidth="160" ElementStyle="{StaticResource TrimmedSupplierTextStyle}" behaviors:ResponsiveDataGridBehavior.Priority="Wide"/>
                            <DataGridTemplateColumn Width="112" MinWidth="104" HeaderStyle="{StaticResource SupplierCenteredColumnHeaderStyle}" behaviors:ResponsiveDataGridBehavior.Priority="Always">
                                <DataGridTemplateColumn.Header><Button Style="{StaticResource KontaxCenteredSortHeaderStyle}" Command="{Binding DataContext.OrdenarProveedoresCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{x:Static supplierModels:ProveedorCatalogoOrden.Estado}"><StackPanel Orientation="Horizontal"><TextBlock Text="ESTADO"/><TextBlock Text="{Binding DataContext.IndicadorEstado, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></Button></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#4B5563"/><Style.Triggers><DataTrigger Binding="{Binding Activo}" Value="True"><Setter Property="Background" Value="#16A34A"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACCIONES" Width="86" behaviors:ResponsiveDataGridBehavior.Priority="Always">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SupplierEditButtonStyle}" ToolTip="Editar proveedor" Command="{Binding DataContext.EditarProveedorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"><materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17" Foreground="White"/></Button>
                                    <Button Style="{StaticResource SupplierDeactivateButtonStyle}" Margin="6,0,0,0" ToolTip="Inactivar proveedor" Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding Activo, Converter={StaticResource BooleanToVisibilityConverter}}"><materialDesign:PackIcon Kind="Power" Width="17" Height="17" Foreground="White"/></Button>
                                    <Button Style="{StaticResource SupplierActivateButtonStyle}" Margin="6,0,0,0" ToolTip="Activar proveedor" Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding Activo, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><materialDesign:PackIcon Kind="Power" Width="17" Height="17" Foreground="White"/></Button>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding MostrarEstadoVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Style="{StaticResource KontaxEmptyListIconStyle}"/>
                        <TextBlock Text="No se encontraron registros" Style="{StaticResource KontaxEmptyListTextStyle}"/>
                        <Button Content="Limpiar filtros" Margin="0,14,0,0" Style="{StaticResource NeutralButtonStyle}" Command="{Binding LimpiarFiltrosCommand}"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="14,10" MinHeight="38">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TextoPaginacion}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="POR PÁGINA" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><ComboBox Width="82" ItemsSource="{Binding TamanosPagina}" Style="{StaticResource ModernComboBoxStyle}" SelectedItem="{Binding TamanoPagina}"/></StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SupplierPageButtonStyle}" Command="{Binding PaginaAnteriorCommand}" IsEnabled="{Binding PuedeIrAnterior}" ToolTip="Página anterior"><materialDesign:PackIcon Kind="ChevronLeft" Width="17" Height="17"/></Button>
                            <Button Content="{Binding PaginaActual}" Margin="4,0,0,0" IsHitTestVisible="False" Focusable="False"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SupplierPageButtonStyle}"><Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/></Style></Button.Style></Button>
                            <Button Style="{StaticResource SupplierPageButtonStyle}" Margin="4,0,0,0" Command="{Binding PaginaSiguienteCommand}" IsEnabled="{Binding PuedeIrSiguiente}" ToolTip="Página siguiente"><materialDesign:PackIcon Kind="ChevronRight" Width="17" Height="17"/></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Margin="18" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Visibility="{Binding IsSupplierFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.32"/></Border.Effect>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupplierFormOpen}" Value="True">
                                <Setter Property="Content" Value="{Binding ProveedorForm}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate><supplierViews:ProveedorFormView/></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
