<Window x:Class="KONTAXPRO.Desktop.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding DialogTitle}"
        Width="620"
        Height="360"
        MinWidth="500"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid Background="{DynamicResource OverlayBrush}">
        <Border Style="{StaticResource KontaxDialogCardStyle}"
                MinWidth="430"
                MaxWidth="560"
                MaxHeight="520"
                Margin="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource KontaxDialogIconContainerStyle}"
                            Background="{Binding AccentSoftBrush}"
                            Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                 Width="27"
                                                 Height="27"
                                                 Foreground="{Binding AccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TypeLabel}"
                                   Margin="0,4,0,0"
                                   Foreground="{Binding AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource KontaxDialogCloseButtonStyle}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip="Cerrar"
                            Click="CloseButton_Click">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="White"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="68,22,0,0"
                              MaxHeight="190"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Message}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="68,14,0,0"
                        Padding="12,10"
                        CornerRadius="9"
                        Background="{DynamicResource SecondarySurfaceBrush}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,26,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Width="172"
                            Style="{StaticResource NeutralButtonStyle}"
                            Margin="0,0,12,0"
                            IsCancel="True"
                            Visibility="{Binding HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="SecondaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="17"
                                                     Height="17"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SecondaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PrimaryButton"
                            Width="172"
                            Click="PrimaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check"
                                                     Width="17"
                                                     Height="17"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PrimaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
