<UserControl x:Class="KONTAXPRO.Desktop.Views.Tesoreria.OperacionSinSustentoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:KONTAXPRO.Desktop.Behaviors"
             xmlns:productViews="clr-namespace:KONTAXPRO.Desktop.Views.Products"
             MinWidth="880" MinHeight="620"
             Background="{DynamicResource ElevatedSurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>
        <Style x:Key="FieldHelpStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="1,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FormSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="FormFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OperationComboStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style x:Key="ChoiceButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource BrandProBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OperationChoiceButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}">
            <Setter Property="Tag" Value="{DynamicResource PrimaryDarkBrush}"/>
        </Style>
        <Style x:Key="SourceChoiceButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceButtonStyle}">
            <Setter Property="Tag" Value="#2563EB"/>
        </Style>
        <Style x:Key="LineCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="OperationInlineClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InlineClearBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InlineClearBorder" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InlineClearBorder" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ControlLotReferenceButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LotCard" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LotCard" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter TargetName="LotCard" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LotCard" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ControlStatusButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D97706"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlCard" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlCard" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlCard" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado fijo -->
        <Border Grid.Row="0" Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/><ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimaryDarkBrush}">
                    <materialDesign:PackIcon Kind="ReceiptTextRemoveOutline" Width="23" Height="23"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Registra una salida real sin sustento tributario"
                               Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="3" Padding="12,7" CornerRadius="10"
                        Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16"
                                                 Foreground="#D97706" Margin="0,0,7,0"/>
                        <TextBlock Text="NO DEDUCIBLE · SIN IVA CRÉDITO" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="5" Width="42" Height="42" Padding="0"
                        Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}"
                        ToolTip="Cerrar formulario">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido desplazable -->
        <ScrollViewer x:Name="MainFormScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,14,22,20">
                <!-- Datos principales compactos -->
                <Border Style="{StaticResource FormSectionStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,9,0">
                                <materialDesign:PackIcon Kind="TuneVariant" Width="17" Height="17" Foreground="{DynamicResource BrandProBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Datos de la operación" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Tipo, origen del dinero e información principal" Style="{StaticResource FieldHelpStyle}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.68*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="¿Qué ocurrió?"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="OperationTypeChoice" Command="{Binding SelectInventoryCommand}" Style="{StaticResource OperationChoiceButtonStyle}" IsChecked="{Binding IsInventory, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PackageVariantPlus" Width="17" Height="17"/><TextBlock Text="Inventario" Margin="6,0,0,0"/><materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Margin="7,0,0,0" Visibility="{Binding IsInventory, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="OperationTypeChoice" Command="{Binding SelectExpenseCommand}" Style="{StaticResource OperationChoiceButtonStyle}" IsChecked="{Binding IsExpense, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashMinus" Width="17" Height="17"/><TextBlock Text="Gasto" Margin="6,0,0,0"/><materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Margin="7,0,0,0" Visibility="{Binding IsExpense, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="¿De dónde salió el dinero?"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="SourceTypeChoice" Command="{Binding SelectCashCommand}" Style="{StaticResource SourceChoiceButtonStyle}" IsChecked="{Binding IsCash, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashRegister" Width="17" Height="17"/><TextBlock Text="Caja" Margin="6,0,0,0"/><materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Margin="7,0,0,0" Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="SourceTypeChoice" Command="{Binding SelectBankCommand}" Style="{StaticResource SourceChoiceButtonStyle}" IsChecked="{Binding IsBank, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Bank" Width="17" Height="17"/><TextBlock Text="Banco" Margin="6,0,0,0"/><materialDesign:PackIcon Kind="CheckCircle" Width="15" Height="15" Margin="7,0,0,0" Visibility="{Binding IsBank, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="Fecha"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <Border Style="{StaticResource FormFieldBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBox Text="{Binding OperationDate, Mode=TwoWay, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus}" Language="es-EC" ToolTip="DD/MM/AAAA" behaviors:DateInputBehavior.IsEnabled="True" Validation.ErrorTemplate="{x:Null}" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="dd/mm/aaaa"/><materialDesign:PackIcon Grid.Column="1" Kind="CalendarMonthOutline" Width="17" Height="17" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="Beneficiario / responsable"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <Border Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding Beneficiary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/></Border>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="Motivo"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <Border Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/></Border>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="{Binding SourceLabel, Mode=OneWay}"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding CashSessions}" SelectedItem="{Binding SelectedCashSession}" DisplayMemberPath="Nombre" Style="{StaticResource OperationComboStyle}" Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ComboBox ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" DisplayMemberPath="Nombre" Style="{StaticResource OperationComboStyle}" Visibility="{Binding IsBank, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="1,4,0,0" Visibility="{Binding HasAvailableSources, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13" Foreground="#D97706" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding SourceEmptyMessage, Mode=OneWay}" FontSize="9" Foreground="#D97706" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Detalle de gasto -->
                <Border Margin="0,12,0,0" Style="{StaticResource FormSectionStyle}"
                        Visibility="{Binding IsExpense, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,9,0">
                                    <materialDesign:PackIcon Kind="CashMinus" Width="19" Height="19" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Detalle del gasto" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Clasifica correctamente cada valor para conservar trazabilidad contable" Style="{StaticResource FieldHelpStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding AddExpenseLineCommand}" Style="{StaticResource AddButtonStyle}">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="17" Height="17"/><TextBlock Text="Agregar gasto" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="12,0,12,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CUENTA DE GASTO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="DESCRIPCIÓN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="4" Text="VALOR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ExpenseLines}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource LineCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.ExpenseAccounts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Account}" DisplayMemberPath="Nombre" Style="{StaticResource OperationComboStyle}"/>
                                        <Border Grid.Column="2" Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/></Border>
                                        <Border Grid.Column="4" Style="{StaticResource FormFieldBorderStyle}">
                                            <TextBox Text="{Binding Amount, StringFormat={}{0:0.00}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center"
                                                     behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="2"
                                                     behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/>
                                        </Border>
                                        <Button Grid.Column="5" Command="{Binding DataContext.RemoveExpenseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource DeleteButtonStyle}" ToolTip="Quitar línea">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Detalle de inventario -->
                <Border Margin="0,12,0,0" Style="{StaticResource FormSectionStyle}"
                        Visibility="{Binding IsInventory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PurpleSoftBrush}" Margin="0,0,9,0">
                                    <materialDesign:PackIcon Kind="Warehouse" Width="19" Height="19" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Productos e inventario" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="El ingreso físico se registra únicamente en una bodega no facturable" Style="{StaticResource FieldHelpStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"><Run Text="Bodega no facturable"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/></TextBlock>
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Nombre" Style="{StaticResource OperationComboStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Command="{Binding AddInventoryLineCommand}" Style="{StaticResource AddButtonStyle}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="17" Height="17"/><TextBlock Text="Agregar producto" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="12,0,12,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="155"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PRODUCTO / PRESENTACIÓN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="CANTIDAD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="COSTO TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="CONTROL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding InventoryLines}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource LineCardStyle}">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="155"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                            <Grid>
                                                <Border x:Name="ProductSearchField" Height="44" MinHeight="44" Style="{StaticResource FormFieldBorderStyle}"
                                                        Visibility="{Binding HasProduct, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBox x:Name="ProductSearchBox" Grid.Column="1"
                                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 CharacterCasing="Upper" Style="{StaticResource ModernTextBoxStyle}" Padding="2,0"
                                                                 materialDesign:HintAssist.Hint="Buscar producto"/>
                                                        <ProgressBar Grid.Column="2" Width="17" Height="17" IsIndeterminate="True"
                                                                     Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                         <materialDesign:PackIcon Grid.Column="2" Kind="AlertCircle" Width="17" Height="17"
                                                                                  Foreground="#D97706" ToolTip="Sin coincidencias: crea un producto nuevo"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding ProductSearchHasNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Button Grid.Column="3" Command="{Binding ClearProductCommand}"
                                                                Style="{StaticResource OperationInlineClearButtonStyle}"
                                                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                ToolTip="Limpiar producto y sus valores">
                                                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Foreground="#DC2626"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                    <Popup PlacementTarget="{Binding ElementName=ProductSearchField}" Placement="Bottom"
                                                           IsOpen="{Binding ShowSuggestions, Mode=TwoWay}" StaysOpen="False"
                                                           AllowsTransparency="True"
                                                           Width="{Binding ActualWidth, ElementName=ProductSearchField}">
                                                        <Border MaxHeight="300" Margin="0,4,0,0" Padding="6"
                                                                CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                                            <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Product, Mode=TwoWay}"
                                                                     MaxHeight="280" Background="Transparent" BorderThickness="0"
                                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                     ScrollViewer.CanContentScroll="True"
                                                                     VirtualizingPanel.IsVirtualizing="True"
                                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                                     VirtualizingPanel.ScrollUnit="Pixel">
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem">
                                                                        <Setter Property="Padding" Value="10,8"/>
                                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </Style>
                                                                </ListBox.ItemContainerStyle>
                                                                <ListBox.ItemTemplate><DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <Border Width="28" Height="28" CornerRadius="8" Background="#2563EB"
                                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="16" Height="16"
                                                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                         <StackPanel Grid.Column="1">
                                                                             <TextBlock Text="{Binding ProductoConMarca}" FontWeight="SemiBold"
                                                                                        Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                                             <TextBlock Text="{Binding PresentacionNombre}" Margin="0,2,0,0" FontSize="10"
                                                                                        Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                             <TextBlock Text="{Binding CostoPromedioDisplay}" Margin="0,3,0,0" FontSize="11" FontWeight="Bold"
                                                                                        Foreground="{DynamicResource BrandProBrush}"/>
                                                                         </StackPanel>
                                                                        <Border Grid.Column="2" Padding="8,4" Margin="10,0,0,0" CornerRadius="7"
                                                                                VerticalAlignment="Center">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#2563EB"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding EsPresentacionBase}" Value="True">
                                                                                            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding PresentationBadgeDisplay}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate></ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Border>
                                                    </Popup>
                                                <Border Height="44" MinHeight="44" Style="{StaticResource FormFieldBorderStyle}"
                                                        Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SelectionBorderBrush}"
                                                        Visibility="{Binding HasProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Foreground="{DynamicResource PrimaryDarkBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SearchText, Mode=OneWay}" IsReadOnly="True"
                                                                 CharacterCasing="Upper" Style="{StaticResource ModernTextBoxStyle}" Padding="2,0"/>
                                                        <Button Grid.Column="2" Command="{Binding ClearProductCommand}"
                                                                Style="{StaticResource OperationInlineClearButtonStyle}" ToolTip="Quitar producto relacionado">
                                                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Foreground="#DC2626"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <Button Grid.Column="2" Command="{Binding DataContext.CreateProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Width="30" Height="30" Padding="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                                                    Visibility="{Binding HasProduct, Converter={StaticResource InverseBooleanToVisibilityConverter}}" ToolTip="Crear producto nuevo">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White"/>
                                            </Button>
                                        </Grid>
                                        <Border Grid.Column="2" Style="{StaticResource FormFieldBorderStyle}">
                                                 <TextBox Text="{Binding Quantity, StringFormat={}{0:0.######}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center"
                                                          behaviors:FocusRequestBehavior.RequestToken="{Binding QuantityFocusRequest}"
                                                          behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="6"
                                                         behaviors:DecimalInputBehavior.TrimTrailingZeros="True" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True"
                                                         behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/>
                                        </Border>
                                         <Border Grid.Column="4" Style="{StaticResource FormFieldBorderStyle}">
                                                 <TextBox Text="{Binding TotalCost, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Center"
                                                          Language="en-US"
                                                          behaviors:FocusRequestBehavior.RequestToken="{Binding CostFocusRequest}"
                                                          behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="2"
                                                          behaviors:DecimalInputBehavior.TrimTrailingZeros="True"
                                                          behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/>
                                         </Border>
                                        <Button Grid.Column="6" Command="{Binding DataContext.ConfigureControlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource ControlStatusButtonStyle}"
                                                Tag="{Binding IsControlComplete}"
                                                Visibility="{Binding RequiresControl, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Configurar lotes y/o series">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PackageVariant" Width="17" Height="17" Foreground="White"/>
                                                <TextBlock Text="{Binding ControlSummary}" Margin="6,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="6" Padding="8,5" CornerRadius="8" Background="{DynamicResource SecondarySurfaceBrush}"
                                                Visibility="{Binding RequiresControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock Text="NORMAL" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Border>
                                         <Button Grid.Column="7" Command="{Binding DataContext.RemoveInventoryLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}" Style="{StaticResource DeleteButtonStyle}" ToolTip="Quitar producto">
                                             <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" Foreground="White"/>
                                         </Button>
                                     </Grid>

                                    <Border Margin="0,9,48,0" Padding="10,8" CornerRadius="9"
                                            Background="{DynamicResource SecondarySurfaceBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding HasCostProjection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="2.15*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="28" Height="28" CornerRadius="8" Background="#2563EB"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CalculatorVariantOutline" Width="16" Height="16"
                                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                                <TextBlock Text="{Binding PresentationCostLabel}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PurchaseUnitCost, StringFormat={}{0:C2}}" Margin="0,2,0,0"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                <TextBlock Text="COSTO UNIT. BASE" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding BaseUnitCost, StringFormat={}{0:C2}}" Margin="0,2,0,0"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding AverageProjectionLabel}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           ToolTip="Promedio proyectado = (stock actual × promedio actual + costo total ingresado) ÷ (stock actual + cantidad base ingresada)"/>
                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AverageBefore, StringFormat={}{0:C2}}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <Grid Width="20" Height="16" Margin="5,0">
                                                        <materialDesign:PackIcon Kind="ArrowUpBold" Width="15" Height="15" Foreground="#D97706"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding IsAverageIncrease, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <materialDesign:PackIcon Kind="ArrowDownBold" Width="15" Height="15" Foreground="{DynamicResource BrandProBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding IsAverageDecrease, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding IsAverageUnchanged, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProjectedAverage, StringFormat={}{0:C2}}" FontSize="12" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAverageIncrease}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAverageDecrease}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Margin="10,0,0,0" Padding="7,3" CornerRadius="6"
                                                            Visibility="{Binding HasNonBasePresentation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            ToolTip="Costo promedio base proyectado multiplicado por el factor de conversión de esta presentación.">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAverageIncrease}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAverageDecrease}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProjectedPresentationLabel}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ProjectedPresentationCost, StringFormat={}{0:C2}}" Margin="7,0,0,0"
                                                                   FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAverageIncrease}" Value="True">
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsAverageDecrease}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <Border Padding="9,5" CornerRadius="8" Background="{DynamicResource BrandProBrush}"
                                                        Visibility="{Binding HasPendingPrices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="Los precios configurados se aplicarán al confirmar esta operación.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="TagCheckOutline" Width="15" Height="15" Foreground="White"/>
                                                        <TextBlock Text="{Binding PendingPricesDisplay}" Margin="5,0,0,0"
                                                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="0,4,0,0" Padding="9,5" CornerRadius="8" Background="#D97706"
                                                        Visibility="{Binding HasSignificantCostVariation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="El costo promedio variará al menos 10 %. Revisa los precios de venta después de guardar.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AlertOutline" Width="15" Height="15" Foreground="White"/>
                                                        <TextBlock Text="REVISAR PRECIOS" Margin="5,0,0,0" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Información secundaria plegable -->
                <Border Margin="0,12,0,0" Style="{StaticResource FormSectionStyle}">
                    <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}" Margin="0,0,9,0">
                                    <materialDesign:PackIcon Kind="DotsHorizontalCircleOutline" Width="17" Height="17" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Información opcional" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Referencia interna y archivo de soporte" Style="{StaticResource FieldHelpStyle}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Referencia interna" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Style="{StaticResource FormFieldBorderStyle}">
                                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                             materialDesign:HintAssist.Hint="Vale, autorización, transferencia u otro dato"/>
                                </Border>
                                <TextBlock Text="No tiene efecto contable ni tributario." Style="{StaticResource FieldHelpStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Archivo de soporte" Style="{StaticResource FieldLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectEvidenceCommand}" Style="{StaticResource NeutralButtonStyle}">
                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Paperclip" Width="17" Height="17"/><TextBlock Text="Adjuntar" Margin="7,0,0,0"/></StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearEvidenceCommand}" Style="{StaticResource DeleteButtonStyle}" Margin="10,0,0,0"
                                            Visibility="{Binding EvidencePath, Converter={StaticResource StringToVisibilityConverter}}" ToolTip="Quitar soporte">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding EvidencePath}" MaxWidth="320" Margin="1,6,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie fijo -->
        <Border Grid.Row="2" Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource BrandProBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="La operación será auditable, pero no tendrá sustento tributario." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Width="130" Height="4" IsIndeterminate="True" VerticalAlignment="Center"/>
                        <TextBlock Text="Registrando operación..." Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Padding="13,7" Margin="0,0,4,0" CornerRadius="11"
                        Background="{DynamicResource PrimaryDarkBrush}"
                        materialDesign:ElevationAssist.Elevation="Dp4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalculatorVariantOutline" Width="19" Height="19"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL DE LA OPERACIÓN" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#D1FAE5"/>
                            <TextBlock Text="{Binding Total, Mode=OneWay, StringFormat={}{0:C2}}"
                                       FontSize="19" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Visibility="Collapsed"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}" Width="190" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/><TextBlock Text="Cancelar" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="190"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverterConverter}}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Foreground="White"/><TextBlock Text="Confirmar operación" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuración informada de lotes y series -->
        <Border Grid.RowSpan="3" Panel.ZIndex="50" Background="#99000000"
                Visibility="{Binding IsControlOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="1180" MaxHeight="780"
                    Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    CornerRadius="16" Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    materialDesign:ElevationAssist.Elevation="Dp8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="20,16" Background="{DynamicResource SecondarySurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource PrimaryDarkBrush}">
                                <materialDesign:PackIcon Kind="PackageVariant" Width="23" Height="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Configurar control" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding ControlEditor.ProductDisplay, Mode=OneWay}" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="3" Command="{Binding CancelControlCommand}" Style="{StaticResource DangerButtonStyle}" Width="42" Height="42" Padding="0">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="18,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Padding="10,7" CornerRadius="10" Margin="0,0,0,12"
                                        Background="{DynamicResource InputSecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="CANTIDAD DISTRIBUIDA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}">
                                                    <Run Text="Asignado: "/><Run Text="{Binding ControlEditor.Assigned, Mode=OneWay, StringFormat={}{0:0.######}}" FontWeight="SemiBold"/>
                                                    <Run Text="  —  " Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <Run Text="Requerido: "/><Run Text="{Binding ControlEditor.Required, Mode=OneWay, StringFormat={}{0:0.######}}" FontWeight="SemiBold"/>
                                                    <Run Text="  —  " Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ControlEditor.HasExcess}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Pendiente: "/><Run Text="{Binding ControlEditor.Pending, Mode=OneWay, StringFormat={}{0:0.######}}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Visibility="{Binding ControlEditor.ManagesLots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Lotes" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Distribuye la cantidad base entre uno o varios lotes." Style="{StaticResource FieldHelpStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ControlEditor.AddLotCommand}" Style="{StaticResource AddButtonStyle}">
                                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/><TextBlock Text="Agregar lote" Margin="7,0,0,0"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="10,0,10,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="115"/><ColumnDefinition Width="10"/><ColumnDefinition Width="135"/><ColumnDefinition Width="10"/><ColumnDefinition Width="135"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="LOTE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="CANTIDAD BASE" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="4" Text="ELABORACIÓN" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="6" Text="CADUCIDAD" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="8" Text="LOTE SIMILAR" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="Confirma expresamente que deseas crear un lote nuevo aunque exista otro de número parecido."/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ControlEditor.Lots}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource LineCardStyle}" Padding="9" Margin="0,0,0,7">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="115"/><ColumnDefinition Width="10"/><ColumnDefinition Width="135"/><ColumnDefinition Width="10"/><ColumnDefinition Width="135"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="Número de lote"/></Border>
                                                    <Border Grid.Column="2" Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding BaseQuantity, StringFormat={}{0:0.######}, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" Style="{StaticResource ModernTextBoxStyle}" behaviors:DecimalInputBehavior.IsEnabled="True" behaviors:DecimalInputBehavior.DecimalPlaces="6" behaviors:DecimalInputBehavior.TrimTrailingZeros="True" behaviors:DecimalInputBehavior.UpdateSourceWhileTyping="True" behaviors:DecimalInputBehavior.ClearZeroOnFocus="True"/></Border>
                                                    <Border Grid.Column="4" Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding ManufacturingDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Language="es-EC" Validation.ErrorTemplate="{x:Null}" Style="{StaticResource ModernTextBoxStyle}" behaviors:DateInputBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="dd/mm/aaaa"/></Border>
                                                    <Border Grid.Column="6" Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding ExpirationDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Language="es-EC" Validation.ErrorTemplate="{x:Null}" Style="{StaticResource ModernTextBoxStyle}" behaviors:DateInputBehavior.IsEnabled="True" materialDesign:HintAssist.Hint="dd/mm/aaaa"/></Border>
                                                    <CheckBox Grid.Column="8" IsChecked="{Binding AllowSimilarNewLot}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Autorizar la creación si el sistema detecta un lote de número similar."/>
                                                    <Button Grid.Column="9" Command="{Binding DataContext.ControlEditor.RemoveLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DeleteButtonStyle}" Width="40" Height="40" ToolTip="Quitar lote"><materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="White"/></Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding ControlEditor.ManagesSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Números de serie" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Registra exactamente una serie por cada unidad base." Style="{StaticResource FieldHelpStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding ControlEditor.AddSeriesCommand}" Style="{StaticResource AddButtonStyle}">
                                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/><TextBlock Text="Agregar serie" Margin="7,0,0,0"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ControlEditor.Series}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource LineCardStyle}" Padding="9" Margin="0,0,0,7">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="190"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource FormFieldBorderStyle}"><TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource ModernTextBoxStyle}" materialDesign:HintAssist.Hint="Número de serie"/></Border>
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.ControlEditor.Lots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Number" SelectedValuePath="Number" SelectedValue="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource OperationComboStyle}" materialDesign:HintAssist.Hint="Lote asociado"
                                                              Visibility="{Binding DataContext.ControlEditor.ManagesLots, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Grid.Column="3" Command="{Binding DataContext.ControlEditor.RemoveSeriesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DeleteButtonStyle}" Width="40" Height="40" ToolTip="Quitar serie"><materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="White"/></Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Cada serie debe ser única y, si aplica, quedar asociada a uno de los lotes distribuidos." Style="{StaticResource FieldHelpStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Column="2" Padding="13" CornerRadius="12" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding ControlEditor.ManagesLots, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,9,0">
                                            <materialDesign:PackIcon Kind="ArchiveOutline" Width="17" Height="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Lotes registrados" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" MinWidth="30" Height="30" Padding="8,0" CornerRadius="8" Background="{DynamicResource PrimaryDarkBrush}">
                                        <TextBlock Text="{Binding ExistingLots.Count, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Referencia global por bodega. Selecciona uno para reutilizarlo." Style="{StaticResource FieldHelpStyle}" Margin="0,4,0,10"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ExistingLots}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Command="{Binding DataContext.UseExistingLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource ControlLotReferenceButtonStyle}">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#2563EB" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="2,0,8,0">
                                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Warehouse}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DatesDisplay, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Padding="8,5" CornerRadius="8" Background="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center">
                                                        <StackPanel><TextBlock Text="STOCK" Foreground="#D1FAE5" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StockDisplay}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource SecondarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="17" Height="17" Foreground="{DynamicResource BrandProBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="La configuración se conserva al aplicar el control." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CancelControlCommand}" Style="{StaticResource DangerButtonStyle}" Width="155" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Close" Width="17" Height="17" Foreground="White"/><TextBlock Text="Cancelar" Margin="7,0,0,0" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                                </Button>
                                <Button Command="{Binding ApplyControlCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="175">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="17" Height="17" Foreground="White"/><TextBlock Text="Aplicar control" Margin="7,0,0,0" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Producto nuevo, sin inventario inicial; el ingreso se genera al confirmar esta operación. -->
        <Border Grid.RowSpan="3" Panel.ZIndex="60" Background="{DynamicResource ElevatedSurfaceBrush}"
                Visibility="{Binding IsProductFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <productViews:ProductFormView DataContext="{Binding ProductForm}"/>
        </Border>
    </Grid>
</UserControl>
