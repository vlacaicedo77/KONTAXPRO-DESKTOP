rce InverseBooleanToVisibilityConverter}}"><materialDesign:PackIcon Style="{StaticResource KontaxEmptyListIconStyle}"/><TextBlock Text="No se encontraron registros" Style="{StaticResource InventoryDetailEmptyTextStyle}"/></StackPanel></Grid>
      </TabItem>
      <TabItem Visibility="{Binding SelectedDetail.ManejaSeries, Converter={StaticResource BooleanToVisibilityConverter}}">
       <TabItem.Header><StackPanel Orientation="Horizontal"><Border Width="27" Height="27" CornerRadius="7" Background="#7C3AED"><materialDesign:PackIcon Kind="Barcode" Width="15" Height="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SERIES" Margin="8,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedDetail.Series.Count, StringFormat={}({0})}" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
        <Grid><DataGrid ItemsSource="{Binding SelectedDetail.Series}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource KontaxDataGridStyle}" ColumnHeaderStyle="{StaticResource InventoryDetailColumnHeaderStyle}" MinRowHeight="44" CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="SERIE" Binding="{Binding Numero}" Width="*" MinWidth="140"/><DataGridTextColumn Header="BODEGA" Binding="{Binding Bodega}" Width="*" MinWidth="140"/><DataGridTextColumn Header="LOTE" Binding="{Binding Lote}" Width="150" MinWidth="110"/><DataGridTemplateColumn Header="ESTADO" Width="125" MinWidth="105" SortMemberPath="Estado" HeaderStyle="{StaticResource InventoryDetailCenteredColumnHeaderStyle}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="9,4" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding Estado}" Value="DISPONIBLE"><Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Estado}" Value="RESERVADA"><Setter Property="Background" Value="#F59E0B"/></DataTrigger><DataTrigger Binding="{Binding Estado}" Value="VENDIDA"><Setter Property="Background" Value="#2563EB"/></DataTrigger><DataTrigger Binding="{Binding Estado}" Value="BAJA"><Setter Property="Background" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding EstadoTexto}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedDetail.TieneSeries, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><materialDesign:PackIcon Style="{StaticResource KontaxEmptyListIconStyle}"/><TextBlock Text="No se encontraron registros" Style="{StaticResource InventoryDetailEmptyTextStyle}"/></StackPanel></Grid>
