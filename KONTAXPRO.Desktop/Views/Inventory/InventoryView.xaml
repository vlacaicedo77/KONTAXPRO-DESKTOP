           <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Visibility="{Binding EsEntrada, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Cantidad base que ingresó al inventario"><materialDesign:PackIcon Kind="ArrowDownBold" Width="15" Height="15" Margin="0,0,5,0" Foreground="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center"/><TextBlock Style="{StaticResource InventoryMovementValueStyle}" Foreground="{DynamicResource PrimaryDarkBrush}"><Run Text="+"/><Run Text="{Binding EntradaBase, StringFormat={}{0:0.######}, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Text="—" Style="{StaticResource InventoryMovementValueStyle}" Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding EsEntrada, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="SALIDA" Width="95" MinWidth="82" SortMemberPath="SalidaBase" HeaderStyle="{StaticResource InventoryDetailCenteredColumnHeaderStyle}">
           <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Visibility="{Binding EsSalida, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Cantidad base que salió del inventario"><materialDesign:PackIcon Kind="ArrowUpBold" Width="15" Height="15" Margin="0,0,5,0" Foreground="#DC2626" VerticalAlignment="Center"/><TextBlock Style="{StaticResource InventoryMovementValueStyle}" Foreground="#DC2626"><Run Text="−"/><Run Text="{Binding SalidaBase, StringFormat={}{0:0.######}, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Text="—" Style="{StaticResource InventoryMovementValueStyle}" Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding EsSalida, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="SALDO" Binding="{Binding StockNuevo, StringFormat={}{0:0.######}}" Width="90" MinWidth="72" ElementStyle="{StaticResource InventoryEmphasizedCellTextStyle}" HeaderStyle="{StaticResource InventoryDetailCenteredColumnHeaderStyle}"/>
