<UserControl x:Class="KONTAXPRO.Desktop.Views.Inventory.InventoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:behaviors="clr-namespace:KONTAXPRO.Desktop.Behaviors"
  xmlns:inventoryModels="clr-namespace:KONTAXPRO.Application.Models.Inventario;assembly=KONTAXPRO.Application"
  xmlns:productViews="clr-namespace:KONTAXPRO.Desktop.Views.Products"
 xmlns:inventoryViews="clr-namespace:KONTAXPRO.Desktop.Views.Inventory"
 xmlns:desktop="clr-namespace:KONTAXPRO.Desktop"
 x:Name="InventoryRoot"
 Background="{DynamicResource PageBackgroundBrush}">
 <UserControl.Resources>
  <desktop:BindingProxy x:Key="InventoryDataContextProxy" Data="{Binding}"/>
  <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource FocusBorderBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,10"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/><Setter TargetName="FieldBorder" Property="BorderThickness" Value="2"/></Trigger>
       <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource InputSecondaryBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.62"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="InventoryFieldBorderStyle" TargetType="Border">
   <Setter Property="MinHeight" Value="46"/>
   <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
  </Style>
  <Style x:Key="InventoryFieldLabelStyle" TargetType="TextBlock">
   <Setter Property="Margin" Value="1,0,0,6"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style x:Key="InventorySectionTitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
  <Style x:Key="InventoryFieldHelpStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Margin" Value="1,5,0,0"/></Style>
  <Style x:Key="InventoryGridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}"><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="InventoryKpiStyle" TargetType="Button">
   <Setter Property="Padding" Value="18"/><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="Tag" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="InventoryKpiAllStyle" TargetType="Button" BasedOn="{StaticResource InventoryKpiStyle}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/><Setter Property="BorderBrush" Value="#3B82F6"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventoryKpiNoStockStyle" TargetType="Button" BasedOn="{StaticResource InventoryKpiStyle}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="#EF4444"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventoryKpiLowStockStyle" TargetType="Button" BasedOn="{StaticResource InventoryKpiStyle}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="#F59E0B"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventoryKpiExpiryStyle" TargetType="Button" BasedOn="{StaticResource InventoryKpiStyle}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="Background" Value="{DynamicResource PurpleSoftBrush}"/><Setter Property="BorderBrush" Value="#A855F7"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventorySearchClearStyle" TargetType="Button">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ClearBackground" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ClearBackground" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
   <Style x:Key="InventoryRefreshStyle" TargetType="Button">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
  <Style x:Key="InventoryLoadingStyle" TargetType="ProgressBar">
   <Setter Property="Height" Value="6"/><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="IsIndeterminate" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True" SnapsToDevicePixels="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="LoadingIndicator" Width="190" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" Opacity="0.95"><Border.RenderTransform><TranslateTransform X="-210"/></Border.RenderTransform></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="LoadingIndicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-210" To="2400" Duration="0:0:1.65"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
   <Style x:Key="InventoryCenteredSortHeaderStyle" TargetType="Button">
    <Setter Property="Padding" Value="6,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="InventorySortHeaderStyle" TargetType="Button">
    <Setter Property="Padding" Value="6,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrandProBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="InventoryColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource KontaxDataGridColumnHeaderStyle}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border x:Name="HeaderBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource TableAlternateRowBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
   <Style x:Key="InventoryCenteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource InventoryColumnHeaderStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="InventoryDetailColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource KontaxDataGridColumnHeaderStyle}">
   <Setter Property="FontSize" Value="10"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DataGridColumnHeader">
      <Grid Background="{TemplateBinding Background}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
       <materialDesign:PackIcon x:Name="SortIndicator" Grid.Column="1" Kind="ChevronUp" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandProBrush}" Visibility="Collapsed"/>
       <Thumb x:Name="PART_LeftHeaderGripper" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Background="Transparent"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></Thumb.Template></Thumb>
       <Thumb x:Name="PART_RightHeaderGripper" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Background="Transparent"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableAlternateRowBrush}"/></Trigger>
       <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortIndicator" Property="Visibility" Value="Visible"/><Setter TargetName="SortIndicator" Property="Kind" Value="ChevronUp"/></Trigger>
       <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortIndicator" Property="Visibility" Value="Visible"/><Setter TargetName="SortIndicator" Property="Kind" Value="ChevronDown"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="InventoryDetailCenteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource InventoryDetailColumnHeaderStyle}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="InventoryDetailCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource KontaxDataGridCellStyle}">
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="InventoryDetailDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource KontaxDataGridStyle}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
    <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
    <Setter Property="CellStyle" Value="{StaticResource InventoryDetailCellStyle}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
  </Style>
  <Style x:Key="InventoryActionStyle" TargetType="Button" BasedOn="{StaticResource KontaxBaseButtonStyle}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="InventorySecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource InventoryActionStyle}"><Setter Property="Background" Value="#2563EB"/><Setter Property="BorderBrush" Value="#2563EB"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventoryPurpleActionStyle" TargetType="Button" BasedOn="{StaticResource InventoryActionStyle}"><Setter Property="Background" Value="#7C3AED"/><Setter Property="BorderBrush" Value="#7C3AED"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6D28D9"/></Trigger></Style.Triggers></Style>
  <Style x:Key="InventoryPageButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}"><Setter Property="MinWidth" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/></Style>
  <Style x:Key="InventoryEmphasizedCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KontaxCenteredCellTextStyle}">
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>
  <Style x:Key="InventoryMovementValueStyle" TargetType="TextBlock" BasedOn="{StaticResource KontaxCenteredCellTextStyle}"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="ExtraBold"/></Style>
  <Style x:Key="InventorySummaryCard" TargetType="Border"><Setter Property="MinHeight" Value="76"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="4"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="InventoryDetailMetricLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="InventoryDetailMetricValueStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="TextAlignment" Value="Left"/></Style>
  <Style x:Key="InventoryDetailMetricIconStyle" TargetType="Border"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
   <Style x:Key="InventoryDetailEmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KontaxEmptyListTextStyle}"/>
  <Style x:Key="InventoryDetailTabControlStyle" TargetType="TabControl">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,0,0,9" KeyboardNavigation.TabIndex="1"/>
       <Border Grid.Row="1" Padding="1" CornerRadius="13" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent"/>
       </Border>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
   <Style x:Key="InventoryDetailTabItemStyle" TargetType="TabItem">
   <Setter Property="Width" Value="205"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Padding" Value="11,7"/>
   <Setter Property="Background" Value="{DynamicResource InputSecondaryBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
   <Setter Property="FontSize" Value="10"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TableSelectedRowBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#2563EB"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   </Style>
   <Style x:Key="InventoryCorrectionCellStyle" TargetType="DataGridCell"
          BasedOn="{StaticResource InventoryDetailCellStyle}">
    <Setter Property="Padding" Value="2,1"/>
   </Style>
   <Style x:Key="InventoryCorrectionDataGridStyle" TargetType="DataGrid"
          BasedOn="{StaticResource InventoryDetailDataGridStyle}">
    <Setter Property="MinHeight" Value="118"/>
    <Setter Property="MaxHeight" Value="158"/>
    <Setter Property="RowHeight" Value="40"/>
    <Setter Property="MinRowHeight" Value="40"/>
    <Setter Property="ColumnHeaderHeight" Value="36"/>
    <Setter Property="CellStyle" Value="{StaticResource InventoryCorrectionCellStyle}"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource InventoryDetailColumnHeaderStyle}"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserSortColumns" Value="False"/>
   </Style>
   <Style x:Key="InventoryCorrectionGridInputStyle" TargetType="TextBox"
          BasedOn="{StaticResource ModernTextBoxStyle}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextAlignment" Value="Center"/>
   </Style>
   <Style x:Key="InventoryCorrectionSummaryCardStyle" TargetType="Border"
          BasedOn="{StaticResource InventorySummaryCard}">
    <Setter Property="MinHeight" Value="62"/>
    <Setter Property="Padding" Value="9,7"/>
    <Setter Property="Margin" Value="3"/>
   </Style>
   <Style x:Key="InventoryCorrectionMetricIconStyle" TargetType="Border"
          BasedOn="{StaticResource InventoryDetailMetricIconStyle}">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
   </Style>
   <Style x:Key="InventoryCorrectionFooterStyle" TargetType="Border"
          BasedOn="{StaticResource InventoryDialogFooterStyle}">
    <Setter Property="Padding" Value="0,9,0,0"/>
   </Style>
  </UserControl.Resources>

 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource PrimaryDarkBrush}" Margin="0,0,14,0"><materialDesign:PackIcon Kind="Warehouse" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Inventario" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="Existencias, costos y trazabilidad física por bodega" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding OpenInitialCommand}" CommandParameter="{Binding SelectedItem}" Visibility="{Binding CanRegisterInitial, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource NeutralButtonStyle}" ToolTip="Disponible únicamente antes del primer movimiento operativo del producto"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArchiveArrowUpOutline" Width="18" Height="18"/><TextBlock Text="Saldo inicial" Margin="8,0,0,0"/></StackPanel></Button><Button Margin="8,0,0,0" Command="{Binding OpenAdjustmentCommand}" CommandParameter="{Binding SelectedItem}" Visibility="{Binding CanAdjust, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Selecciona un producto y registra un ajuste"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18" Foreground="White"/><TextBlock Text="Nuevo ajuste" Margin="8,0,0,0"/></StackPanel></Button><Button Margin="8,0,0,0" Command="{Binding ReconcileCommand}" Visibility="{Binding CanReconcile, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource NeutralButtonStyle}" ToolTip="Verificar consistencia entre existencias, lotes y series"><materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"/></Button></StackPanel>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Grid.Column="0" Style="{StaticResource InventoryKpiAllStyle}" Tag="{Binding IsAllKpi}" ToolTip="Mostrar todos los productos" Command="{Binding SelectKpiCommand}" CommandParameter="TODOS"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="52" Height="52" CornerRadius="14" Background="#3B82F6"><materialDesign:PackIcon Kind="PackageVariantClosed" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding ProductsCount}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="PRODUCTOS" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></Button>
   <Button Grid.Column="2" Style="{StaticResource InventoryKpiLowStockStyle}" Tag="{Binding IsLowStockKpi}" ToolTip="Mostrar productos con stock bajo" Command="{Binding SelectKpiCommand}" CommandParameter="STOCK_BAJO"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="52" Height="52" CornerRadius="14" Background="#F59E0B"><materialDesign:PackIcon Kind="PackageVariantClosedMinus" Width="25" Height="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding LowStockCount}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="STOCK BAJO" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Grid></Button>
