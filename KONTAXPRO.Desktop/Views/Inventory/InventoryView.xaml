     <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Consulta informativa: esta ventana no modifica las existencias." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Grid.Column="1" Command="{Binding OpenKardexCommand}" CommandParameter="{Binding SelectedItem}" Style="{StaticResource InventoryDialogPrimaryButtonStyle}" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartTimelineVariant" Width="18" Height="18" Foreground="White"/><TextBlock Text="Ver Kardex completo" Margin="8,0,0,0" Foreground="White"/></StackPanel></Button>
     </Grid>
    </Grid>
   </Border>
  </Border>

  <!-- Kardex paginado -->
  <inventoryViews:InventoryKardexPanel Grid.RowSpan="7" Panel.ZIndex="21"
                                       Visibility="{Binding IsKardexOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

   <!-- Flujos operativos aprobados en Productos V1 -->
   <Border Grid.RowSpan="7" Panel.ZIndex="30"
           Background="{DynamicResource OverlayBrush}"
           Visibility="{Binding IsProductOperationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Margin="18"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
     <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Opacity="0.32"/></Border.Effect>
      <ContentControl>
       <ContentControl.Style>
        <Style TargetType="ContentControl">
         <Setter Property="Content" Value="{x:Null}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsProductOperationOpen}" Value="True">
           <Setter Property="Content" Value="{Binding ProductOperations}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </ContentControl.Style>
       <ContentControl.ContentTemplate>
        <DataTemplate><productViews:ProductFormView/></DataTemplate>
       </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
   </Border>

    <!-- Corrección controlada de la bodega asignada al inventario inicial. -->
