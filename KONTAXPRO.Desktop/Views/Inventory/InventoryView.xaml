            Background="{DynamicResource OverlayBrush}"
            Visibility="{Binding IsInitialWarehouseCorrectionOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
     <Border Style="{StaticResource InventoryDialogContainerStyle}">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>

       <!-- Cabecera alineada con Existencias y Kardex. -->
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource PrimaryDarkBrush}" ToolTip="Corregir bodega inicial">
         <materialDesign:PackIcon Kind="SwapHorizontal" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
         <TextBlock Text="CORRECCIÓN DE INVENTARIO INICIAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandProBrush}"/>
         <TextBlock Text="{Binding SelectedDetail.NombreConMarca}" Margin="0,2,0,0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
         <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
          <Border Padding="6,2" CornerRadius="6" Background="#475569" Visibility="{Binding SelectedDetail.TieneCategoria, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding SelectedDetail.Categoria}" FontSize="9" FontWeight="SemiBold" Foreground="White"/></Border>
          <TextBlock Text=" · " Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding SelectedDetail.MostrarSeparadorCategoriaModelo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <TextBlock Text="{Binding SelectedDetail.Modelo}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="{Binding SelectedDetail.TieneModelo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}"/>
          <TextBlock Text="{Binding SelectedDetail.PresentacionesTexto}" MaxWidth="430" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </StackPanel>
        <Border Grid.Column="3" Padding="10,7" CornerRadius="9"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="#F59E0B" BorderThickness="1"
                VerticalAlignment="Center"
                ToolTip="Solo se mueve la cantidad disponible del inventario inicial. Las unidades reservadas permanecen en la bodega de origen.">
         <StackPanel Orientation="Horizontal">
          <materialDesign:PackIcon Kind="AlertOutline" Width="17" Height="17"
                                   Foreground="#D97706" VerticalAlignment="Center"/>
          <TextBlock Text="Solo stock disponible · reservas excluidas"
                     Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center"/>
         </StackPanel>
        </Border>
        <Button Grid.Column="5" Command="{Binding ClosePanelsCommand}" Style="{StaticResource InventoryDialogCloseButtonStyle}"><materialDesign:PackIcon Kind="Close" Foreground="White"/></Button>
       </Grid>

       <ScrollViewer x:Name="CorrectionContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" CanContentScroll="False">
        <StackPanel>
          <Border Padding="11,9" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="BODEGA EQUIVOCADA *" Style="{StaticResource InventoryFieldLabelStyle}"/><ComboBox ItemsSource="{Binding CorrectionSourceWarehouses}" SelectedItem="{Binding TransferSource}" DisplayMemberPath="Display" Style="{StaticResource ModernComboBoxStyle}"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="BODEGA CORRECTA *" Style="{StaticResource InventoryFieldLabelStyle}"/><ComboBox ItemsSource="{Binding CorrectionTargetWarehouses}" SelectedItem="{Binding TransferTarget}" DisplayMemberPath="Display" Style="{StaticResource ModernComboBoxStyle}"/></StackPanel>
          </Grid>
         </Border>

          <UniformGrid Margin="-3,5,-3,0" Columns="4">
          <Border Style="{StaticResource InventoryCorrectionSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource InventoryCorrectionMetricIconStyle}" Background="#2563EB"><materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="STOCK ACTUAL" Style="{StaticResource InventoryDetailMetricLabelStyle}"/><Viewbox Margin="0,3,0,0" Height="18" HorizontalAlignment="Left" StretchDirection="DownOnly"><TextBlock Text="{Binding CorrectionSourceStock, StringFormat={}{0:0.######}}" Style="{StaticResource InventoryDetailMetricValueStyle}"/></Viewbox></StackPanel></Grid></Border>
          <Border Style="{StaticResource InventoryCorrectionSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource InventoryCorrectionMetricIconStyle}" Background="{DynamicResource PrimaryDarkBrush}"><materialDesign:PackIcon Kind="PackageCheck" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DISPONIBLE" Style="{StaticResource InventoryDetailMetricLabelStyle}"/><Viewbox Margin="0,3,0,0" Height="18" HorizontalAlignment="Left" StretchDirection="DownOnly"><TextBlock Text="{Binding CorrectionAvailableStock, StringFormat={}{0:0.######}}" Style="{StaticResource InventoryDetailMetricValueStyle}" Foreground="{DynamicResource PrimaryDarkBrush}"/></Viewbox></StackPanel></Grid></Border>
          <Border Style="{StaticResource InventoryCorrectionSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource InventoryCorrectionMetricIconStyle}" Background="#7C3AED"><materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="A MOVER" Style="{StaticResource InventoryDetailMetricLabelStyle}"/><Viewbox Margin="0,3,0,0" Height="18" HorizontalAlignment="Left" StretchDirection="DownOnly"><TextBlock Text="{Binding CorrectionQuantityToMove, StringFormat={}{0:0.######}}" Style="{StaticResource InventoryDetailMetricValueStyle}" Foreground="#7C3AED"/></Viewbox></StackPanel></Grid></Border>
          <Border Style="{StaticResource InventoryCorrectionSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource InventoryCorrectionMetricIconStyle}"><Setter Property="Background" Value="#D97706"/><Style.Triggers><DataTrigger Binding="{Binding CorrectionExceedsAvailable}" Value="True"><Setter Property="Background" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></Border.Style><materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PERMANECE" Style="{StaticResource InventoryDetailMetricLabelStyle}"/><Viewbox Margin="0,3,0,0" Height="18" HorizontalAlignment="Left" StretchDirection="DownOnly"><TextBlock Text="{Binding CorrectionRemainingStock, StringFormat={}{0:0.######}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource InventoryDetailMetricValueStyle}"><Setter Property="Foreground" Value="#D97706"/><Style.Triggers><DataTrigger Binding="{Binding CorrectionExceedsAvailable}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Viewbox></StackPanel></Grid></Border>
         </UniformGrid>

          <Border Margin="0,5,0,0" Padding="11,9" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
