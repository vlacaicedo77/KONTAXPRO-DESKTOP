<Window x:Class="KONTAXPRO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:KONTAXPRO.Desktop.Controls"
        Title="KONTAXPRO"
        Icon="/KONTAXPRO.Desktop;component/Assets/kontaxpro.ico"
        WindowState="Maximized"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>

        <Style x:Key="DiscreteScrollBarStyle"
               TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="7" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource TextMutedBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">

                                                <Border x:Name="ThumbBorder"
                                                        Width="5"
                                                        Margin="1,3"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource BorderBrush}" />

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource BrandProBrush}" />

                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource BrandProBrush}" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- ===================================================== -->
        <!-- OPCIÓN NORMAL DEL MENÚ DEL USUARIO                    -->
        <!-- ===================================================== -->
        <Style x:Key="UserMenuOptionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48" />

            <Setter Property="Margin"
                    Value="5,3" />

            <Setter Property="Padding"
                    Value="14,0" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource UserButtonHoverBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource UserButtonHoverForegroundBrush}" />

                            </Trigger>


                            <!-- PRESIONADO -->
                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource MenuPrimaryPressedBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource MenuPrimaryHoverForegroundBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- OPCIÓN CERRAR SESIÓN                                  -->
        <!-- ===================================================== -->
        <Style x:Key="LogoutMenuButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Margin"
                    Value="5,3" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource DangerForegroundBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource DangerBackgroundBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource DangerHoverForegroundBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource DangerHoverBrush}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource DangerHoverForegroundBrush}" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.55" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- MENÚ LATERAL                                          -->
        <!-- ===================================================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="KONTAX"
                               FontFamily="Segoe UI Black"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="{DynamicResource BrandKontaxBrush}" />

                    <TextBlock Text="PRO"
                               FontFamily="Segoe UI Black"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="{DynamicResource BrandProBrush}" />

                </StackPanel>


                <!-- Menú -->
                <ScrollViewer Grid.Row="2"
                              Margin="0,0,6,0"
                              Padding="0,0,8,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ScrollViewer.Resources>

                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource DiscreteScrollBarStyle}" />

                    </ScrollViewer.Resources>

                    <ItemsControl ItemsSource="{Binding MenuItems}"
                                  HorizontalAlignment="Stretch">

                        <ItemsControl.ItemContainerStyle>

                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment"
                                        Value="Stretch" />
                            </Style>

                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <controls:SidebarMenuItem HorizontalAlignment="Stretch" />

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>


                <!-- Versión -->
                <TextBlock Grid.Row="3"
                           Text="KONTAXPRO 1.0"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CONTENIDO PRINCIPAL                                   -->
        <!-- ===================================================== -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- BARRA SUPERIOR                                    -->
            <!-- ================================================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!-- Empresa y establecimiento -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="{Binding EmpresaActiva}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                    </StackPanel>


                    <!-- Controles derechos -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- ===================================== -->
                        <!-- BOTÓN DEL TEMA                        -->
                        <!-- ===================================== -->
                        <Button Command="{Binding ToggleThemeCommand}"
                                Width="46"
                                Height="46"
                                Padding="0"
                                Margin="0,0,16,0"
                                Background="Transparent"
                                Foreground="#111827"
                                BorderThickness="0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="Cambiar tema claro / oscuro">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="ThemeButtonBorder"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="12"
                                            Background="{DynamicResource ThemeButtonBackgroundBrush}">

                                        <materialDesign:PackIcon Kind="ThemeLightDark"
                                                                 Width="22"
                                                                 Height="22"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{TemplateBinding Foreground}" />

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                 Value="True">

                                            <Setter TargetName="ThemeButtonBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource ThemeButtonHoverBrush}" />

                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource ThemeButtonHoverForegroundBrush}" />

                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">

                                            <Setter TargetName="ThemeButtonBorder"
                                                    Property="Opacity"
                                                    Value="0.75" />

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Button.Template>

                        </Button>


                        <!-- ===================================== -->
                        <!-- BOTÓN Y MENÚ DEL USUARIO              -->
                        <!-- ===================================== -->
                        <Grid Width="310">

                            <ToggleButton x:Name="UserMenuButton"
                                          AutomationProperties.Name="Menú de usuario"
                                          Width="310"
                                          Height="60"
                                          Padding="10,5"
                                          Background="{DynamicResource UserButtonBackgroundBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="UserButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">

                                            <ContentPresenter />

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <!-- Hover rojo sólido -->
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="UserButtonBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource UserButtonHoverBrush}" />

                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource UserButtonHoverForegroundBrush}" />

                                            </Trigger>

                                            <!-- Mantener rojo cuando el menú está abierto -->
                                            <Trigger Property="IsChecked"
                                                     Value="True">

                                                <Setter TargetName="UserButtonBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource UserButtonHoverBrush}" />

                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource UserButtonHoverForegroundBrush}" />

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </ToggleButton.Template>


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>


                                    <!-- Avatar -->
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="{DynamicResource BrandProBrush}"
                                            VerticalAlignment="Center">

                                        <materialDesign:PackIcon Kind="Account"
                                                                 Width="23"
                                                                 Height="23"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />

                                    </Border>


                                    <!-- Nombre e identificación -->
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,5,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding UsuarioConectado}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="215"
                                                   Foreground="{Binding Foreground,
                                                ElementName=UserMenuButton}" />

                                        <TextBlock Text="{Binding IdentificacionUsuario}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="0,3,0,0"
                                                   Foreground="{Binding Foreground,
                                                ElementName=UserMenuButton}" />

                                    </StackPanel>


                                    <!-- Flecha -->
                                    <materialDesign:PackIcon Grid.Column="2"
                                                             Kind="ChevronDown"
                                                             Width="18"
                                                             Height="18"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{Binding Foreground,
                                            ElementName=UserMenuButton}" />

                                </Grid>

                            </ToggleButton>


                            <!-- ================================= -->
                            <!-- MENÚ DESPLEGABLE                  -->
                            <!-- ================================= -->
                            <Popup IsOpen="{Binding IsChecked,
                                                   ElementName=UserMenuButton}"
                                   PlacementTarget="{Binding ElementName=UserMenuButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   VerticalOffset="5"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">

                                <Border Width="{Binding ActualWidth,
                                                       ElementName=UserMenuButton}"
                                        Padding="6"
                                        CornerRadius="10"
                                        Background="{DynamicResource UserMenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="3"
                                                          Direction="270"
                                                          Opacity="0.25" />
                                    </Border.Effect>


                                    <StackPanel>

                                        <!-- Cambiar empresa -->
                                        <StackPanel Visibility="{Binding MostrarCambiarEmpresa,
        Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <!-- Cambiar empresa -->
                                            <Button Command="{Binding CambiarEmpresaCommand}"
                                                    AutomationProperties.Name="Cambiar empresa"
                                                    Style="{StaticResource UserMenuOptionButtonStyle}">

                                                <StackPanel Orientation="Horizontal">

                                                    <materialDesign:PackIcon Kind="OfficeBuildingCog"
                                                                             Width="21"
                                                                             Height="21"
                                                                             Margin="0,0,12,0"
                                                                             Foreground="{Binding Foreground,
                    RelativeSource={
                        RelativeSource AncestorType=Button}}" />

                                                    <TextBlock Text="Cambiar empresa"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{Binding Foreground,
                    RelativeSource={
                        RelativeSource AncestorType=Button}}"
                                                               VerticalAlignment="Center" />

                                                </StackPanel>

                                            </Button>

                                            <Separator Margin="10,5"
                                                       Background="{DynamicResource BorderBrush}" />

                                        </StackPanel>


                                        <!-- Cerrar sesión -->
                                        <Button Command="{Binding CerrarSesionCommand}"
                                                Style="{StaticResource LogoutMenuButtonStyle}">

                                            <StackPanel Orientation="Horizontal">

                                                <materialDesign:PackIcon Kind="Logout"
                                                                         Width="21"
                                                                         Height="21"
                                                                         Margin="0,0,12,0"
                                                                         Foreground="{Binding Foreground,
                                                        RelativeSource={RelativeSource AncestorType=Button}}" />

                                                <TextBlock Text="Cerrar sesión"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{Binding Foreground,
                                                        RelativeSource={RelativeSource AncestorType=Button}}"
                                                           VerticalAlignment="Center" />

                                            </StackPanel>

                                        </Button>

                                    </StackPanel>

                                </Border>

                            </Popup>

                        </Grid>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- Área de navegación -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}" />

        </Grid>

    </Grid>

</Window>
