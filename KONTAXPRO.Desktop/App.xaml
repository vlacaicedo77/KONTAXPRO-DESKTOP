<Application x:Class="KONTAXPRO.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KONTAXPRO.Desktop.Views"
             xmlns:converters="clr-namespace:KONTAXPRO.Desktop.Converters"
             xmlns:viewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels"
             xmlns:productViews="clr-namespace:KONTAXPRO.Desktop.Views.Products"
             xmlns:productViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Products"
             xmlns:clientViews="clr-namespace:KONTAXPRO.Desktop.Views.Clientes"
             xmlns:clientViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Clientes"
             xmlns:supplierViews="clr-namespace:KONTAXPRO.Desktop.Views.Proveedores"
             xmlns:supplierViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Proveedores"
             xmlns:purchaseViews="clr-namespace:KONTAXPRO.Desktop.Views.Compras"
             xmlns:purchaseViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Compras"
             xmlns:treasuryViews="clr-namespace:KONTAXPRO.Desktop.Views.Tesoreria"
             xmlns:treasuryViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Tesoreria"
             xmlns:inventoryViews="clr-namespace:KONTAXPRO.Desktop.Views.Inventory"
             xmlns:inventoryViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.Inventory"
             xmlns:sriViews="clr-namespace:KONTAXPRO.Desktop.Views.FacturacionElectronica"
             xmlns:sriViewModels="clr-namespace:KONTAXPRO.Desktop.ViewModels.FacturacionElectronica">

    <Application.Resources>
        
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/LightTheme.xaml"/>
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Styles/DataGridStyles.xaml"/>
                <ResourceDictionary Source="Styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="Styles/DatePickerStyles.xaml"/>
                <ResourceDictionary Source="Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="Styles/InventoryDialogStyles.xaml"/>
                <ResourceDictionary Source="Styles/MessageDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <converters:ActiveModuleConverter x:Key="ActiveModuleConverter"/>

            <converters:BooleanInverterConverter x:Key="BooleanInverterConverter"/>

            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:VentasViewModel}">
                <views:VentasView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type productViewModels:ProductsViewModel}">
                <productViews:ProductsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type clientViewModels:ClientesViewModel}">
                <clientViews:ClientesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type supplierViewModels:ProveedoresViewModel}">
                <supplierViews:ProveedoresView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type purchaseViewModels:ComprasViewModel}">
                <purchaseViews:ComprasView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type treasuryViewModels:OperacionesSinSustentoViewModel}">
                <treasuryViews:OperacionesSinSustentoView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type inventoryViewModels:InventoryViewModel}">
                <inventoryViews:InventoryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type sriViewModels:FacturacionElectronicaConfiguracionViewModel}">
                <sriViews:FacturacionElectronicaConfiguracionView/>
            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>

</Application>
