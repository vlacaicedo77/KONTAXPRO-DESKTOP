<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="KontaxDialogInfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="KontaxDialogWarningBrush" Color="#D97706"/>

    <Style x:Key="KontaxDialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="28"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Opacity="0.30"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KontaxDialogIconContainerStyle" TargetType="Border">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

    <Style x:Key="KontaxDialogCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DangerButtonStyle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="KontaxNotificationCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.28"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
