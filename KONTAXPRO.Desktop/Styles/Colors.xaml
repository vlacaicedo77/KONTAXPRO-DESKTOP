<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#22C55E</Color>
    <Color x:Key="PrimaryLightColor">#86EFAC</Color>
    <Color x:Key="PrimaryDarkColor">#16A34A</Color>
    <Color x:Key="PrimaryAccentColor">#4ADE80</Color>

    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush x:Key="PrimaryLightBrush"
                     Color="{StaticResource PrimaryLightColor}" />

    <SolidColorBrush x:Key="PrimaryDarkBrush"
                     Color="{StaticResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="PrimaryAccentBrush"
                     Color="{StaticResource PrimaryAccentColor}" />

</ResourceDictionary>